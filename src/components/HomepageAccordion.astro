/* ============ Playful Illustrator theme · minimal graphic pass ============ */
.playful-theme{
  --ink:#0b2633;
  --paper:#fffdf8;
  --sun:#ffd900;
  --pink:#ff4fa3;
  --orange:#ff6a00;
  --sky:#10c8e8;
  --teal:#0aa9a6;
  --violet:#635bff;
  background:#f5f3ec;
}
.playful-theme::before{
  background:#fffdf8!important;
  border-bottom:6px solid #10c8e8!important;
  box-shadow:0 5px 0 rgba(11,38,51,.08)!important;
}
.playful-theme .bg{background:#f5f3ec!important}
.playful-theme .brand{color:var(--ink);top:10px;left:24px;gap:10px}
