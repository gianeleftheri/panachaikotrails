.accordion-weather-stack{width:min(860px,76%);display:grid;gap:14px}
.accordion-station{padding:19px 22px 17px;border:1px solid rgba(69,215,223,.50);border-radius:21px;background:linear-gradient(155deg,rgba(4,58,67,.97),rgba(4,47,56,.95));box-shadow:0 20px 48px rgba(0,18,23,.28);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px)}
.accordion-station[data-live-station="panachaiko"]{background:linear-gradient(155deg,rgba(5,70,79,.97),rgba(4,46,54,.94))}
.accordion-station.is-stale{border-color:rgba(245,183,75,.58)}
