.playful-theme .brand-mark::before,.playful-theme .brand-mark::after{display:none!important}
.playful-theme .brand-mark svg{display:block;width:100%;height:100%}
.playful-theme .brand strong{font-size:20px;font-weight:900;letter-spacing:.015em;color:var(--ink)}
.playful-theme .brand small{margin-top:1px;font-size:9.5px;font-weight:700;letter-spacing:.18em;color:#31515b}

.playful-theme .map-callout{
  top:14px;right:22px;min-height:48px;padding:8px 17px;
  border:2px solid var(--ink)!important;border-radius:999px!important;
