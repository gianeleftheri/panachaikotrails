.accordion-station-place small{font-size:12px;font-weight:700;color:#b8d7da}
.accordion-station-live{display:flex;align-items:center;gap:8px;font-size:12px;font-weight:600;color:#d0e5e7;white-space:nowrap}
.accordion-station-dot{width:7px;height:7px;border-radius:50%;background:#3ee07f;box-shadow:0 0 0 0 rgba(62,224,127,.50);animation:accordionStationPulse 2s infinite}
