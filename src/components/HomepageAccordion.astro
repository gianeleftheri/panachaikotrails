/* ============ Accordion V2 · generated-concept visual pass ============ */
:root{--header-h:78px;--side-w:126px;--gutter:10px;--top:82px}
body{font-family:"Roboto",Arial,sans-serif}
.app::before{content:"";position:absolute;z-index:12;left:0;right:0;top:0;height:78px;background:linear-gradient(180deg,#073d46 0%,#063740 100%);border-bottom:1px solid rgba(69,215,223,.28);box-shadow:0 8px 30px rgba(0,18,23,.12)}
.brand{left:30px;top:14px;z-index:50;gap:12px}
.brand-mark{width:48px;height:44px}
.brand-mark::before,.brand-mark::after{border-left-width:15px;border-right-width:15px;border-bottom-width:32px}
.brand-mark::after{left:17px}
.brand strong{font-size:19px;font-weight:850;letter-spacing:.055em}
.brand small{font-size:10px;letter-spacing:.15em;color:#a8d7da}
.map-callout{z-index:50;top:15px;right:24px;min-height:48px;padding:8px 14px;border-radius:12px;border-color:rgba(69,215,223,.38);background:rgba(5,52,61,.82);box-shadow:none}
.map-callout:hover{transform:none;background:rgba(9,83,93,.92);box-shadow:0 8px 26px rgba(0,0,0,.2)}
.map-callout svg{width:24px;height:24px}
.map-copy strong{font-size:13px}
.map-copy small{font-size:9.5px}
.sidebar{left:0;top:78px;bottom:0;width:126px;border-radius:0;border-width:0 1px 0 0;background:linear-gradient(180deg,rgba(5,58,67,.99),rgba(4,48,57,.99));box-shadow:none}
.side-item{gap:7px;min-height:88px;border-color:rgba(255,255,255,.08)}
.side-icon-row{display:flex;align-items:center;justify-content:center;gap:5px}
.side-item svg{width:26px;height:26px;stroke-width:1.9}
.side-count{font-size:11px;font-weight:900;line-height:1;color:#fff;font-variant-numeric:tabular-nums}
.side-item:hover,.side-item.is-active{background:linear-gradient(90deg,rgba(18,185,199,.24),rgba(18,185,199,.04));box-shadow:inset 5px 0 0 #16d9e2}
.side-label{font-size:11px;font-weight:650}
.accordion{left:126px;right:8px;top:78px;bottom:8px;gap:6px;border-radius:0;background:#063a43}
.acc-panel{min-width:106px;border-radius:12px;border-color:rgba(69,215,223,.36);box-shadow:inset 0 0 0 1px rgba(255,255,255,.025),0 12px 30px rgba(0,20,24,.12);transition:flex-grow .72s var(--ease-out),filter .35s ease}
.acc-panel.is-active{flex-grow:7.4}
.acc-panel::before{filter:saturate(1.08) contrast(1.06);transform:scale(1.025)}
.acc-panel.is-active::before{transform:scale(1)}
.panel-overlay{background:linear-gradient(180deg,rgba(3,30,36,.12) 0%,rgba(3,31,38,.18) 45%,rgba(2,25,31,.68) 100%)}
.acc-panel.is-active .panel-overlay{opacity:.48}
.hero-route{position:absolute;z-index:-1;right:2%;bottom:3%;width:61%;height:82%;pointer-events:none;opacity:.72;filter:drop-shadow(0 0 8px rgba(47,224,238,.42))}
.hero-route path{fill:none;stroke:#48e3ec;stroke-width:3;stroke-linecap:round;stroke-dasharray:8 8}
.hero-route circle{fill:#063a43;stroke:#56edf4;stroke-width:3}
.panel-toggle{padding:28px 18px 22px;display:flex;flex-direction:column;align-items:flex-start;justify-content:flex-start;gap:10px;text-align:left;background:linear-gradient(180deg,rgba(5,50,59,.28),rgba(4,37,44,.62))}
.panel-toggle:hover{background:linear-gradient(180deg,rgba(13,83,93,.18),rgba(4,37,44,.54))}
.panel-icon-row{display:flex;align-items:center;gap:10px}
.panel-icon{display:grid;place-items:center;width:42px;height:42px;border:1px solid rgba(69,215,223,.42);border-radius:12px;background:rgba(4,52,61,.64);color:#eefcfd;box-shadow:0 8px 24px rgba(0,20,24,.16)}
.panel-count{display:inline-flex;align-items:center;justify-content:center;min-width:34px;height:34px;padding:0 9px;border:1px solid rgba(69,215,223,.38);border-radius:10px;background:rgba(4,52,61,.72);color:#fff;font-size:20px;font-weight:900;line-height:1;font-variant-numeric:tabular-nums;box-shadow:0 8px 24px rgba(0,20,24,.14)}
.panel-icon svg{width:27px;height:27px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
.panel-title{font-size:16px;font-weight:850;line-height:1.12;text-shadow:0 2px 10px rgba(0,0,0,.64)}
.panel-summary{display:block;max-width:145px;font-size:11.5px;line-height:1.45;color:rgba(232,247,248,.78)}
.panel-arrow{position:absolute;right:16px;bottom:18px;display:grid;place-items:center;width:40px;height:40px;border:1px solid rgba(69,215,223,.55);border-radius:50%;background:rgba(4,52,61,.72);font-size:22px;color:#eafcfd}
.acc-panel.is-active .panel-toggle{opacity:0;visibility:hidden}
.panel-index{display:none}
.panel-content{left:32px;right:32px;top:28px;bottom:auto;width:min(900px,calc(100% - 64px));max-width:none;max-height:calc(100% - 56px);padding:32px 34px 34px;border-radius:22px;background:linear-gradient(160deg,rgba(4,53,62,.93),rgba(3,39,46,.88));border-color:rgba(69,215,223,.38);box-shadow:0 26px 64px rgba(0,18,23,.32);overflow-y:auto;overflow-x:hidden;overscroll-behavior:contain;scrollbar-width:thin;scrollbar-color:rgba(69,215,223,.72) rgba(255,255,255,.08)}
.panel-content h2{font-family:"Roboto",Arial,sans-serif;font-size:clamp(42px,4.1vw,68px);font-weight:900;line-height:.98;letter-spacing:-.035em}
.panel-content p{max-width:790px;font-size:18px;line-height:1.6;color:#d9eff0}
.panel-content::-webkit-scrollbar{width:9px}
.panel-content::-webkit-scrollbar-track{background:rgba(255,255,255,.06);border-radius:999px}
.panel-content::-webkit-scrollbar-thumb{background:rgba(69,215,223,.70);border-radius:999px;border:2px solid rgba(4,53,62,.8)}
.panel-content::-webkit-scrollbar-thumb:hover{background:rgba(86,233,240,.92)}
#content-home{left:30px;right:30px;top:22px;bottom:26px;max-width:none;max-height:none;padding:0;border:0;background:none;box-shadow:none;backdrop-filter:none;-webkit-backdrop-filter:none;display:flex;flex-direction:column;justify-content:space-between;align-items:flex-start;pointer-events:none;overflow:visible}
