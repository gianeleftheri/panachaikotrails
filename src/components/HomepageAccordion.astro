---
interface Props {
  homeHeroFull?: string;
  homeHeroLarge?: string;
  homeHeroMedium?: string;
  homeHeroSmall?: string;
  homeHeroAvif480?: string;
  homeHeroAvif768?: string;
  homeHeroAvif1024?: string;
  defaultHomeBackground?: string;
}

const {
  homeHeroFull = '',
  homeHeroLarge = '',
  homeHeroMedium = '',
  homeHeroSmall = '',
  homeHeroAvif480 = '',
  homeHeroAvif768 = '',
  homeHeroAvif1024 = '',
  defaultHomeBackground = 'https://cms.panachaikotrails.gr/wp-content/uploads/2026/09/Panachaiko-Trails-Home-Hero-Optimized.webp',
} = Astro.props;
---
<style is:global>

/* ============ Φωτογραφίες panels: φορτώνεται μόνο το ενεργό background ============ */
/* ============ Tokens ============ */
:root{
  --bg:#063a43;--navy:#073943;--panel:#0a4650;
  --cyan:#45d7df;--cyan-strong:#0a9eae;--cyan-hover:#12b9c7;
  --text:#f4fafb;--muted:#bdd6d9;--body:#d8e9ea;
  --line:rgba(69,215,223,.42);
  --ease-out:cubic-bezier(.16,1,.3,1);
  --gutter:20px;--top:92px;--side-w:122px;
}
*,*::before,*::after{box-sizing:border-box}
html,body{margin:0;height:100%;overflow:hidden;background:var(--bg);color:var(--text);font-family:"Roboto",Arial,sans-serif;-webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility}
button{font:inherit;color:inherit}
:focus-visible{outline:2px solid var(--cyan);outline-offset:2px}
.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}

.app{position:fixed;inset:0;background:var(--bg)}
.bg{position:absolute;inset:0;background:radial-gradient(circle at 78% 20%,rgba(35,104,111,.36),transparent 34%),linear-gradient(135deg,#052f37 0%,#063a43 46%,#074751 100%)}

/* ============ Brand ============ */
.brand{position:absolute;z-index:30;left:26px;top:20px;display:flex;align-items:center;gap:13px;margin:0;font:inherit;pointer-events:none}
.brand-mark{width:58px;height:48px;position:relative;flex:none}
.brand-mark::before,.brand-mark::after{content:"";position:absolute;bottom:4px;border-left:18px solid transparent;border-right:18px solid transparent;border-bottom:38px solid #16bcd4;filter:drop-shadow(0 0 8px rgba(66,217,235,.28))}
.brand-mark::before{left:0}
.brand-mark::after{left:20px;border-bottom-color:#0d759b;transform:scale(.75)}
.brand strong{display:block;font-size:19px;letter-spacing:.07em}
.brand small{display:block;font-size:11px;color:var(--muted);letter-spacing:.08em}

/* ============ Map CTA ============ */
.map-callout{position:absolute;z-index:35;right:26px;top:26px;display:flex;align-items:center;gap:12px;padding:10px 16px;border:1px solid rgba(79,222,237,.65);border-radius:20px;background:linear-gradient(90deg,rgba(16,54,78,.93),rgba(17,76,95,.88));cursor:pointer;text-align:left;box-shadow:0 10px 35px rgba(0,0,0,.24),0 0 20px rgba(66,217,235,.13);transition:transform .25s ease,box-shadow .25s ease}
.map-callout:hover{transform:translateY(-2px);box-shadow:0 14px 40px rgba(0,0,0,.28),0 0 28px rgba(66,217,235,.22)}
.map-callout svg{width:28px;height:28px;fill:none;stroke:currentColor;stroke-width:1.7;display:block}
.map-copy strong{display:block;font-size:14px}
.map-copy small{display:block;color:var(--muted);margin-top:2px}

/* ============ Sidebar ============ */
.sidebar{position:absolute;z-index:20;left:18px;top:var(--top);bottom:22px;width:var(--side-w);display:flex;flex-direction:column;border:1px solid rgba(66,217,235,.38);border-radius:14px 0 0 14px;background:linear-gradient(180deg,rgba(8,38,58,.93),rgba(8,31,48,.9));overflow:hidden}
.side-item{flex:1;min-height:64px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:7px;padding:8px 5px;border:0;border-bottom:1px solid rgba(255,255,255,.08);background:transparent;cursor:pointer;transition:background-color .28s ease,box-shadow .28s ease}
.side-item:last-child{border-bottom:0}
.side-item:hover,.side-item.is-active{background:linear-gradient(90deg,rgba(0,181,214,.22),rgba(0,181,214,.08));box-shadow:inset 3px 0 0 var(--cyan)}
.side-item:focus-visible{outline-offset:-3px}
.side-item svg{width:25px;height:25px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round;display:block}
.side-label{font-size:11px;line-height:1.15;text-align:center}

/* ============ Accordion ============ */
.accordion{position:absolute;z-index:10;left:calc(18px + var(--side-w));right:var(--gutter);top:var(--top);bottom:22px;display:flex;gap:3px;overflow:hidden}
.acc-panel{position:relative;flex:1 1 0;min-width:82px;border:1px solid var(--line);border-radius:0 14px 14px 0;overflow:hidden;isolation:isolate;background:var(--panel);transition:flex-grow .72s var(--ease-out),filter .38s ease}
.acc-panel::before{content:"";position:absolute;inset:0;z-index:-2;background-color:var(--panel);background-image:var(--panel-bg,none);background-position:center;background-size:cover;transform:scale(1.05);transition:transform .8s var(--ease-out)}
.panel-home-media{position:absolute;inset:0;z-index:-2;display:block;overflow:hidden}
.panel-home-media picture,.panel-home-media img{display:block;width:100%;height:100%}
.panel-home-media img{object-fit:cover;object-position:58% center}
.acc-panel[data-panel="home"].has-cms-bg .panel-home-media{display:none}
.panel-overlay{position:absolute;inset:0;z-index:-1;background:linear-gradient(90deg,rgba(7,30,46,.85),rgba(7,30,46,.2) 72%,rgba(7,30,46,.56));transition:opacity .35s ease}

/* Ολόκληρο το κλειστό panel είναι ένα κουμπί (πληκτρολόγιο + screen readers) */
.panel-toggle{position:absolute;inset:0;z-index:2;width:100%;padding:28px 15px 0 18px;border:0;background:transparent;cursor:pointer;text-align:left;display:block}
.panel-toggle:focus-visible{outline-offset:-4px;border-radius:0 12px 12px 0}
.panel-title{display:block;font-size:16px;font-weight:750;line-height:1.05;transition:opacity .25s ease,transform .25s ease}
.panel-index{position:absolute;right:14px;bottom:14px;font:700 11px ui-monospace,SFMono-Regular,Menlo,monospace;color:rgba(255,255,255,.52)}

.panel-content{position:absolute;z-index:3;left:clamp(26px,3vw,52px);right:70px;bottom:clamp(42px,8vh,85px);max-width:610px;opacity:0;visibility:hidden;transform:translateX(38px);transition:opacity .34s ease .1s,transform .68s var(--ease-out),visibility 0s linear .44s}
.eyebrow{font-size:10px;font-weight:800;letter-spacing:.17em;color:var(--cyan)}
.panel-content h2{font-family:Georgia,"Times New Roman",serif;font-size:clamp(32px,4vw,62px);line-height:1;margin:12px 0;text-wrap:balance}
.panel-content p{font-size:clamp(14px,1.2vw,18px);line-height:1.55;color:var(--body);margin:0;max-width:590px}
.panel-cta{display:inline-flex;align-items:center;gap:8px;margin-top:22px;padding:11px 16px;border-radius:10px;border:1px solid rgba(66,217,235,.7);background:var(--cyan-strong);font-weight:700;cursor:pointer;transition:background-color .2s ease}
.panel-cta:hover{background:var(--cyan-hover)}

/* Ενεργό panel */
.acc-panel.is-active{flex-grow:4.4;z-index:3}
.acc-panel.is-active::before{transform:scale(1)}
.acc-panel.is-active .panel-overlay{opacity:.58}
.acc-panel.is-active .panel-toggle{pointer-events:none}
.acc-panel.is-active .panel-title{opacity:0;transform:translateY(-8px)}
.acc-panel.is-active .panel-content{opacity:1;visibility:visible;transform:none;transition:opacity .34s ease .1s,transform .68s var(--ease-out),visibility 0s}
.accordion.is-previewing .acc-panel:not(.is-active){filter:saturate(.82) brightness(.78)}

/* ============ Καιρός (ζωντανά) ============ */
.wx{margin-bottom:26px;padding:18px 20px 14px;border:1px solid rgba(66,217,235,.45);border-radius:18px;background:linear-gradient(160deg,rgba(7,32,50,.82),rgba(7,32,50,.62));backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);box-shadow:0 18px 50px rgba(0,0,0,.28)}
.wx-head{display:flex;align-items:center;justify-content:space-between;gap:10px;font-size:12px;color:var(--muted)}
.wx-place{font-weight:700;color:var(--text);letter-spacing:.02em}
.wx-place small{font-weight:500;color:var(--muted)}
.wx-live{display:inline-flex;align-items:center;gap:6px;white-space:nowrap}
.wx-dot{width:8px;height:8px;border-radius:50%;background:#3ee07f;box-shadow:0 0 0 0 rgba(62,224,127,.6);animation:wxPulse 2s infinite}
.wx.is-stale .wx-dot{background:#f5b041;animation:none}
.wx.is-error .wx-dot{background:#ef6461;animation:none}
@keyframes wxPulse{0%{box-shadow:0 0 0 0 rgba(62,224,127,.55)}70%{box-shadow:0 0 0 9px rgba(62,224,127,0)}100%{box-shadow:0 0 0 0 rgba(62,224,127,0)}}

.wx-main{display:flex;align-items:center;gap:16px;margin:10px 0 12px}
.wx-icon{width:clamp(64px,7vw,92px);height:clamp(64px,7vw,92px);flex:none}
.wx-icon svg{width:100%;height:100%;display:block}
.wx-temp{font-size:clamp(64px,7.4vw,108px);font-weight:800;line-height:.9;letter-spacing:-.04em;font-variant-numeric:tabular-nums}
.wx-temp sup{font-size:.42em;font-weight:700;vertical-align:.95em;margin-left:2px;color:var(--cyan)}
.wx-desc{flex:1;min-width:130px}
.wx-main{flex-wrap:wrap}
.wx-cond{font-size:clamp(18px,1.7vw,24px);font-weight:750;line-height:1.15}
.wx-sub{margin-top:6px;font-size:13px;color:var(--body);line-height:1.5}
.wx-sub b{color:var(--text)}

.wx-stats{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px;margin:0;padding:0;list-style:none}
.wx-stat{padding:10px 10px 9px;border-radius:12px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.07)}
.wx-stat dt{font-size:10.5px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}
.wx-stat dd{margin:4px 0 0;font-size:clamp(20px,1.9vw,27px);font-weight:800;line-height:1;font-variant-numeric:tabular-nums;white-space:nowrap}
.wx-stat dd small{font-size:.5em;font-weight:600;color:var(--muted);margin-left:2px}
.wx-stat .wx-note{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;margin:4px 0 0;font-size:11px;font-weight:500;line-height:1.3;white-space:normal;color:var(--muted)}
.wx-stat.is-alert{border-color:rgba(245,176,65,.6);background:rgba(245,176,65,.12)}

.wx-hours{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:4px;margin-top:12px;padding-top:10px;border-top:1px solid rgba(255,255,255,.08);text-align:center;font-size:12px}
.wx-hour time{display:block;color:var(--muted);font-size:11px}
.wx-hour svg{width:28px;height:28px;display:block;margin:3px auto}
.wx-hour b{font-size:15px;font-variant-numeric:tabular-nums}
.wx-hour .wx-p{display:block;font-size:10.5px;color:#7fd6ff;min-height:1.2em}

.wx-alert{margin-top:10px;padding:8px 11px;border-radius:10px;background:rgba(245,176,65,.14);border:1px solid rgba(245,176,65,.45);font-size:12.5px;color:#ffe2b0}
.wx-alert[hidden]{display:none}
.wx-alert{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.wx-foot{display:flex;flex-wrap:wrap;gap:4px 12px;justify-content:space-between;margin-top:10px;font-size:10.5px;color:var(--muted)}
.wx-foot a{color:var(--cyan);text-decoration:none}
.wx-foot a:hover{text-decoration:underline}
.wx-retry{border:0;background:none;padding:0;color:var(--cyan);cursor:pointer;font-size:inherit;text-decoration:underline}

/* skeleton πριν έρθουν τα δεδομένα */
.wx.is-loading .wx-temp,.wx.is-loading .wx-cond,.wx.is-loading .wx-stat dd{color:transparent;background:linear-gradient(90deg,rgba(255,255,255,.08),rgba(255,255,255,.16),rgba(255,255,255,.08));background-size:200% 100%;animation:wxShim 1.2s linear infinite;border-radius:8px}
@keyframes wxShim{to{background-position:-200% 0}}

/* η Αρχική: λιγότερο κείμενο ώστε να χωράει ο καιρός */
#content-home{top:clamp(14px,2.6vh,26px);bottom:clamp(26px,4.5vh,56px);right:28px;max-width:640px;display:flex;flex-direction:column;justify-content:space-between}
#content-home .wx{margin-bottom:18px}
#content-home .panel-cta{align-self:flex-start}
#content-home h2{font-size:clamp(30px,3.3vw,54px)}
@media (max-height:820px){#content-home > p{display:none}}
@media (max-height:700px){.wx-hours{display:none}}
@media (max-width:900px){.wx-stats{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media (max-width:640px){
  .wx{padding:12px 14px 10px;margin-bottom:14px}
  .wx-main{margin:6px 0 8px;gap:10px}
  .wx-icon{width:54px;height:54px}
  .wx-temp{font-size:60px}
  .wx-cond{font-size:16px}
  .wx-sub{font-size:12px;margin-top:3px}
  .wx-stats{grid-template-columns:repeat(4,minmax(0,1fr));gap:5px}
  .wx-stat{padding:7px 6px}
  .wx-stat dt{font-size:9px;letter-spacing:.04em}
  .wx-stat dd{font-size:17px}
  .wx-stat .wx-note{display:none}
  .wx-hours,.wx-foot a.wx-more{display:none}
  .wx-alert{display:block;white-space:nowrap;text-overflow:ellipsis;font-size:11px;padding:6px 9px;margin-top:8px}
  .wx-head{font-size:11px}
  #content-home h2{display:none}
  #content-home .panel-cta{margin-top:0}
  .wx-foot{margin-top:6px}
  #content-home{top:12px;bottom:18px;right:18px}
  .acc-panel.is-active{flex-grow:8}
  .wx-place small{display:none}
  #content-home > p,#content-home > .eyebrow{display:none}
}
@media (max-width:640px) and (max-height:700px){.wx-stats{display:none}}
@media (prefers-reduced-motion:reduce){.wx-dot,.wx.is-loading *{animation:none!important}}

/* ============ Hint / Toast ============ */
.hint{position:absolute;z-index:40;left:50%;bottom:4px;transform:translateX(-50%);padding:5px 13px;border:1px solid rgba(255,255,255,.16);border-radius:999px;background:rgba(5,25,38,.78);font-size:10px;color:var(--body);white-space:nowrap;backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px)}
.hint b{color:var(--cyan)}
@media (hover:none){.hint{display:none}}
.toast{position:absolute;z-index:100;left:50%;top:50%;max-width:min(420px,calc(100vw - 32px));padding:16px 20px;border:1px solid rgba(66,217,235,.55);border-radius:14px;background:rgba(7,31,48,.94);box-shadow:0 20px 60px rgba(0,0,0,.34);font-size:13px;line-height:1.45;text-align:center;opacity:0;pointer-events:none;transform:translate(-50%,-50%) scale(.94);transition:opacity .22s ease,transform .22s ease}
.toast.show{opacity:1;transform:translate(-50%,-50%) scale(1)}

/* ============ Tablet ============ */
@media (max-width:900px){
  :root{--top:72px;--side-w:80px;--gutter:8px}
  .brand{left:14px;top:12px}
  .brand strong{font-size:15px}
  .map-callout{top:10px;right:10px;padding:8px 10px}
  .map-copy small{display:none}
  .sidebar{left:8px;bottom:8px}
  .accordion{left:calc(8px + var(--side-w));bottom:8px}
  .acc-panel{min-width:52px}
  .panel-toggle{padding:22px 0 0}
  .panel-title{font-size:12px;writing-mode:vertical-rl;transform:rotate(180deg);margin-left:auto;margin-right:13px;width:max-content}
  .acc-panel.is-active .panel-title{transform:rotate(180deg) translateX(8px)}
  .panel-content{left:18px;right:18px;bottom:28px;width:calc(100% - 36px);padding:27px 28px 29px}
  .panel-content h2{font-size:44px}
}

/* ============ Κινητό: κάθετο accordion + κάτω μπάρα πλοήγησης ============ */
@media (max-width:640px){
  :root{--top:68px;--nav-h:64px}
  .acc-panel{transition:none}
  .acc-panel::before{transition:transform .35s var(--ease-out)}
  .accordion.is-previewing .acc-panel:not(.is-active){filter:none}
  .side-item{transition:none}

  .brand-mark{width:44px;height:38px;transform:scale(.8);transform-origin:left center}
  .brand small{display:none}
  .brand{gap:6px}
  .brand strong{font-size:13px;letter-spacing:.05em}
  .map-copy strong{font-size:0}
  .map-copy strong::after{content:"Χάρτης →";font-size:13px}
  .sidebar{top:auto;left:0;right:0;bottom:0;width:auto;height:calc(var(--nav-h) + env(safe-area-inset-bottom));padding-bottom:env(safe-area-inset-bottom);flex-direction:row;border-radius:0;border-width:1px 0 0}
  .side-item{min-height:0;gap:4px;padding:6px 2px;border-bottom:0;border-right:1px solid rgba(255,255,255,.08)}
  .side-item:last-child{border-right:0}
  .side-item:hover,.side-item.is-active{box-shadow:inset 0 3px 0 var(--cyan)}
  .side-item svg{width:21px;height:21px}
  .side-label{font-size:9.5px}
  .accordion{left:8px;right:8px;bottom:calc(var(--nav-h) + env(safe-area-inset-bottom) + 8px);flex-direction:column}
  .acc-panel{min-width:0;min-height:44px;border-radius:12px}
  .panel-toggle{padding:0 16px;display:flex;align-items:center}
  .panel-title{writing-mode:horizontal-tb;transform:none;margin:0;font-size:14px}
  .acc-panel.is-active .panel-title{transform:translateY(-8px)}
  .panel-index{top:50%;bottom:auto;transform:translateY(-50%)}
  .acc-panel.is-active .panel-index{top:auto;bottom:12px;transform:none}
  .panel-content{left:12px;right:12px;bottom:14px;width:calc(100% - 24px);padding:18px 18px 20px;border-radius:16px;transform:translateY(24px)}
  .panel-content h2{font-size:38px;margin:9px 0}
  .panel-content p{font-size:16px;line-height:1.55}
  .panel-cta{margin-top:16px}
  .hint{display:none}
}

@media (prefers-reduced-motion:reduce){
  *,*::before,*::after{transition-duration:.01ms!important;transition-delay:0s!important}
}


/* ============ Petrol visual pass + clean photographic panels ============ */
.app{background:#063a43}
.map-callout{
  border-color:rgba(69,215,223,.60);
  background:linear-gradient(90deg,rgba(5,54,63,.96),rgba(7,74,82,.93));
  box-shadow:0 10px 34px rgba(0,20,24,.30),0 0 18px rgba(69,215,223,.12)
}
.sidebar{
  border-color:rgba(69,215,223,.42);
  background:linear-gradient(180deg,rgba(5,54,63,.98),rgba(5,45,53,.98));
  box-shadow:0 18px 45px rgba(0,20,24,.24)
}
.side-item:hover,.side-item.is-active{
  background:linear-gradient(90deg,rgba(69,215,223,.18),rgba(69,215,223,.06));
  box-shadow:inset 3px 0 0 var(--cyan)
}
.accordion{background:rgba(3,39,46,.38);border-radius:0 14px 14px 0}
.acc-panel{
  background:#0a4650;
  border-color:rgba(69,215,223,.36);
  box-shadow:inset 0 0 0 1px rgba(255,255,255,.02)
}
.acc-panel::before{
  background-image:var(--panel-bg);
  background-repeat:no-repeat;
  background-size:cover;
  background-position:center center;
  filter:saturate(1.04) contrast(1.03);
}
.acc-panel[data-panel="home"]::before{background-position:58% center}
.acc-panel[data-panel="trails"]::before{background-position:50% 56%}
.acc-panel[data-panel="poi"]::before{background-position:50% center}
.acc-panel[data-panel="shelter"]::before{background-position:50% 58%}
.acc-panel[data-panel="photos"]::before{background-position:54% center}
.acc-panel[data-panel="video"]::before{background-position:58% center}
.panel-overlay{
  background:linear-gradient(90deg,rgba(4,45,53,.70) 0%,rgba(4,45,53,.20) 56%,rgba(4,45,53,.46) 100%)
}
.acc-panel.is-active .panel-overlay{opacity:.34}
.accordion.is-previewing .acc-panel:not(.is-active){filter:saturate(.84) brightness(.70)}

/* Το κείμενο είναι HTML. Οι φωτογραφίες δεν περιέχουν καθόλου τυπωμένο κείμενο. */
.panel-content{
  max-width:660px;
  padding:20px 22px 22px;
  border:1px solid rgba(69,215,223,.26);
  border-radius:16px;
  background:linear-gradient(160deg,rgba(5,55,64,.88),rgba(4,43,51,.80));
  box-shadow:0 18px 50px rgba(0,20,24,.26);
  backdrop-filter:blur(10px);
  -webkit-backdrop-filter:blur(10px)
}
.panel-content h2{color:#f7fcfd;text-shadow:0 2px 12px rgba(0,0,0,.24)}
.panel-content p{color:#d8ebec}
.panel-title{
  color:#f6fbfc;
  text-shadow:0 2px 10px rgba(0,0,0,.72)
}
.panel-index{color:rgba(232,247,248,.72)}
.panel-cta{
  border-color:rgba(100,231,237,.76);
  background:#0a9eae;
  box-shadow:0 8px 22px rgba(0,115,128,.22)
}
.panel-cta:hover{background:#12b9c7}

/* Weather / menu / map share the same petrol family. */
.wx{
  border-color:rgba(69,215,223,.42);
  background:linear-gradient(160deg,rgba(5,57,66,.94),rgba(5,46,54,.90));
  box-shadow:0 18px 50px rgba(0,18,23,.28)
}
.wx-stat{background:rgba(255,255,255,.055);border-color:rgba(255,255,255,.075)}
