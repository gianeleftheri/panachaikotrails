---
interface Props {
  homeHeroFull?: string;
  homeHeroLarge?: string;
  homeHeroMedium?: string;
  homeHeroSmall?: string;
  homeHeroAvif480?: string;
  homeHeroAvif768?: string;
  homeHeroAvif1024?: string;
  defaultHomeBackground?: string;
}
---

<style is:global>
:root{
  --ink:#0b2633;
  --paper:#fffdf8;
  --cyan:#11c7e8;
  --cyan-soft:#72dcf0;
  --yellow:#ffdf00;
  --pink:#ff3c98;
  --orange:#ff7417;
  --teal:#0aa7a4;
  --green:#b9e52b;
  --violet:#6b59f5;
  --muted:#66777d;
  --shadow:0 18px 48px rgba(10,38,51,.14);
  --ease:cubic-bezier(.16,1,.3,1);
}
*{box-sizing:border-box}
html,body{margin:0;width:100%;height:100%;overflow:hidden;background:#f5f6f2;color:var(--ink);font-family:Roboto,Arial,sans-serif}
button{font:inherit}
button:focus-visible,a:focus-visible{outline:3px solid var(--pink);outline-offset:3px}
.home-shell{position:fixed;inset:0;background:#f4f5f1;overflow:hidden}
.site-header{position:absolute;z-index:50;top:0;left:0;right:0;height:76px;background:#fff;display:flex;align-items:center;gap:22px;padding:0 24px 0 26px;border-bottom:1px solid rgba(11,38,51,.08);box-shadow:0 2px 16px rgba(11,38,51,.06)}
.brand{display:flex;align-items:center;gap:10px;min-width:230px;color:var(--ink)}
.brand-mark{position:relative;width:54px;height:44px;flex:none}
.brand-mark .tri{position:absolute;bottom:3px;width:0;height:0;border-left:16px solid transparent;border-right:16px solid transparent;border-bottom:32px solid var(--ink)}
.brand-mark .tri:nth-child(1){left:0}
.brand-mark .tri:nth-child(2){left:15px;border-bottom-color:var(--cyan);transform:scale(.9)}
.brand-mark .tri:nth-child(3){left:28px;border-bottom-color:var(--pink);transform:scale(.75)}
.brand-mark .sun-dot{position:absolute;right:2px;top:0;width:16px;height:16px;border-radius:50%;background:var(--yellow)}
.brand strong{display:block;font-size:18px;line-height:.93;font-weight:950;letter-spacing:-.035em}
.brand small{display:none}
.sidebar{flex:1;display:flex;align-items:center;justify-content:center;gap:4px;height:100%;min-width:0}
.side-item{border:0;background:transparent;color:var(--ink);border-radius:999px;padding:10px 13px;cursor:pointer;font-size:12px;font-weight:800;white-space:nowrap;transition:background .2s ease,transform .2s ease}
.side-item:hover{background:#f2f4ef}
.side-item.is-active{background:var(--yellow)}
.header-actions{display:flex;align-items:center;gap:12px;margin-left:auto}
.search-dot{width:42px;height:42px;border:0;background:transparent;position:relative}
.search-dot::before{content:"";position:absolute;width:14px;height:14px;border:3px solid var(--ink);border-radius:50%;left:8px;top:7px}
.search-dot::after{content:"";position:absolute;width:12px;height:3px;background:var(--ink);transform:rotate(45deg);left:22px;top:24px;border-radius:4px}
.map-callout{display:flex;align-items:center;gap:9px;min-height:46px;padding:0 18px;border:0;border-radius:999px;background:var(--yellow);color:var(--ink);font-weight:950;cursor:pointer;transition:transform .2s ease,box-shadow .2s ease}
.map-callout:hover{transform:translateY(-2px);box-shadow:0 10px 18px rgba(11,38,51,.12)}
.map-icon{position:relative;width:22px;height:18px;display:inline-block}
.map-icon::before,.map-icon::after{content:"";position:absolute;top:1px;width:8px;height:16px;border:2px solid currentColor;transform:skewY(-18deg)}
.map-icon::before{left:1px}.map-icon::after{right:1px;transform:skewY(18deg)}
.map-copy small{display:none}
body.search-open{overflow:hidden}
.site-search-overlay{position:fixed;z-index:120;inset:0;display:grid;place-items:start center;padding:96px 18px 24px;background:rgba(6,25,34,.62);backdrop-filter:blur(8px)}
.site-search-overlay[hidden]{display:none!important}
.site-search-dialog{width:min(820px,100%);max-height:min(720px,calc(100vh - 120px));display:flex;flex-direction:column;overflow:hidden;border-radius:28px;background:#fffdf8;box-shadow:0 28px 80px rgba(7,31,42,.32);border:1px solid rgba(11,38,51,.1)}
.site-search-top{display:flex;align-items:center;gap:12px;padding:18px 20px 12px}
.site-search-field{position:relative;flex:1}
.site-search-field::before{content:"";position:absolute;left:17px;top:50%;width:14px;height:14px;border:3px solid var(--ink);border-radius:50%;transform:translateY(-58%)}
.site-search-field::after{content:"";position:absolute;left:30px;top:53%;width:10px;height:3px;border-radius:4px;background:var(--ink);transform:rotate(45deg)}
.site-search-input{width:100%;height:58px;border:2px solid rgba(11,38,51,.12);border-radius:18px;background:#fff;padding:0 18px 0 52px;color:var(--ink);font:800 18px/1 Roboto,Arial,sans-serif;outline:none}
.site-search-input:focus{border-color:var(--yellow);box-shadow:0 0 0 4px rgba(255,223,0,.22)}
.site-search-close{flex:none;width:48px;height:48px;border:0;border-radius:50%;background:#f1f3ef;color:var(--ink);font-size:22px;font-weight:900;cursor:pointer}
.site-search-meta{display:flex;justify-content:space-between;gap:12px;padding:0 22px 13px;color:var(--muted);font-size:12px;font-weight:700}
.site-search-results{display:grid;gap:8px;overflow:auto;padding:0 14px 16px}
.site-search-result{display:grid;grid-template-columns:44px minmax(0,1fr) 34px;gap:12px;align-items:center;padding:13px 14px;border-radius:16px;background:#f7f8f4;color:var(--ink);text-decoration:none;border:1px solid rgba(11,38,51,.06);transition:transform .16s ease,background .16s ease,box-shadow .16s ease}
.site-search-result:hover,.site-search-result:focus-visible{transform:translateY(-1px);background:#fff;box-shadow:0 10px 24px rgba(11,38,51,.1)}
.site-search-result-icon{width:42px;height:42px;border-radius:13px;display:grid;place-items:center;background:var(--yellow);font-size:19px;font-weight:950}
.site-search-result-icon.type-poi{background:#c9f3f4}.site-search-result-icon.type-shelter{background:#ffd7a8}.site-search-result-icon.type-news{background:#e2dcff}
.site-search-result-copy{min-width:0;display:grid;gap:3px}
.site-search-result-type{font-size:9px;letter-spacing:.11em;text-transform:uppercase;color:var(--pink);font-weight:950}
.site-search-result-copy strong{font-size:15px;line-height:1.2}
.site-search-result-copy small{font-size:11px;line-height:1.35;color:var(--muted)}
.site-search-result-arrow{font-size:22px;font-weight:900}
.site-search-empty,.site-search-loading{padding:28px 18px;text-align:center;color:var(--muted);font-weight:700}
@media(max-width:620px){
  .site-search-overlay{padding:72px 8px 8px}
  .site-search-dialog{max-height:calc(100vh - 80px);border-radius:20px}
  .site-search-top{padding:12px 12px 9px}
  .site-search-input{height:52px;font-size:16px}
  .site-search-close{width:44px;height:44px}
  .site-search-meta{padding:0 14px 10px}
  .site-search-results{padding:0 8px 10px}
  .site-search-result{grid-template-columns:40px minmax(0,1fr) 26px;padding:11px 10px}
  .site-search-result-icon{width:38px;height:38px}
}
.accordion{position:absolute;z-index:5;top:88px;left:14px;right:14px;bottom:14px;display:flex;gap:9px;overflow:hidden}
.acc-panel{position:relative;flex:1 1 0;min-width:112px;overflow:hidden;border-radius:20px;background:#fff;box-shadow:var(--shadow);transition:flex-grow .68s var(--ease),transform .3s ease;isolation:isolate}
.acc-panel.is-active{flex-grow:6.4}
.acc-panel:hover{transform:translateY(-1px)}
.panel-scene{position:absolute;inset:0 0 112px;background:var(--cyan);overflow:hidden}
.acc-panel.is-active .panel-scene{inset:0}
.panel-toggle{position:absolute;inset:0;z-index:10;border:0;background:transparent;cursor:pointer;text-align:left;padding:0}
.acc-panel.is-active .panel-toggle{pointer-events:none}
.panel-footer{position:absolute;left:0;right:0;bottom:0;height:112px;padding:18px 15px 14px;background:#fff;border-top:1px solid rgba(11,38,51,.08)}
.panel-title{display:block;color:var(--ink);font-size:15px;font-weight:950;line-height:1.05;letter-spacing:-.03em}
.panel-summary{display:none}
.panel-arrow{position:absolute;right:14px;bottom:14px;width:38px;height:38px;border-radius:50%;display:grid;place-items:center;background:var(--accent,var(--yellow));color:var(--ink);font-size:22px;font-weight:900}
.acc-panel.is-active .panel-footer{opacity:0}
.panel-content{position:absolute;z-index:8;opacity:0;visibility:hidden;pointer-events:none;transition:opacity .25s ease,transform .45s var(--ease);transform:translateX(24px)}
.acc-panel.is-active .panel-content{opacity:1;visibility:visible;pointer-events:auto;transform:none}
.panel-content:not(#content-home){left:34px;bottom:34px;width:min(560px,calc(100% - 68px));padding:24px 26px 26px;border-radius:22px;background:rgba(255,255,255,.96);box-shadow:0 18px 42px rgba(11,38,51,.20)}
.panel-content:not(#content-home)::before{content:"";display:block;width:54px;height:7px;border-radius:999px;background:var(--accent,var(--yellow));margin-bottom:14px}
.eyebrow{font-size:10px;font-weight:950;letter-spacing:.16em;color:var(--pink)}
.panel-content h2{margin:7px 0 10px;font-size:clamp(34px,4vw,64px);line-height:.95;letter-spacing:-.055em;font-weight:950}
.panel-content p{margin:0;color:#53676d;line-height:1.5;font-size:15px;max-width:500px}
.panel-cta{display:inline-flex;align-items:center;gap:8px;margin-top:18px;min-height:46px;padding:0 17px;border:0;border-radius:999px;background:var(--yellow);color:var(--ink);font-weight:950;cursor:pointer}
.panel-feed{display:grid;gap:8px;margin-top:16px;max-height:180px;overflow:auto}
.panel-feed-item{display:grid;grid-template-columns:58px minmax(0,1fr);gap:10px;align-items:center;padding:7px;background:#f6f7f4;border-radius:12px}
.panel-feed-item.no-thumb{grid-template-columns:1fr}
.panel-feed-thumb{display:block;width:58px;height:46px;border-radius:9px;object-fit:cover;background:#dde7e8}
.panel-feed-video-thumb{display:grid;place-items:center;background:linear-gradient(145deg,var(--violet),var(--pink));color:#fff;font-size:20px}
.panel-feed-title{font-size:12px;font-weight:850;line-height:1.2}
.panel-feed-meta{display:block;margin-top:3px;font-size:10px;color:var(--muted)}

/* Home open panel */
#content-home{inset:0;padding:0}
.home-copy{position:absolute;z-index:8;left:5.2%;top:12%;width:min(540px,46%);color:#fff}
.home-kicker{display:inline-flex;align-items:center;min-height:28px;padding:0 12px;border-radius:999px;background:var(--pink);color:#fff;font-size:10px;font-weight:950;letter-spacing:.11em}
.home-copy h2{margin:14px 0 15px;font-size:clamp(54px,6.5vw,112px);line-height:.82;letter-spacing:-.075em;color:#fff;text-shadow:0 6px 20px rgba(11,38,51,.16)}
.home-copy h2 span{display:block;color:var(--ink)}
.home-copy p{max-width:480px;color:var(--ink);font-size:clamp(15px,1.2vw,20px);font-weight:650;line-height:1.43}
.home-copy .panel-cta{margin-top:20px;font-size:14px}
.weather-frame{position:absolute;z-index:9;right:28px;bottom:26px;width:min(560px,47%);padding:14px;border-radius:22px;background:rgba(255,255,255,.96);box-shadow:0 18px 42px rgba(11,38,51,.18)}
.weather-head{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:1px 3px 11px}
.weather-head strong{font-size:14px;font-weight:950}
.weather-head span{font-size:10px;color:var(--muted);font-weight:700}
.weather-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.accordion-station{min-width:0;padding:12px;border-radius:16px;background:#f7f8f4;border:1px solid rgba(11,38,51,.08)}
.accordion-station-head{display:flex;align-items:flex-start;justify-content:space-between;gap:8px}
.accordion-station-place{font-size:12px;font-weight:950}.accordion-station-place small{margin-left:3px;color:var(--muted);font-weight:650}
.accordion-station-live{display:flex;align-items:center;gap:5px;font-size:9px;color:var(--muted);font-weight:800;white-space:nowrap}
.accordion-station-dot{width:7px;height:7px;border-radius:50%;background:#35d278;box-shadow:0 0 0 3px rgba(53,210,120,.13)}
.accordion-station.is-stale .accordion-station-dot{background:#f4b840}.accordion-station.is-unavailable .accordion-station-dot{background:#ed6262}
.accordion-station-main{display:grid;grid-template-columns:42px auto 1fr;align-items:center;gap:8px;margin:8px 0 9px}
.accordion-station-icon{width:40px;height:40px}.accordion-station-icon svg{width:100%;height:100%}
.accordion-station-temp{font-size:38px;line-height:.9;font-weight:950;letter-spacing:-.06em}
.accordion-station-temp sup{font-size:.38em;color:#00aeca}
.accordion-station-feels{font-size:9px;color:var(--muted);font-weight:800}.accordion-station-observed{margin-top:2px;font-size:8px;color:#8a999d}
.accordion-station-stats{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:6px;margin:0}
.accordion-station-stat{padding:7px;border-radius:10px;background:#fff}
.accordion-station-stat dt{font-size:8px;letter-spacing:.05em;text-transform:uppercase;color:var(--muted);font-weight:850}
.accordion-station-stat dd{margin:2px 0 0;font-size:14px;font-weight:950;white-space:nowrap}.accordion-station-stat dd small{font-size:8px;color:var(--muted);margin-left:2px}
.accordion-station-stat>span{display:block;margin-top:1px;font-size:8px;color:var(--muted)}
.accordion-station-source{display:flex;justify-content:space-between;gap:8px;margin-top:7px;padding-top:6px;border-top:1px solid rgba(11,38,51,.07);font-size:8px;color:var(--muted)}.accordion-station-source a{color:#00879a;text-decoration:none}

/* Home cartoon scene */
.scene-home{background:linear-gradient(#13c8e8 0 58%,#30b8de 58% 66%,#0f8dbc 66% 100%)}
.scene-home .sun,.mini-sun{position:absolute;border-radius:50%;background:var(--yellow)}
.scene-home .sun{width:170px;height:170px;right:8%;top:8%}
.cloud{position:absolute;width:88px;height:24px;border-radius:30px;background:#fff}
.cloud::before,.cloud::after{content:"";position:absolute;border-radius:50%;background:#fff}
.cloud::before{width:38px;height:38px;left:14px;bottom:4px}.cloud::after{width:50px;height:50px;right:9px;bottom:2px}
.scene-home .cloud.a{left:7%;top:13%;transform:scale(.8)}.scene-home .cloud.b{right:31%;top:17%;transform:scale(.65)}
.mountain{position:absolute;bottom:20%;clip-path:polygon(50% 0,100% 100%,0 100%);transform-origin:bottom}
.scene-home .m1{left:-3%;width:48%;height:54%;background:#183b59}
.scene-home .m2{left:23%;width:48%;height:46%;background:#0f6f78}
.scene-home .m3{right:4%;width:46%;height:58%;background:#fefefe}
.scene-home .m3::after{content:"";position:absolute;inset:22% 0 0;background:linear-gradient(140deg,var(--pink) 0 22%,transparent 22% 36%,var(--orange) 36% 48%,transparent 48%),linear-gradient(220deg,#10616a 0 30%,transparent 30%);clip-path:inherit}
.hills{position:absolute;left:-4%;right:-4%;bottom:0;height:44%;background:linear-gradient(165deg,#d9f12d 0 36%,#a9df1d 36% 61%,#f6dc20 61%);clip-path:polygon(0 42%,14% 24%,28% 44%,43% 19%,57% 40%,72% 17%,88% 41%,100% 20%,100% 100%,0 100%)}
.forest{position:absolute;inset:auto 0 10% 0;height:38%;background:
  linear-gradient(65deg,transparent 0 46%,#083b43 47% 53%,transparent 54%) 0 20px/62px 90px repeat-x;
opacity:.92}
.trail-ribbon{position:absolute;z-index:3;left:43%;bottom:-3%;width:42%;height:44%;border:19px solid #fff6d8;border-left-color:transparent;border-bottom-color:transparent;border-radius:54% 0 0 0;transform:rotate(-8deg)}
.trail-ribbon::after{content:"";position:absolute;left:36px;top:14px;width:110%;height:100%;border-top:5px dashed var(--pink);border-radius:50%;transform:rotate(-8deg)}
.hut{position:absolute;z-index:4;right:16%;bottom:22%;width:112px;height:68px;background:#eee4d6;border:4px solid var(--ink);border-top:0}
.hut::before{content:"";position:absolute;left:-10px;right:-10px;top:-34px;height:38px;background:var(--pink);clip-path:polygon(0 100%,50% 0,100% 100%)}
.hut::after{content:"";position:absolute;width:20px;height:34px;left:45px;bottom:0;background:var(--ink)}
.hiker{position:absolute;z-index:6;left:31%;bottom:9%;width:130px;height:190px}
.hiker .head{position:absolute;left:55px;top:0;width:31px;height:31px;border-radius:50%;background:#ef9f69}
.hiker .cap{position:absolute;left:48px;top:-5px;width:46px;height:17px;border-radius:16px 20px 7px 7px;background:var(--pink)}
.hiker .body{position:absolute;left:46px;top:30px;width:50px;height:74px;border-radius:16px;background:var(--orange);transform:rotate(4deg)}
.hiker .pack{position:absolute;left:17px;top:35px;width:48px;height:72px;border-radius:18px 12px 16px 18px;background:var(--pink);box-shadow:inset -10px 0 0 var(--cyan)}
.hiker .leg.one,.hiker .leg.two{position:absolute;width:18px;height:85px;background:var(--ink);top:96px;border-radius:10px;transform-origin:top}
.hiker .leg.one{left:55px;transform:rotate(19deg)}.hiker .leg.two{left:82px;transform:rotate(-20deg)}
.hiker .boot.one,.hiker .boot.two{position:absolute;width:36px;height:14px;background:var(--pink);bottom:2px;border-radius:14px 18px 6px 6px}
.hiker .boot.one{left:72px}.hiker .boot.two{left:25px}
.hiker .pole.one,.hiker .pole.two{position:absolute;width:3px;height:118px;background:var(--ink);top:63px;transform-origin:top}
.hiker .pole.one{left:103px;transform:rotate(-12deg)}.hiker .pole.two{left:31px;transform:rotate(17deg)}

/* Narrow panel scenes */
.panel-news{--accent:var(--violet)}.panel-trails{--accent:var(--yellow)}.panel-poi{--accent:var(--pink)}.panel-shelter{--accent:var(--orange)}.panel-photos{--accent:var(--teal)}.panel-video{--accent:#2f9bf4}
.mini-scene{background:linear-gradient(#18c7e8 0 56%,#d7ef35 56% 100%)}
.mini-scene::before{content:"";position:absolute;left:-28%;right:-28%;bottom:20%;height:48%;background:#113b57;clip-path:polygon(0 100%,18% 36%,34% 78%,52% 19%,66% 68%,82% 30%,100% 100%)}
.mini-scene::after{content:"";position:absolute;left:-12%;right:-12%;bottom:0;height:42%;background:#0d6f64;clip-path:polygon(0 72%,20% 34%,39% 70%,59% 20%,77% 58%,100% 30%,100% 100%,0 100%)}
.mini-sun{width:95px;height:95px;right:-26px;top:12%}
.mini-cloud{position:absolute;z-index:2;width:70px;height:20px;border-radius:30px;background:#fff;left:10px;top:17%}
.symbol{position:absolute;z-index:5;left:50%;top:47%;transform:translate(-50%,-50%)}
.trail-symbol{width:72px;height:180px;border:18px solid #fff;border-left-color:transparent;border-bottom-color:transparent;border-radius:70% 30% 70% 30%;transform:translate(-55%,-46%) rotate(12deg)}
.trail-symbol::after{content:"";position:absolute;inset:3px -7px;border-top:5px dashed var(--pink);border-radius:50%}
.pin-symbol{width:64px;height:82px;background:var(--pink);border:8px solid #fff;border-radius:50% 50% 50% 0;transform:translate(-50%,-58%) rotate(-45deg);box-shadow:0 4px 0 rgba(11,38,51,.12)}
.pin-symbol::after{content:"";position:absolute;width:19px;height:19px;border-radius:50%;background:#fff;left:15px;top:15px}
.hut-symbol{width:84px;height:62px;background:#efe4d5;border:4px solid var(--ink);border-top:0}
.hut-symbol::before{content:"";position:absolute;left:-8px;right:-8px;top:-30px;height:34px;background:var(--pink);clip-path:polygon(0 100%,50% 0,100% 100%)}
.hut-symbol::after{content:"";position:absolute;width:18px;height:31px;background:var(--ink);left:29px;bottom:0}
.camera-symbol{width:86px;height:62px;border-radius:12px;background:var(--yellow);border:5px solid var(--ink)}
.camera-symbol::before{content:"";position:absolute;width:44px;height:44px;border-radius:50%;background:var(--pink);border:8px solid var(--ink);left:17px;top:9px}
.camera-symbol::after{content:"";position:absolute;width:32px;height:14px;border-radius:6px 6px 0 0;background:var(--ink);left:10px;top:-14px}
.play-symbol{width:94px;height:94px;border-radius:50%;background:var(--pink);border:8px solid #fff;box-shadow:0 5px 0 rgba(11,38,51,.15)}
.play-symbol::after{content:"";position:absolute;left:37px;top:26px;border-left:32px solid #fff;border-top:21px solid transparent;border-bottom:21px solid transparent}
.news-symbol{width:78px;height:58px;background:var(--yellow);clip-path:polygon(0 27%,67% 0,67% 100%,0 73%)}
.news-symbol::before{content:"";position:absolute;width:18px;height:53px;background:var(--ink);right:4px;top:2px;transform:rotate(-12deg)}
.news-symbol::after{content:"";position:absolute;width:42px;height:8px;border-radius:10px;background:var(--pink);right:-34px;top:3px;box-shadow:7px 20px 0 var(--pink),0 40px 0 var(--pink);transform:rotate(-12deg)}
.photo-scene{background:linear-gradient(#10c6e6 0 48%,#ffe25d 48% 100%)}
.video-scene{background:linear-gradient(#ff8b23 0 44%,#6559f5 44% 100%)}
.news-scene{background:linear-gradient(#17c8e8 0 56%,#ffcf30 56% 100%)}

/* News board */
.news-board{margin-top:18px;padding:12px;border-radius:16px;background:#f7f8f4}
.news-board-head{display:flex;justify-content:space-between;align-items:flex-start;gap:10px;margin-bottom:9px}
.news-board-head span{font-size:8px;letter-spacing:.14em;font-weight:950;color:var(--pink)}
.news-board-head h3{margin:3px 0 0;font-size:18px}
