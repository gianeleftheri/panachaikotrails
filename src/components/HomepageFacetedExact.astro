---
const master = `data:image/webp;base64,`;
const cards = [
  { href:'/trails', title:'Μονοπάτια', subtitle:'Διαδρομές για κάθε επίπεδο', size:'753.2%', pos:'10.48% 75.65%' },
  { href:'/points', title:'Σημεία ενδιαφέροντος', subtitle:'Φυσικά και πολιτιστικά σημεία', size:'770.5%', pos:'26.46% 75.65%' },
  { href:'/shelters', title:'Καταφύγια', subtitle:'Στάσεις και καταφύγια στο βουνό', size:'803.8%', pos:'41.80% 75.65%' },
  { href:'/photos', title:'Φωτογραφίες', subtitle:'Στιγμές από το Παναχαϊκό', size:'796.2%', pos:'56.77% 75.65%' },
  { href:'/videos', title:'Βίντεο', subtitle:'Εμπειρίες σε κίνηση', size:'796.2%', pos:'71.82% 75.65%' },
  { href:'/news', title:'Νέα', subtitle:'Δράσεις και ενημερώσεις', size:'749.8%', pos:'87.78% 75.65%' },
];
---

<style>
  :global(html){scroll-behavior:smooth}
  :global(body){margin:0;background:#e8e6de;color:#173d43;font-family:Arial,Helvetica,sans-serif}
  *{box-sizing:border-box}
  a{color:inherit}
  .home{min-height:100vh;background:#e8e6de;overflow:hidden}
  .hero{position:relative;min-height:100svh;isolation:isolate;overflow:hidden}
  .scene{position:absolute;inset:0;z-index:-5}
  .scene img{width:100%;height:100%;object-fit:cover;object-position:center center;display:block;filter:saturate(.92) contrast(.98)}
  .scene::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(248,247,240,.06) 0%,rgba(248,247,240,.02) 52%,rgba(232,230,222,.96) 83%,#e8e6de 100%)}

  /* hide the UI that exists inside the raster reference; only the mountain artwork remains visible */
  .clean-top{position:absolute;z-index:-2;left:0;right:0;top:0;height:96px;background:linear-gradient(180deg,rgba(248,247,240,.98),rgba(248,247,240,.88));backdrop-filter:blur(10px)}
  .clean-copy{position:absolute;z-index:-2;left:0;top:96px;width:min(46vw,760px);height:53vh;background:linear-gradient(90deg,rgba(246,245,238,.97) 0%,rgba(246,245,238,.90) 62%,rgba(246,245,238,.40) 84%,rgba(246,245,238,0) 100%)}
  .clean-bottom{position:absolute;z-index:-2;left:0;right:0;bottom:0;height:35vh;background:linear-gradient(180deg,rgba(232,230,222,.20),rgba(232,230,222,.90) 25%,#e8e6de 100%)}

  .header{position:relative;z-index:10;display:flex;align-items:center;gap:28px;min-height:92px;width:min(1480px,calc(100% - 48px));margin:0 auto}
  .brand{flex:0 0 auto;width:300px;aspect-ratio:442/74;background-repeat:no-repeat;background-size:378.3% auto;background-position:6.34% 2.08%;text-indent:-9999px;overflow:hidden}
  .nav{display:flex;align-items:center;justify-content:flex-end;gap:28px;flex:1}
  .nav a{position:relative;padding:35px 0 28px;text-decoration:none;font-size:13px;font-weight:650;white-space:nowrap}
  .nav a::after{content:"";position:absolute;left:50%;right:50%;bottom:20px;height:2px;background:#b89657;transition:.22s ease}
  .nav a:hover::after,.nav a:focus-visible::after{left:0;right:0}
  .search-link{width:44px;height:44px;border-radius:50%;display:grid;place-items:center;text-decoration:none;flex:none}
  .search-link span{width:18px;height:18px;border:2px solid #173d43;border-radius:50%;position:relative}
  .search-link span::after{content:"";position:absolute;width:8px;height:2px;background:#173d43;right:-6px;bottom:-3px;transform:rotate(45deg)}
  .menu-button{display:none}

  .hero-grid{position:relative;z-index:4;width:min(1480px,calc(100% - 48px));margin:0 auto;display:grid;grid-template-columns:minmax(0,1.05fr) minmax(360px,.75fr);gap:52px;align-items:start;padding-top:76px}
  .hero-copy{max-width:650px}
  .kicker{font-size:12px;letter-spacing:.35em;text-transform:uppercase;color:#7f9597;font-weight:700;margin-bottom:24px}
  .hero-copy h1{font-family:Georgia,'Times New Roman',serif;font-size:clamp(64px,6.2vw,108px);line-height:.86;letter-spacing:-.055em;font-weight:500;margin:0;color:#173d43}
  .hero-copy p{max-width:520px;font-size:18px;line-height:1.45;letter-spacing:.06em;color:#34565b;margin:34px 0 0}
  .accent-line{width:68px;height:3px;background:#b89657;margin-top:22px}
  .cta{display:inline-flex;align-items:center;gap:24px;margin-top:28px;min-height:54px;padding:0 28px;border-radius:999px;background:#1d5052;color:#fff;text-decoration:none;font-weight:750;box-shadow:0 12px 30px rgba(21,65,67,.20);transition:transform .2s ease,box-shadow .2s ease}
  .cta:hover{transform:translateY(-2px);box-shadow:0 16px 34px rgba(21,65,67,.25)}

  .weather{justify-self:end;width:min(390px,100%);padding:20px;border-radius:22px;background:rgba(249,248,242,.90);border:1px solid rgba(255,255,255,.82);box-shadow:0 18px 45px rgba(32,58,58,.12);backdrop-filter:blur(12px)}
  .weather-head{display:flex;align-items:center;justify-content:space-between;gap:14px;margin-bottom:14px}
  .weather-head strong{font-family:Georgia,'Times New Roman',serif;font-size:20px;font-weight:600}
  .weather-head small{font-size:10px;letter-spacing:.08em;color:#7b8a89}
  .weather-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}
  .station{padding:13px;border-radius:15px;background:rgba(255,255,255,.70);border:1px solid rgba(28,71,73,.07)}
  .station-top{display:flex;justify-content:space-between;gap:8px;align-items:center}
  .station-name{font-size:12px;font-weight:800}
  .station-status{font-size:8px;color:#6d807e}
  .station-main{display:flex;align-items:center;gap:9px;margin:9px 0 8px}
  .station-icon{width:36px;height:40px;display:grid;place-items:center}
  .station-icon svg{width:100%;height:100%}
  .station-temp{font-family:Georgia,'Times New Roman',serif;font-size:34px;line-height:1;font-weight:600;white-space:nowrap}
  .station-temp sup{font-size:.42em}
  .station-meta{font-size:9px;line-height:1.35;color:#6c7d7b}
  .station-stats{display:grid;grid-template-columns:1fr 1fr;gap:4px;margin:0}
  .station-stats div{padding:5px 6px;border-radius:8px;background:rgba(246,246,241,.88)}
  .station-stats dt{font-size:7px;text-transform:uppercase;color:#84918f;font-weight:800}
  .station-stats dd{margin:2px 0 0;font-size:10px;font-weight:800}
  .station-stats dd small{font-size:7px;margin-left:1px}
  .station-source{display:none}

  .cards-section{position:relative;z-index:6;width:min(1400px,calc(100% - 48px));margin:75px auto 0;padding-bottom:58px}
  .cards{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:14px}
  .card{display:flex;flex-direction:column;min-height:218px;overflow:hidden;border-radius:16px;background:rgba(248,248,242,.88);border:1px solid rgba(255,255,255,.82);box-shadow:0 15px 40px rgba(41,61,58,.10);text-decoration:none;transition:transform .22s ease,box-shadow .22s ease}
  .card:hover,.card:focus-visible{transform:translateY(-7px);box-shadow:0 22px 48px rgba(41,61,58,.16)}
  .card-art{height:92px;background-repeat:no-repeat;background-size:var(--art-size) auto;background-position:var(--art-pos);flex:none}
  .card-body{display:flex;flex-direction:column;align-items:center;text-align:center;flex:1;padding:12px 12px 13px}
  .card h2{font-family:Georgia,'Times New Roman',serif;font-size:21px;line-height:1.05;font-weight:600;margin:0 0 8px;color:#173d43}
  .card p{font-size:9px;line-height:1.35;letter-spacing:.08em;text-transform:uppercase;color:#7c8986;margin:0;min-height:25px}
  .card-go{width:30px;height:30px;border:1px solid #829997;border-radius:50%;display:grid;place-items:center;margin-top:auto;font-size:18px;color:#41625f;transition:.2s ease}
  .card:hover .card-go{background:#1d5052;color:#fff;border-color:#1d5052}

  .scroll-cue{display:grid;place-items:center;width:48px;height:34px;margin:0 auto 18px;border:0;background:transparent;color:#4d6a67;font-size:24px;cursor:pointer}
  .scroll-cue:hover{transform:translateY(2px)}

  @media(max-width:1180px){
    .nav{gap:14px}.nav a{font-size:11px}.brand{width:255px}
    .hero-grid{grid-template-columns:1fr;gap:26px;padding-top:48px}
    .weather{justify-self:start;width:min(650px,100%)}
    .cards{grid-template-columns:repeat(3,1fr)}
    .cards-section{margin-top:50px}
    .clean-copy{width:65vw}
  }
  @media(max-width:780px){
    .hero{min-height:auto}
    .scene img{object-position:57% center}
    .clean-top{height:78px}
    .clean-copy{top:78px;width:100%;height:470px;background:linear-gradient(180deg,rgba(246,245,238,.94) 0%,rgba(246,245,238,.80) 70%,rgba(246,245,238,0) 100%)}
    .header{min-height:78px;width:calc(100% - 24px)}
    .brand{width:210px}
    .menu-button{display:inline-flex;align-items:center;justify-content:center;width:44px;height:44px;border:0;border-radius:50%;background:rgba(255,255,255,.75);margin-left:auto;color:#173d43;font-size:22px;cursor:pointer}
    .search-link{order:3}
    .nav{position:absolute;top:70px;left:0;right:0;display:none;flex-direction:column;align-items:stretch;gap:0;padding:10px;border-radius:18px;background:rgba(248,247,240,.98);box-shadow:0 18px 44px rgba(32,58,58,.14)}
    .nav.open{display:flex}
    .nav a{padding:13px 14px;border-radius:11px}
    .nav a:hover{background:#edf0ea}
    .nav a::after{display:none}
    .hero-grid{width:calc(100% - 28px);padding-top:42px}
    .hero-copy h1{font-size:clamp(55px,15vw,80px)}
    .hero-copy p{font-size:15px;letter-spacing:.02em}
    .weather{width:100%}
    .cards-section{width:calc(100% - 24px);margin-top:44px}
    .cards{grid-template-columns:repeat(2,1fr);gap:10px}
    .card{min-height:210px}
    .card h2{font-size:18px}
  }
  @media(max-width:460px){
    .brand{width:176px}
    .search-link{width:40px;height:40px}
    .hero-copy h1{font-size:52px}
    .weather-grid{grid-template-columns:1fr}
    .cards{grid-template-columns:1fr}
    .card{min-height:205px}
    .card-art{height:106px}
  }
</style>

<div class="home">
  <section class="hero" id="home">
    <div class="scene" aria-hidden="true"><img src={master} alt="" /></div>
    <div class="clean-top" aria-hidden="true"></div>
    <div class="clean-copy" aria-hidden="true"></div>
    <div class="clean-bottom" aria-hidden="true"></div>

    <header class="header">
      <a class="brand" href="/" style={"background-image:url('" + master + "')"} aria-label="Panachaiko Trails">Panachaiko Trails</a>
      <nav class="nav" id="mainNav" aria-label="Κύρια πλοήγηση">
        <a href="/">Αρχική</a>
        <a href="/trails">Μονοπάτια</a>
        <a href="/points">Σημεία ενδιαφέροντος</a>
        <a href="/shelters">Καταφύγια</a>
        <a href="/photos">Φωτογραφίες</a>
        <a href="/news">Νέα</a>
      </nav>
      <button class="menu-button" id="menuButton" type="button" aria-label="Άνοιγμα μενού" aria-expanded="false">☰</button>
      <a class="search-link" href="/search" aria-label="Αναζήτηση"><span aria-hidden="true"></span></a>
    </header>

    <div class="hero-grid">
      <section class="hero-copy">
        <div class="kicker">ΦΥΣΗ · ΠΕΡΙΠΕΤΕΙΑ · ΑΥΘΕΝΤΙΚΕΣ ΕΜΠΕΙΡΙΕΣ</div>
        <h1>Ανακάλυψε<br/>το Παναχαϊκό</h1>
        <div class="accent-line"></div>
        <p>Μονοπάτια, κορυφές και μοναδικά τοπία σε ένα βουνό γεμάτο ιστορία, φύση και εμπειρίες κάθε εποχή του χρόνου.</p>
        <a class="cta" href="/trails"><span>Ξεκίνα την εξερεύνηση</span><span aria-hidden="true">→</span></a>
      </section>

      <section class="weather" aria-label="Ζωντανός καιρός">
        <div class="weather-head"><strong>Καιρός τώρα</strong><small>Πάτρα & Παναχαϊκό</small></div>
        <div class="weather-grid">
          <article class="station" data-live-station="panachaiko">
            <div class="station-top"><span class="station-name" data-station-name>Παναχαϊκό</span><span class="station-status" data-station-status>Φόρτωση…</span></div>
            <div class="station-main"><div class="station-icon" data-station-icon></div><div><div class="station-temp" data-station-temp>–<sup>°C</sup></div><div class="station-meta" data-station-feels></div><div class="station-meta" data-station-observed></div></div></div>
            <dl class="station-stats">
              <div><dt>Υγρασία</dt><dd data-station-hum>–</dd></div>
              <div><dt>Άνεμος</dt><dd data-station-wind>–</dd><span class="station-meta" data-station-wind-dir></span></div>
              <div><dt>Βροχή</dt><dd data-station-rain>–</dd></div>
              <div><dt>Πίεση</dt><dd data-station-pressure>–</dd></div>
            </dl>
            <span hidden data-station-elev></span><a hidden class="station-source" data-station-source href="#"></a>
          </article>

          <article class="station" data-live-station="patra">
            <div class="station-top"><span class="station-name" data-station-name>Πάτρα</span><span class="station-status" data-station-status>Φόρτωση…</span></div>
            <div class="station-main"><div class="station-icon" data-station-icon></div><div><div class="station-temp" data-station-temp>–<sup>°C</sup></div><div class="station-meta" data-station-feels></div><div class="station-meta" data-station-observed></div></div></div>
            <dl class="station-stats">
              <div><dt>Υγρασία</dt><dd data-station-hum>–</dd></div>
              <div><dt>Άνεμος</dt><dd data-station-wind>–</dd><span class="station-meta" data-station-wind-dir></span></div>
              <div><dt>Βροχή</dt><dd data-station-rain>–</dd></div>
              <div><dt>Πίεση</dt><dd data-station-pressure>–</dd></div>
            </dl>
            <span hidden data-station-elev></span><a hidden class="station-source" data-station-source href="#"></a>
          </article>
        </div>
      </section>
    </div>

    <section class="cards-section" id="categories" aria-label="Κατηγορίες">
      <div class="cards">
        {cards.map((card) => (
          <a class="card" href={card.href}>
            <div
              class="card-art"
              style={"background-image:url('" + master + "');--art-size:" + card.size + ";--art-pos:" + card.pos}
              aria-hidden="true"
            ></div>
            <div class="card-body">
              <h2>{card.title}</h2>
              <p>{card.subtitle}</p>
              <span class="card-go" aria-hidden="true">→</span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <button class="scroll-cue" id="scrollCue" type="button" aria-label="Μετάβαση στις κατηγορίες">⌄</button>
  </section>
</div>

<script src="../scripts/homepage-dual-weather.js"></script>
<script>
  const button = document.getElementById('menuButton');
  const nav = document.getElementById('mainNav');
  button?.addEventListener('click', () => {
    const open = nav?.classList.toggle('open') ?? false;
    button.setAttribute('aria-expanded', String(open));
  });
  nav?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => {
    nav.classList.remove('open');
    button?.setAttribute('aria-expanded','false');
  }));
  document.getElementById('scrollCue')?.addEventListener('click', () => {
    document.getElementById('categories')?.scrollIntoView({ behavior:'smooth', block:'start' });
  });
</script>
