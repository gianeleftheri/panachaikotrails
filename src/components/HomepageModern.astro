---
type TrailPoi = {
  id?: number;
  featured_image_url?: string | null;
  media_urls?: string[];
};
type Trail = {
  name?: string;
  description?: string;
  existing?: boolean;
  status?: string;
  length_km?: number;
  gain_m?: number;
  elev_max?: number | null;
  duration_minutes?: number;
  difficulty?: string;
  photos?: TrailPoi[];
};
type TrailEntry = { key?: string; trail?: Trail };
type PanelItem = { title?: string; meta?: string; image?: string | null };
type Panel = { background_image?: string; items?: PanelItem[] };
interface Props {
  panels?: Record<string, Panel>;
  featuredTrails?: TrailEntry[];
  trailCount?: number;
  recreationCount?: number;
  shelterCount?: number;
}
const {
  panels = {},
  featuredTrails = [],
  trailCount = 0,
  recreationCount = 0,
  shelterCount = 0,
} = Astro.props;

const fallbackImages = {
  trails:'https://images.unsplash.com/photo-1464278533981-50106e6176b1?auto=format&fit=crop&w=1200&q=76',
  poi:'https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?auto=format&fit=crop&w=1200&q=76',
  shelter:'https://images.unsplash.com/photo-1504280390367-361c6d9f38f4?auto=format&fit=crop&w=1200&q=76',
  photos:'https://images.unsplash.com/photo-1500534314209-a25ddb2bd429?auto=format&fit=crop&w=1200&q=76',
  video:'https://images.unsplash.com/photo-1500530855697-b586d89ba3ee?auto=format&fit=crop&w=1200&q=76',
};
const normalizedBg = (id:string) => {
  const raw = panels[id]?.background_image || fallbackImages[id as keyof typeof fallbackImages];
  return String(raw)
    .replace(/([?&])w=(?:1800|1440)(?=&|$)/,'$1w=1200')
    .replace(/([?&])q=(?:90|78)(?=&|$)/,'$1q=76');
};
const trailFallbacks = [normalizedBg('trails'),normalizedBg('poi'),normalizedBg('photos')];
const trailImage = (entry:TrailEntry,index:number) => {
  const photos = entry.trail?.photos || [];
  for (const p of photos) {
    if (p?.featured_image_url) return p.featured_image_url;
    if (p?.media_urls?.[0]) return p.media_urls[0];
  }
  return trailFallbacks[index % trailFallbacks.length];
};
const duration = (mins?:number) => {
  if (!mins || !Number.isFinite(mins)) return '';
  const h=Math.floor(mins/60), m=Math.round(mins%60);
  return h ? `${h}ω${m ? ' '+m+'′' : ''}` : `${m}′`;
};
const fmtKm=(v?:number)=>Number.isFinite(v) ? Number(v).toLocaleString('el-GR',{maximumFractionDigits:1})+' χλμ.' : '';
const fmtGain=(v?:number)=>Number.isFinite(v) && Number(v)>0 ? '+'+Math.round(Number(v))+' μ.' : '';
const cleanText=(value?:string)=>String(value||'')
  .replace(/&amp;#8211;|&#8211;|&ndash;/g,'–')
  .replace(/&amp;#8212;|&#8212;|&mdash;/g,'—')
  .replace(/&amp;quot;|&quot;/g,'"')
  .replace(/&amp;#039;|&#039;|&#39;/g,"'")
  .replace(/&amp;/g,'&');
---

<style is:global>
:root{
  --navy:#0b2342;--navy-2:#153153;--cyan:#0a8e97;--cyan-bright:#1bc5d0;
  --paper:#f8fbfd;--muted:#6d7b8e;--line:#dce5ec;--soft:#edf4f8;
}
*{box-sizing:border-box}
html{background:#eaf2f7;scroll-behavior:smooth}
body{margin:0;min-width:320px;color:var(--navy);background:#eaf2f7;font-family:Inter,ui-sans-serif,system-ui,-apple-system,"Segoe UI",Arial,sans-serif;-webkit-font-smoothing:antialiased}
a{color:inherit;text-decoration:none}
img{max-width:100%;display:block}
button{font:inherit}
:focus-visible{outline:3px solid var(--cyan-bright);outline-offset:3px}
.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}

.modern-shell{max-width:1500px;margin:22px auto;padding:0 18px}
.modern-page{overflow:hidden;border:1px solid rgba(11,35,66,.08);border-radius:28px;background:#fff;box-shadow:0 30px 70px rgba(32,67,92,.16)}
.hero{position:relative;min-height:610px;color:#fff;isolation:isolate}
.hero-bg{position:absolute;inset:0;z-index:-4;background:url('/dashboard-hero.webp') center 47%/cover no-repeat}
.hero::before{content:"";position:absolute;inset:0;z-index:-3;background:linear-gradient(90deg,rgba(7,38,65,.66) 0%,rgba(8,52,72,.28) 46%,rgba(6,42,59,.14) 75%),linear-gradient(180deg,rgba(5,35,58,.34),transparent 26%,rgba(5,25,45,.26) 100%)}
.hero::after{content:"";position:absolute;inset:auto 0 0;height:140px;z-index:-2;background:linear-gradient(transparent,rgba(8,34,52,.3))}
.topnav{height:82px;display:grid;grid-template-columns:220px 1fr auto;align-items:center;gap:24px;padding:8px 42px;border-bottom:1px solid rgba(255,255,255,.14)}
.logo-link{display:flex;align-items:center;width:154px}
.logo-link img{width:154px;height:auto}
.nav-links{display:flex;justify-content:center;gap:28px;font-size:12px;font-weight:750}
.nav-links a{position:relative;padding:28px 0 23px;color:rgba(255,255,255,.88)}
.nav-links a:hover,.nav-links a:first-child{color:#fff}
.nav-links a:first-child::after{content:"";position:absolute;left:0;right:0;bottom:16px;height:2px;background:#36d2db;border-radius:2px}
.nav-map{display:inline-flex;align-items:center;gap:8px;padding:10px 16px;border:1px solid rgba(255,255,255,.42);border-radius:999px;background:rgba(0,119,131,.76);font-size:12px;font-weight:850;backdrop-filter:blur(8px)}
.nav-map:hover{background:#0a8e97}
.nav-map svg{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:1.8}

.hero-content{min-height:528px;display:flex;flex-direction:column;justify-content:center;padding:48px 54px 58px}
.hero-kicker{font-size:10px;font-weight:900;letter-spacing:.32em;text-transform:uppercase;color:#d8f8fb}
.hero-display{margin:12px 0 8px;max-width:780px;font-size:clamp(64px,7.2vw,116px);line-height:.78;letter-spacing:-.07em;text-transform:uppercase;text-shadow:0 8px 30px rgba(4,24,40,.28)}
.hero-display span{display:block}
.hero-subtitle{margin:18px 0 8px;font-size:clamp(27px,2.7vw,43px);line-height:1;letter-spacing:-.04em}
.hero-copy{max-width:620px;margin:0;color:rgba(255,255,255,.9);font-size:16px;line-height:1.55}
.hero-cta{display:inline-flex;align-items:center;gap:12px;margin-top:24px;padding:13px 20px;border:1px solid rgba(255,255,255,.54);border-radius:999px;background:rgba(0,126,138,.78);font-size:13px;font-weight:900;box-shadow:0 10px 30px rgba(0,0,0,.14);backdrop-filter:blur(8px)}
.hero-cta:hover{background:#0a8e97}
.hero-cta svg{width:23px;height:23px;fill:none;stroke:currentColor;stroke-width:1.9}

.weather-float{position:absolute;right:34px;bottom:34px;width:min(410px,33vw);padding:18px 19px 15px;border:1px solid rgba(255,255,255,.32);border-radius:20px;background:linear-gradient(135deg,rgba(24,43,54,.72),rgba(45,50,48,.56));box-shadow:0 20px 50px rgba(0,0,0,.23);backdrop-filter:blur(13px)}
.wx-head{display:flex;align-items:center;justify-content:space-between;gap:10px;font-size:10px;color:rgba(255,255,255,.82)}
.wx-place{font-weight:850;color:#fff}.wx-place small{font-weight:500}.wx-live{display:flex;align-items:center;gap:6px}.wx-dot{width:7px;height:7px;border-radius:50%;background:#39e17a}
.wx-main{display:flex;align-items:center;gap:12px;margin:8px 0}.wx-icon{width:58px;height:58px}.wx-icon svg{width:100%;height:100%}.wx-temp{font-size:48px;font-weight:900;line-height:.9}.wx-temp sup{font-size:.42em;color:#68e5ed}.wx-cond{font-size:15px;font-weight:850}.wx-sub{margin-top:2px;font-size:9.5px;color:rgba(255,255,255,.75)}.wx-sub b{color:#fff}
.wx-stats{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:5px;margin:0}.wx-stat{padding:6px;border-left:1px solid rgba(255,255,255,.14)}.wx-stat:first-child{border-left:0}.wx-stat dt{font-size:7.5px;text-transform:uppercase;color:rgba(255,255,255,.62)}.wx-stat dd{margin:3px 0 0;font-size:13px;font-weight:850;white-space:nowrap}.wx-stat dd small{font-size:.52em;margin-left:1px}.wx-stat .wx-note{display:none}.wx-hours,.wx-foot,.wx-alert{display:none}

.content{padding:26px 34px 44px;background:#fff}
.category-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:14px;margin-top:-1px}
.cat-card{position:relative;min-height:230px;overflow:hidden;border:1px solid var(--line);border-radius:18px;background:#fff;box-shadow:0 8px 22px rgba(32,67,92,.05);transition:transform .22s ease,box-shadow .22s ease}
.cat-card:hover{transform:translateY(-4px);box-shadow:0 18px 34px rgba(32,67,92,.12)}
.cat-photo{height:112px;background-position:center;background-size:cover}
.cat-icon{position:absolute;left:18px;top:88px;width:48px;height:48px;display:grid;place-items:center;border:4px solid #fff;border-radius:50%;background:var(--cyan);color:#fff;box-shadow:0 4px 12px rgba(7,88,98,.2)}
.cat-icon svg{width:25px;height:25px;fill:none;stroke:currentColor;stroke-width:1.9;stroke-linecap:round;stroke-linejoin:round}
.cat-body{padding:31px 18px 16px}.cat-title{margin:0;font-size:17px;letter-spacing:-.025em}.cat-body p{margin:6px 0 0;min-height:38px;color:var(--muted);font-size:11px;line-height:1.5}
.cat-arrow{position:absolute;right:14px;bottom:13px;width:29px;height:29px;display:grid;place-items:center;border:1px solid var(--line);border-radius:50%;font-size:16px;color:#16818b}

.section-head{display:flex;align-items:end;justify-content:space-between;gap:20px;margin:42px 0 16px}
.section-kicker{font-size:9px;font-weight:900;letter-spacing:.25em;color:#3199a1;text-transform:uppercase}
.section-title{margin:5px 0 0;font-size:30px;letter-spacing:-.045em}
.section-link{font-size:11px;font-weight:800;color:#17838c}
.trails-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}
.trail-card{overflow:hidden;border:1px solid var(--line);border-radius:18px;background:#fff;box-shadow:0 8px 22px rgba(32,67,92,.05);transition:transform .22s ease,box-shadow .22s ease}
.trail-card:hover{transform:translateY(-3px);box-shadow:0 16px 32px rgba(32,67,92,.12)}
.trail-image{height:175px;background-size:cover;background-position:center}
.trail-body{position:relative;padding:15px 16px 17px}.trail-title{margin:0;padding-right:34px;font-size:16px;line-height:1.25;letter-spacing:-.02em}.trail-code{margin-bottom:5px;font-size:9px;font-weight:900;letter-spacing:.12em;color:#198c95}
.trail-meta{display:flex;flex-wrap:wrap;gap:12px;margin-top:12px;color:var(--muted);font-size:10px}.trail-meta span{display:flex;align-items:center;gap:4px}.trail-open{position:absolute;right:14px;top:14px;width:30px;height:30px;display:grid;place-items:center;border:1px solid var(--line);border-radius:50%;color:#16818b}
.empty{grid-column:1/-1;padding:26px;border:1px dashed var(--line);border-radius:16px;color:var(--muted);text-align:center}

.footer{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-top:42px;padding:23px 0 0;border-top:1px solid var(--line);color:#7f8b99;font-size:10px}.footer img{width:92px;filter:brightness(.35) saturate(.8)}

@media(max-width:1100px){
  .topnav{grid-template-columns:170px 1fr auto;padding-inline:28px}.nav-links{gap:15px;font-size:10px}.logo-link,.logo-link img{width:130px}
  .hero{min-height:560px}.hero-content{min-height:478px;padding:40px}.hero-display{font-size:78px}.weather-float{width:360px;right:25px}
  .category-grid{grid-template-columns:repeat(3,1fr)}.cat-card:nth-child(4),.cat-card:nth-child(5){min-height:210px}
}
@media(max-width:760px){
  .modern-shell{margin:0;padding:0}.modern-page{border-radius:0;border:0;box-shadow:none}
  .hero{min-height:610px}.hero-bg{background-position:59% center}
  .topnav{height:72px;grid-template-columns:1fr auto;padding:8px 18px}.logo-link,.logo-link img{width:122px}.nav-links{display:none}.nav-map{padding:9px 11px}.nav-map span{display:none}
  .hero-content{min-height:538px;justify-content:flex-end;padding:32px 20px 180px}.hero-display{font-size:52px;line-height:.82}.hero-subtitle{font-size:28px}.hero-copy{font-size:13px}.hero-kicker{font-size:9px}
  .weather-float{left:18px;right:18px;bottom:20px;width:auto;padding:13px}.wx-temp{font-size:42px}.wx-icon{width:46px;height:46px}.wx-stats{gap:0}.wx-stat{padding:4px}.wx-stat dd{font-size:11.5px}
  .content{padding:18px 14px 32px}.category-grid{grid-template-columns:repeat(2,1fr);gap:10px}.cat-card{min-height:205px}.cat-card:last-child{grid-column:1/-1;min-height:190px}.cat-photo{height:96px}.cat-icon{top:74px;width:44px;height:44px}.cat-body{padding:29px 14px 14px}.cat-title{font-size:15px}.cat-body p{font-size:10px}
  .section-head{margin-top:30px}.section-title{font-size:25px}.section-link{display:none}.trails-grid{grid-template-columns:1fr}.trail-image{height:190px}
  .footer{align-items:flex-start;flex-direction:column}
}
@media(prefers-reduced-motion:reduce){*,*::before,*::after{transition:none!important}}
</style>

<div class="modern-shell">
  <div class="modern-page">
    <section class="hero">
      <div class="hero-bg" aria-hidden="true"></div>
      <header class="topnav">
        <a class="logo-link" href="/home-modern" aria-label="Panachaiko Trails">
          <img src="/logo-panachaiko.svg" alt="Panachaiko Trails" width="154" height="84" />
        </a>
        <nav class="nav-links" aria-label="Κύρια πλοήγηση">
          <a href="/home-modern">Αρχική</a><a href="#trails">Μονοπάτια</a><a href="#trails">Κορυφές</a><a href="#shelters">Καταφύγια</a><a href="#experiences">Εμπειρίες</a><a href="#photos">Φωτογραφίες</a><a href="#video">Βίντεο</a>
        </nav>
        <a class="nav-map" href="/map"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m3 6 6-3 6 3 6-3v15l-6 3-6-3-6 3Z"/><path d="M9 3v15M15 6v15"/></svg><span>Χάρτης</span></a>
      </header>

      <div class="hero-content">
        <div class="hero-kicker">ΒΟΥΝΟ • ΦΥΣΗ • ΕΜΠΕΙΡΙΕΣ</div>
        <h1 class="hero-display"><span>PANACHAIKO</span><span>TRAILS</span></h1>
        <h2 class="hero-subtitle">Ανακαλύψτε το Παναχαϊκό</h2>
        <p class="hero-copy">Μονοπάτια, κορυφές, καταφύγια και μοναδικές εμπειρίες στην καρδιά της Αχαΐας.</p>
        <a class="hero-cta" href="/map"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m3 6 6-3 6 3 6-3v15l-6 3-6-3-6 3Z"/><path d="M9 3v15M15 6v15"/></svg>Εξερεύνηση Χάρτη <span aria-hidden="true">→</span></a>
      </div>

      <section class="weather-float wx is-loading" id="wx" aria-labelledby="wx-title" aria-busy="true">
        <div class="wx-head"><span class="wx-place" id="wx-title">Παναχαϊκό <small id="wx-elev"></small></span><span class="wx-live"><span class="wx-dot"></span><span id="wx-updated">Φόρτωση…</span></span></div>
        <div class="wx-main"><div class="wx-icon" id="wx-icon" aria-hidden="true"></div><div class="wx-temp" id="wx-temp">--<sup>°C</sup></div><div><div class="wx-cond" id="wx-cond">Καιρός</div><div class="wx-sub" id="wx-sub"></div></div></div>
        <dl class="wx-stats">
          <div class="wx-stat"><dt>Υγρασία</dt><dd id="wx-hum">--</dd><dd class="wx-note" id="wx-cloud"></dd></div>
          <div class="wx-stat" id="wx-wind-box"><dt>Άνεμος</dt><dd id="wx-wind">--</dd><dd class="wx-note" id="wx-wind-note"></dd></div>
          <div class="wx-stat" id="wx-prec-box"><dt id="wx-prec-label">Βροχή</dt><dd id="wx-prec">--</dd><dd class="wx-note" id="wx-prec-note"></dd></div>
          <div class="wx-stat"><dt>Πίεση</dt><dd id="wx-pres">--</dd><dd class="wx-note" id="wx-pres-note">hPa</dd></div>
        </dl>
        <div class="wx-hours" id="wx-hours"></div><div class="wx-alert" id="wx-alert" hidden></div><div class="wx-foot"><span id="wx-source"></span></div><span class="sr-only" aria-live="polite" id="wx-sr"></span>
      </section>
    </section>

    <main class="content">
      <section class="category-grid" id="experiences" aria-label="Εξερεύνηση Παναχαϊκού">
        <a class="cat-card" href="/map" id="trails"><div class="cat-photo" style={'background-image:url("'+normalizedBg('trails').replace(/"/g,'%22')+'")'}></div><span class="cat-icon"><svg viewBox="0 0 24 24"><circle cx="13" cy="4" r="2"/><path d="m11 7-2 5 4 2 2-4 3 3"/><path d="m10 12-4 7M13 14l3 6M8 9l-3 2"/></svg></span><div class="cat-body"><h3 class="cat-title">Μονοπάτια</h3><p>Ανακαλύψτε διαδρομές με πραγματικά στοιχεία μήκους και υψομέτρου.</p></div><span class="cat-arrow">→</span></a>
        <a class="cat-card" href="/map"><div class="cat-photo" style={'background-image:url("'+normalizedBg('poi').replace(/"/g,'%22')+'")'}></div><span class="cat-icon"><svg viewBox="0 0 24 24"><path d="M12 21s6-5.3 6-11a6 6 0 1 0-12 0c0 5.7 6 11 6 11Z"/><circle cx="12" cy="10" r="2"/></svg></span><div class="cat-body"><h3 class="cat-title">Σημεία Ενδιαφέροντος</h3><p>Φυσικά σημεία, θέα, ιστορία και στάσεις γύρω από το βουνό.</p></div><span class="cat-arrow">→</span></a>
        <a class="cat-card" href="/map" id="shelters"><div class="cat-photo" style={'background-image:url("'+normalizedBg('shelter').replace(/"/g,'%22')+'")'}></div><span class="cat-icon"><svg viewBox="0 0 24 24"><path d="m3 11 9-7 9 7"/><path d="M5 10v11h14V10"/><path d="M8 14h8M8 17h8"/></svg></span><div class="cat-body"><h3 class="cat-title">Καταφύγια</h3><p>Τα ορειβατικά καταφύγια και οι πληροφορίες πρόσβασής τους.</p></div><span class="cat-arrow">→</span></a>
        <a class="cat-card" href="/map" id="photos"><div class="cat-photo" style={'background-image:url("'+normalizedBg('photos').replace(/"/g,'%22')+'")'}></div><span class="cat-icon"><svg viewBox="0 0 24 24"><path d="M4 7h4l2-2h4l2 2h4v13H4Z"/><circle cx="12" cy="13.5" r="4"/></svg></span><div class="cat-body"><h3 class="cat-title">Φωτογραφίες</h3><p>Εικόνες από το Παναχαϊκό και τις διαδρομές του.</p></div><span class="cat-arrow">→</span></a>
        <a class="cat-card" href="/map" id="video"><div class="cat-photo" style={'background-image:url("'+normalizedBg('video').replace(/"/g,'%22')+'")'}></div><span class="cat-icon"><svg viewBox="0 0 24 24"><rect x="3" y="6" width="18" height="12" rx="4"/><path d="m10 10 5 3-5 3Z"/></svg></span><div class="cat-body"><h3 class="cat-title">Βίντεο</h3><p>Δείτε το Παναχαϊκό σε κίνηση μέσα από επιλεγμένο υλικό.</p></div><span class="cat-arrow">→</span></a>
      </section>

      <section aria-labelledby="routes-title">
        <div class="section-head">
          <div><div class="section-kicker">ΠΡΑΓΜΑΤΙΚΑ ΔΕΔΟΜΕΝΑ CMS</div><h2 class="section-title" id="routes-title">Προτεινόμενες διαδρομές</h2></div>
          <a class="section-link" href="/map">Προβολή όλων στον χάρτη →</a>
        </div>
        <div class="trails-grid">
          {featuredTrails.length ? featuredTrails.map((entry,index) => (
            <a class="trail-card" href="/map">
              <div class="trail-image" style={'background-image:url("'+trailImage(entry,index).replace(/"/g,'%22')+'")'}></div>
              <div class="trail-body">
                <div class="trail-code">{entry.key || 'ΜΟΝΟΠΑΤΙ'}</div>
                <h3 class="trail-title">{cleanText(entry.trail?.name || entry.key)}</h3>
                <div class="trail-meta">
                  {fmtKm(entry.trail?.length_km) && <span>↝ {fmtKm(entry.trail?.length_km)}</span>}
                  {fmtGain(entry.trail?.gain_m) && <span>↗ {fmtGain(entry.trail?.gain_m)}</span>}
                  {duration(entry.trail?.duration_minutes) && <span>◷ {duration(entry.trail?.duration_minutes)}</span>}
                  {entry.trail?.difficulty && <span>◆ {entry.trail.difficulty}</span>}
                </div>
                <span class="trail-open">→</span>
              </div>
            </a>
          )) : <div class="empty">Τα δεδομένα διαδρομών δεν ήταν διαθέσιμα αυτή τη στιγμή.</div>}
        </div>
      </section>

      <footer class="footer">
        <img src="/logo-panachaiko.svg" alt="Panachaiko Trails" width="92" height="50" />
        <span>{trailCount} μονοπάτια · {recreationCount} σημεία αναψυχής · {shelterCount} καταφύγια · Ζωντανός καιρός Παναχαϊκού</span>
      </footer>
    </main>
  </div>
</div>
<script src="../scripts/homepage-weather.js"></script>
