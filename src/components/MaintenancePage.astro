<section class="maintenance-page" aria-labelledby="maintenance-title">
  <div class="scene" aria-hidden="true">
    <div class="scene-media">
      <img class="scene-image" src="/maintenance-hero.svg" alt="" />
    </div>
    <div class="scene-blend"></div>
    <div class="scene-shade"></div>
    <div class="grid"></div>
    <div class="ring ring-one"></div>
    <div class="ring ring-two"></div>
    <div class="node node-a"><span></span></div>
    <div class="node node-b"><span></span></div>
  </div>

  <div class="inner">
    <header>
      <a class="brand" href="/" aria-label="Panachaiko Trails – Αρχική">
        <img src="/logo-panachaiko.svg" alt="Panachaiko Trails" width="256" height="140" />
      </a>
      <div class="live"><span></span> SITE UPDATE</div>
    </header>

    <main class="layout">
      <div class="copy">
        <p class="kicker"><i></i> ΠΡΟΣΩΡΙΝΗ ΕΝΗΜΕΡΩΣΗ</p>
        <h1 id="maintenance-title">Η ιστοσελίδα<br />βρίσκεται <em>υπό<br />κατασκευή.</em></h1>
        <p class="message">Χαρτογραφούμε το Παναχαϊκό και δημιουργούμε μια νέα εμπειρία για πεζοπόρους, ποδηλάτες και φίλους του βουνού.</p>

        <div class="progress">
          <span class="pulse"></span>
          <div>
            <strong>Οι εργασίες βρίσκονται σε εξέλιξη</strong>
            <small>Σύντομα θα είμαστε κοντά σας.</small>
          </div>
        </div>

        <div class="actions">
          <a class="contact" href="mailto:info@panachaikotrails.gr">ΕΠΙΚΟΙΝΩΝΙΑ <span>→</span></a>
          <a class="preview" href="/preview">ΙΔΙΩΤΙΚΗ ΠΡΟΕΠΙΣΚΟΠΗΣΗ</a>
        </div>
      </div>
    </main>

    <footer aria-hidden="true"></footer>
  </div>
</section>

<style>
  :global(*){box-sizing:border-box}
  :global(html){min-width:320px;min-height:100%;background:#061b14}
  :global(body){margin:0;min-width:320px;min-height:100%;overflow-x:hidden;font-family:Arial,Helvetica,sans-serif;background:#061b14}

  .maintenance-page{
    --lime:#d7f33f;
    position:relative;
    isolation:isolate;
    min-height:100svh;
    overflow:hidden;
    color:#fff;
    background:#061b14;
  }

  .scene{position:absolute;inset:0;z-index:-2;overflow:hidden;background:#061b14}
  .scene-media{
    position:absolute;
    inset:0;
    display:flex;
    align-items:center;
    justify-content:flex-end;
    overflow:hidden;
  }
  .scene-image{
    display:block;
    width:auto;
    height:100%;
    max-width:none;
    flex:0 0 auto;
    object-fit:contain;
    object-position:right center;
    image-rendering:auto;
    filter:saturate(.88) contrast(1.02) brightness(.72);
  }
  .scene-blend{
    position:absolute;
    inset:0;
    pointer-events:none;
    background:
      linear-gradient(
        90deg,
        rgba(4,26,20,.98) 0%,
        rgba(4,26,20,.92) 24%,
        rgba(4,26,20,.82) 40%,
        rgba(4,26,20,.58) 56%,
        rgba(4,26,20,.28) 68%,
        rgba(4,26,20,.08) 78%,
        rgba(4,26,20,0) 100%
      ),
      radial-gradient(
        circle at 72% 48%,
        rgba(24,80,66,.34) 0%,
        rgba(16,56,45,.22) 28%,
        rgba(8,31,24,.12) 48%,
        rgba(0,0,0,0) 70%
      );
  }
  .scene-shade{
    position:absolute;
    inset:0;
    background:
      linear-gradient(
        90deg,
        #041c15 0%,
        rgba(4,28,21,.98) 22%,
        rgba(4,28,21,.94) 38%,
        rgba(4,28,21,.74) 54%,
        rgba(4,28,21,.42) 66%,
        rgba(4,28,21,.14) 78%,
        rgba(4,28,21,.02) 100%
      ),
      linear-gradient(
        180deg,
        rgba(3,17,12,.28) 0%,
        rgba(3,17,12,.08) 26%,
        rgba(3,17,12,.10) 64%,
        rgba(3,17,12,.44) 100%
      );
  }
  .grid{
    position:absolute;
    inset:0;
    opacity:.28;
    background-image:linear-gradient(rgba(255,255,255,.035) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.035) 1px,transparent 1px);
    background-size:52px 52px;
    mask-image:linear-gradient(90deg,#000 0%,#000 38%,transparent 72%);
  }

  .ring{position:absolute;border:1px solid rgba(210,239,74,.18);border-radius:50%;pointer-events:none}
  .ring-one{width:min(48vw,760px);height:min(48vw,760px);right:1vw;top:7vh}
  .ring-two{width:min(35vw,540px);height:min(35vw,540px);right:8vw;top:16vh;border-style:dashed;opacity:.45}
  .node{position:absolute;width:17px;height:17px;border:1px solid var(--lime);border-radius:50%;background:rgba(5,31,22,.72)}
  .node span{position:absolute;inset:5px;border-radius:50%;background:var(--lime)}
  .node::after{content:"";position:absolute;top:7px;width:76px;height:1px;background:linear-gradient(90deg,rgba(215,243,63,.65),transparent)}
  .node-a{right:7.5vw;top:24vh}
  .node-b{right:2vw;bottom:15vh}

  .inner{
    width:min(100%,1540px);
    min-height:100svh;
    margin:0 auto;
    padding:clamp(24px,3.4vh,42px) clamp(24px,6.2vw,100px) clamp(20px,2.8vh,34px);
    display:grid;
    grid-template-rows:auto 1fr auto;
  }

  header{display:flex;align-items:flex-start;justify-content:space-between;gap:28px}
  .brand{display:inline-flex;align-items:flex-start;text-decoration:none}
  .brand img{
    display:block;
    width:clamp(185px,13vw,250px);
    height:auto;
    filter:drop-shadow(0 12px 28px rgba(0,0,0,.28));
  }
  .live{display:flex;align-items:center;gap:11px;margin-top:10px;color:#c0ccc6;font-size:10px;font-weight:800;letter-spacing:.2em;white-space:nowrap}
  .live span{width:8px;height:8px;border-radius:50%;background:var(--lime);box-shadow:0 0 0 6px rgba(215,243,63,.1),0 0 20px rgba(215,243,63,.42)}

  .layout{display:flex;align-items:center;padding:clamp(38px,6vh,84px) 0 clamp(46px,7vh,90px)}
  .copy{position:relative;z-index:2;width:min(100%,650px)}
  .kicker{display:flex;align-items:center;gap:14px;margin:0 0 26px;color:#c4cfca;font-size:11px;font-weight:800;letter-spacing:.22em}
  .kicker i{display:block;width:31px;height:2px;background:var(--lime)}
  h1{
    margin:0 0 28px;
    font-size:clamp(54px,5.6vw,92px);
    line-height:.96;
    font-weight:400;
    letter-spacing:-.055em;
    text-wrap:balance;
  }
  h1 em{color:var(--lime);font-style:normal;font-weight:500}
  .message{
    max-width:610px;
    margin:0;
    color:#c2cec8;
    font-size:clamp(16px,1.2vw,19px);
    line-height:1.68;
  }

  .progress{
    display:flex;
    align-items:center;
    gap:16px;
    width:min(100%,590px);
    margin-top:35px;
    padding:17px 20px;
    border-left:2px solid var(--lime);
    background:rgba(7,37,27,.52);
    backdrop-filter:blur(5px);
  }
  .progress>div{display:grid;gap:3px}
  .progress strong{font-size:13px}
  .progress small{color:#aebdb6;font-size:12px}
  .pulse{width:10px;height:10px;flex:0 0 auto;border-radius:50%;background:var(--lime);box-shadow:0 0 0 7px rgba(215,243,63,.1);animation:pulse 2s ease-in-out infinite}

  .actions{display:flex;flex-wrap:wrap;align-items:center;gap:34px;margin-top:29px}
  .contact{
    display:inline-flex;
    align-items:center;
    justify-content:space-between;
    gap:28px;
    min-width:184px;
    min-height:54px;
    padding:0 23px;
    border:1px solid var(--lime);
    background:var(--lime);
    color:#0d281d;
    font-size:11px;
    font-weight:900;
    letter-spacing:.12em;
    text-decoration:none;
    transition:transform .18s ease,background .18s ease;
  }
  .contact:hover{background:#e6fa78;transform:translateY(-2px)}
  .contact span{font-size:16px;line-height:1}
  .preview{color:#b7c5be;font-size:9px;font-weight:800;letter-spacing:.16em;text-underline-offset:6px}
  .preview:hover{color:#fff}

  footer{height:1px;border-top:1px solid rgba(255,255,255,.11)}

  @keyframes pulse{50%{box-shadow:0 0 0 11px rgba(215,243,63,0)}}

  @media(max-width:980px){
    .scene-media{
      justify-content:flex-end;
    }
    .scene-image{
      width:auto;
      height:100%;
      min-width:0;
      object-fit:contain;
      object-position:right center;
    }
    .scene-shade{background:linear-gradient(90deg,rgba(5,31,22,.98) 0%,rgba(5,31,22,.94) 48%,rgba(5,31,22,.68) 72%,rgba(5,31,22,.28) 100%),linear-gradient(180deg,rgba(3,18,13,.28),rgba(3,18,13,.22))}
    .copy{width:min(100%,620px)}
    .ring-one{right:-18vw;top:14vh}
    .ring-two{right:-5vw;top:22vh}
    .node-a,.node-b{display:none}
  }

  @media(max-width:620px){
    .maintenance-page{overflow:auto}
    .inner{padding:20px 18px 22px}
    .brand img{width:160px}
    .live{display:none}
    .layout{align-items:flex-start;padding:clamp(48px,9vh,78px) 0 54px}
    .scene-media{
      inset:auto 0 0;
      height:52svh;
      align-items:flex-end;
      justify-content:flex-end;
    }
    .scene-image{
      width:auto;
      height:100%;
      min-width:0;
      object-fit:contain;
      object-position:right bottom;
      filter:saturate(.90) contrast(1.02) brightness(.70);
    }
    .scene-blend{
      background:
        linear-gradient(
          180deg,
          rgba(4,26,20,.18) 0%,
          rgba(4,26,20,.26) 24%,
          rgba(4,26,20,.50) 56%,
          rgba(4,26,20,.82) 100%
        ),
        linear-gradient(
          90deg,
          rgba(4,26,20,.88) 0%,
          rgba(4,26,20,.58) 34%,
          rgba(4,26,20,.18) 72%,
          rgba(4,26,20,.02) 100%
        );
    }
    .scene-shade{
      background:
        linear-gradient(180deg,rgba(4,31,22,.72) 0%,rgba(4,31,22,.58) 31%,rgba(4,31,22,.83) 74%,rgba(4,24,18,.96) 100%),
        linear-gradient(90deg,rgba(5,34,24,.96) 0%,rgba(5,34,24,.82) 62%,rgba(5,34,24,.42) 100%);
    }
    .grid{opacity:.2;mask-image:linear-gradient(180deg,#000,transparent 86%)}
    .ring-one{width:96vw;height:96vw;right:-46vw;top:25vh}
    .ring-two{width:70vw;height:70vw;right:-24vw;top:31vh}
    .kicker{margin-bottom:22px;font-size:9px}
    h1{font-size:clamp(47px,14vw,67px);line-height:.98;margin-bottom:24px}
    .message{font-size:15px;line-height:1.62}
    .progress{margin-top:29px;padding:15px 15px}
    .progress strong{font-size:12px}
    .progress small{font-size:11px}
    .actions{display:grid;gap:22px;margin-top:25px}
    .contact{width:100%;min-height:52px}
    .preview{text-align:center}
  }

  @media(max-height:760px) and (min-width:621px){
    .brand img{width:180px}
    .layout{padding:30px 0 38px}
    h1{font-size:clamp(50px,5vw,74px);margin-bottom:20px}
    .kicker{margin-bottom:18px}
    .message{font-size:16px;line-height:1.55}
    .progress{margin-top:24px}
    .actions{margin-top:22px}
  }

  @media(prefers-reduced-motion:reduce){.pulse{animation:none}}
</style>
