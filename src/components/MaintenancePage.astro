<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit" async defer></script>

<script>
  const drawer = document.querySelector('[data-contact-drawer]');
  const backdrop = document.querySelector('[data-contact-backdrop]');
  const openButton = document.querySelector('[data-contact-open]');
  const closeButtons = document.querySelectorAll('[data-contact-close]');
  const form = document.querySelector('[data-contact-form]');
  const status = document.querySelector('[data-contact-status]');
  const submitButton = document.querySelector('[data-contact-submit]');
  const startedAt = document.querySelector('[data-contact-started]');
  const turnstileContainer = document.querySelector('[data-turnstile-container]');
  const turnstileNote = document.querySelector('[data-turnstile-note]');

  let lastFocused = null;
  let turnstileWidgetId = null;
  let turnstileSiteKey = '';
  let successCloseTimer = null;

  const waitForTurnstile = async () => {
    for (let i = 0; i < 40; i += 1) {
      if (window.turnstile?.render) return true;
      await new Promise((resolve) => window.setTimeout(resolve, 100));
    }
    return false;
  };

  const ensureTurnstile = async () => {
    if (!turnstileContainer) return;

    if (!turnstileSiteKey) {
      try {
        const response = await fetch('/api/contact-config', {
          headers: {'Accept':'application/json'},
          cache: 'no-store',
        });
        const config = await response.json().catch(() => ({}));

        if (!response.ok || !config?.configured || !config?.siteKey) {
          if (turnstileNote) {
            turnstileNote.textContent = 'Το Cloudflare Turnstile δεν έχει ρυθμιστεί ακόμη στο CMS.';
          }
          return;
        }

        turnstileSiteKey = config.siteKey;
      } catch {
        if (turnstileNote) {
          turnstileNote.textContent = 'Δεν ήταν δυνατή η φόρτωση της επαλήθευσης Cloudflare.';
        }
        return;
      }
    }

    const ready = await waitForTurnstile();
    if (!ready || !window.turnstile?.render) {
      if (turnstileNote) turnstileNote.textContent = 'Η επαλήθευση Cloudflare δεν φορτώθηκε. Ανανεώστε τη σελίδα.';
      return;
    }

    if (turnstileWidgetId !== null) {
      window.turnstile.reset(turnstileWidgetId);
      return;
    }

    turnstileWidgetId = window.turnstile.render(turnstileContainer, {
      sitekey: turnstileSiteKey,
      theme: 'dark',
      size: 'flexible',
      'response-field': true,
      'response-field-name': 'cf-turnstile-response',
      callback: () => {
        if (turnstileNote) turnstileNote.textContent = 'Η επαλήθευση ασφαλείας ολοκληρώθηκε.';
      },
      'expired-callback': () => {
        if (turnstileNote) turnstileNote.textContent = 'Η επαλήθευση έληξε. Ολοκληρώστε την ξανά.';
      },
      'error-callback': () => {
        if (turnstileNote) turnstileNote.textContent = 'Η επαλήθευση Cloudflare απέτυχε. Δοκιμάστε ξανά.';
      },
    });
  };

  const openDrawer = () => {
    if (!drawer || !backdrop) return;
    lastFocused = document.activeElement;
    backdrop.hidden = false;
    if (successCloseTimer) {
      window.clearTimeout(successCloseTimer);
      successCloseTimer = null;
    }
    drawer.classList.remove('is-success');
    if (form instanceof HTMLFormElement) {
      form.hidden = false;
      form.reset();
    }
    if (status) status.textContent = '';
    if (startedAt) startedAt.value = String(Date.now());
    requestAnimationFrame(() => {
      backdrop.classList.add('is-open');
      drawer.classList.add('is-open');
      drawer.setAttribute('aria-hidden', 'false');
      document.body.classList.add('contact-drawer-open');
      drawer.querySelector('.contact-close')?.focus();
      ensureTurnstile();
    });
  };

  const closeDrawer = () => {
    if (!drawer || !backdrop) return;
    drawer.classList.remove('is-open');
    backdrop.classList.remove('is-open');
    drawer.setAttribute('aria-hidden', 'true');
    document.body.classList.remove('contact-drawer-open');
    window.setTimeout(() => {
      backdrop.hidden = true;
      drawer.classList.remove('is-success');
    }, 280);
    if (lastFocused instanceof HTMLElement) lastFocused.focus();
  };

  openButton?.addEventListener('click', openDrawer);
  closeButtons.forEach((button) => button.addEventListener('click', closeDrawer));
  backdrop?.addEventListener('click', closeDrawer);

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && drawer?.classList.contains('is-open')) closeDrawer();
  });

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!(form instanceof HTMLFormElement) || !(submitButton instanceof HTMLButtonElement)) return;

    status?.classList.remove('is-ok');
    if (status) status.textContent = '';

    if (!form.reportValidity()) return;

    const data = new FormData(form);
    const payload = Object.fromEntries(data.entries());

    if (!payload['cf-turnstile-response']) {
      if (status) status.textContent = 'Ολοκληρώστε την επαλήθευση ασφαλείας Cloudflare.';
      return;
    }

    submitButton.disabled = true;
    submitButton.textContent = 'ΑΠΟΣΤΟΛΗ...';

    try {
      const controller = new AbortController();
      const timeout = window.setTimeout(() => controller.abort(), 8000);
      const response = await fetch('/api/contact', {
        method: 'POST',
        headers: {'Content-Type':'application/json'},
        body: JSON.stringify(payload),
        signal: controller.signal,
      });
      window.clearTimeout(timeout);

      const result = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error(result?.message || 'Η αποστολή απέτυχε. Δοκιμάστε ξανά.');

      form.reset();
      if (turnstileWidgetId !== null) window.turnstile?.reset?.(turnstileWidgetId);

      drawer.classList.add('is-success');

      successCloseTimer = window.setTimeout(() => {
        closeDrawer();
        window.setTimeout(() => {
          drawer.classList.remove('is-success');
          form.hidden = false;
        }, 320);
      }, 2000);
    } catch (error) {
      if (status) {
        status.textContent = error instanceof Error ? error.message : 'Η αποστολή απέτυχε. Δοκιμάστε ξανά.';
      }
      if (turnstileWidgetId !== null) window.turnstile?.reset?.(turnstileWidgetId);
    } finally {
      submitButton.disabled = false;
      submitButton.innerHTML = 'ΑΠΟΣΤΟΛΗ ΜΗΝΥΜΑΤΟΣ <span>→</span>';
    }
  });
</script>
