<section class="maintenance-page" aria-labelledby="maintenance-title">
  <div class="grid" aria-hidden="true"></div>
  <div class="orb orb-a" aria-hidden="true"></div>
  <div class="orb orb-b" aria-hidden="true"></div>

  <div class="inner">
    <header>
      <a class="brand" href="/" aria-label="Panachaiko Trails – Αρχική">
        <img src="/logo-panachaiko.svg" alt="" width="60" height="60" />
        <span><strong>PANACHAIKO TRAILS</strong><small>EXPLORE THE MOUNTAIN</small></span>
      </a>
      <div class="live"><span></span> SITE UPDATE</div>
    </header>

    <div class="layout">
      <div class="copy">
        <p class="kicker"><i></i> ΠΡΟΣΩΡΙΝΗ ΕΝΗΜΕΡΩΣΗ</p>
        <h1 id="maintenance-title">Η ιστοσελίδα βρίσκεται <em>υπό κατασκευή.</em></h1>
        <p class="message">Χαρτογραφούμε το Παναχαϊκό και δημιουργούμε μια νέα εμπειρία για πεζοπόρους, ποδηλάτες και φίλους του βουνού.</p>

        <div class="progress">
          <span class="pulse"></span>
          <div><strong>Οι εργασίες βρίσκονται σε εξέλιξη</strong><small>Σύντομα θα είμαστε κοντά σας.</small></div>
        </div>

        <div class="actions">
          <a class="contact" href="mailto:info@panachaikotrails.gr">ΕΠΙΚΟΙΝΩΝΙΑ <span>↗</span></a>
          <a class="preview" href="/preview">ΙΔΙΩΤΙΚΗ ΠΡΟΕΠΙΣΚΟΠΗΣΗ</a>
        </div>
      </div>

      <div class="visual" aria-hidden="true">
        <div class="ring ring-one"></div><div class="ring ring-two"></div>
        <div class="node node-a"><span></span></div><div class="node node-b"><span></span></div><div class="node node-c"><span></span></div>
        <div class="mountain-card">
          <img src="/hero-panachaiko.svg" alt="" />
          <div class="core"><strong>38.20° N</strong><small>PANACHAIKO MOUNTAIN</small></div>
        </div>
      </div>
    </div>

    <footer><span>PANACHAIKO TRAILS</span><span>ΜΟΝΟΠΑΤΙΑ · ΦΥΣΗ · ΕΞΕΡΕΥΝΗΣΗ</span></footer>
  </div>
</section>

<style>
  :global(*){box-sizing:border-box}
  :global(html){min-width:320px;min-height:100%;background:#07130f}
  :global(body){margin:0;min-width:320px;min-height:100%;overflow-x:hidden;font-family:Arial,sans-serif;background:#07130f}
  .maintenance-page{--lime:#d5ef4a;--green:#0c2b20;position:relative;isolation:isolate;min-height:100svh;overflow:hidden;color:#fff;background:radial-gradient(circle at 78% 22%,rgba(119,192,133,.14),transparent 34%),linear-gradient(145deg,#102b21 0%,#081912 68%,#050e0b 100%)}
  .grid{position:absolute;inset:0;z-index:-3;opacity:.5;background-image:linear-gradient(rgba(255,255,255,.035) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.035) 1px,transparent 1px);background-size:52px 52px;mask-image:linear-gradient(110deg,#000,transparent 88%)}
  .orb{position:absolute;z-index:-2;border-radius:50%;pointer-events:none}.orb-a{width:520px;height:520px;right:-230px;top:-240px;border:1px solid rgba(203,235,152,.14);box-shadow:0 0 100px rgba(177,222,105,.06) inset}.orb-b{width:300px;height:300px;left:-170px;bottom:-160px;background:rgba(213,239,74,.07)}
  .inner{width:min(100%,1440px);min-height:100svh;margin:0 auto;padding:30px clamp(22px,5vw,76px) 24px;display:grid;grid-template-rows:auto 1fr auto}
  header,footer{display:flex;align-items:center;justify-content:space-between}.brand{display:flex;align-items:center;gap:14px;color:#fff;text-decoration:none}.brand img{width:58px;height:58px;filter:drop-shadow(0 10px 22px rgba(0,0,0,.25))}.brand span{display:grid;gap:4px}.brand strong{font-size:15px;letter-spacing:.07em}.brand small{color:#91aa9e;font-size:9px;letter-spacing:.19em}
  .live{display:flex;align-items:center;gap:10px;color:#a9bbb2;font-size:10px;font-weight:800;letter-spacing:.18em}.live span{width:7px;height:7px;border-radius:50%;background:var(--lime);box-shadow:0 0 0 5px rgba(213,239,74,.1),0 0 20px rgba(213,239,74,.45)}
  .layout{display:grid;grid-template-columns:minmax(0,.92fr) minmax(430px,1.08fr);align-items:center;gap:clamp(30px,5vw,90px);padding:54px 0}.copy{position:relative;z-index:2;max-width:650px}.kicker{display:flex;align-items:center;gap:12px;margin:0 0 23px;color:#a9bbb2;font-size:11px;font-weight:800;letter-spacing:.2em}.kicker i{display:block;width:28px;height:2px;background:var(--lime)}
  h1{max-width:690px;margin:0 0 25px;font-size:clamp(46px,6.1vw,92px);line-height:.98;font-weight:500;letter-spacing:-.055em}h1 em{color:var(--lime);font-style:normal}.message{max-width:610px;margin:0;color:#afc0b7;font-size:clamp(16px,1.4vw,19px);line-height:1.72}
  .progress{display:flex;align-items:center;gap:15px;margin-top:34px;padding:17px 19px;border-left:2px solid var(--lime);background:rgba(255,255,255,.035)}.progress>div{display:grid;gap:4px}.progress strong{font-size:13px}.progress small{color:#8fa49a;font-size:12px}.pulse{width:10px;height:10px;border-radius:50%;background:var(--lime);box-shadow:0 0 0 6px rgba(213,239,74,.1);animation:pulse 2s ease-in-out infinite}
  .actions{display:flex;flex-wrap:wrap;align-items:center;gap:22px;margin-top:28px}.contact{display:inline-flex;align-items:center;gap:18px;min-height:51px;padding:0 22px;background:var(--lime);border:1px solid var(--lime);color:#102219;font-size:11px;font-weight:900;letter-spacing:.11em;text-decoration:none;transition:.2s ease}.contact:hover{background:#e6fa78;transform:translateY(-2px)}.preview{color:#9fb2a9;font-size:9px;font-weight:800;letter-spacing:.14em;text-underline-offset:5px}.preview:hover{color:#fff}
  .visual{position:relative;min-height:min(52vw,620px);display:grid;place-items:center}.ring{position:absolute;border:1px solid rgba(194,230,164,.15);border-radius:50%}.ring-one{width:min(42vw,520px);height:min(42vw,520px)}.ring-two{width:min(31vw,380px);height:min(31vw,380px);border-style:dashed;animation:rotate 26s linear infinite}.mountain-card{position:relative;width:min(43vw,570px);height:min(31vw,410px);overflow:hidden;border:1px solid rgba(255,255,255,.15);background:#17382b;box-shadow:0 30px 80px rgba(0,0,0,.32);clip-path:polygon(7% 0,100% 0,100% 87%,93% 100%,0 100%,0 13%)}.mountain-card img{width:100%;height:100%;object-fit:cover;filter:saturate(.78) contrast(1.06) brightness(.7)}.mountain-card::after{content:'';position:absolute;inset:0;background:linear-gradient(180deg,transparent 40%,rgba(4,17,12,.82))}.core{position:absolute;z-index:2;left:25px;bottom:22px;display:grid;gap:4px}.core strong{font-size:18px;letter-spacing:.08em}.core small{color:#d4e1db;font-size:9px;letter-spacing:.17em}
  .node{position:absolute;width:14px;height:14px;border:1px solid var(--lime);border-radius:50%;background:#0c2118}.node span{position:absolute;inset:4px;border-radius:50%;background:var(--lime)}.node-a{top:16%;right:18%}.node-b{left:8%;bottom:25%}.node-c{right:7%;bottom:16%}.node::after{content:'';position:absolute;top:6px;width:65px;height:1px;background:linear-gradient(90deg,rgba(213,239,74,.6),transparent)}
  footer{padding-top:21px;border-top:1px solid rgba(255,255,255,.1);color:#718b7f;font-size:9px;font-weight:700;letter-spacing:.16em}
  @keyframes pulse{50%{box-shadow:0 0 0 10px rgba(213,239,74,0)}}@keyframes rotate{to{transform:rotate(360deg)}}
  @media(max-width:900px){.layout{grid-template-columns:1fr;padding-top:75px}.visual{min-height:510px}.mountain-card{width:min(78vw,570px);height:min(56vw,410px)}.ring-one{width:min(70vw,520px);height:min(70vw,520px)}.ring-two{width:min(52vw,380px);height:min(52vw,380px)}}
  @media(max-width:560px){.inner{padding:21px 18px}.brand img{width:47px;height:47px}.brand strong{font-size:12px}.brand small{font-size:7px}.live{display:none}.layout{padding:70px 0 34px;gap:24px}h1{font-size:clamp(45px,14vw,68px)}.message{font-size:16px}.actions{display:grid;gap:20px}.contact{justify-content:center;width:100%}.preview{text-align:center}.visual{min-height:360px}.mountain-card{width:92vw;height:68vw;max-height:360px}.ring-one{width:88vw;height:88vw}.ring-two{width:66vw;height:66vw}footer{align-items:flex-start;flex-direction:column;gap:11px}.node-a{right:4%}}
  @media(prefers-reduced-motion:reduce){.pulse,.ring-two{animation:none}}
</style>
