    font-size:clamp(54px,5.6vw,92px);
    line-height:.96;
    font-weight:400;
    letter-spacing:-.055em;
    text-wrap:balance;
  }
  h1 em{color:var(--lime);font-style:normal;font-weight:500}
  .message{
    max-width:610px;
    margin:0;
    color:#c2cec8;
    font-size:clamp(16px,1.2vw,19px);
    line-height:1.68;
  }

