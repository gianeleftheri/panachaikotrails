  .progress strong{font-size:13px}
  .progress small{color:#aebdb6;font-size:12px}
  .pulse{width:10px;height:10px;flex:0 0 auto;border-radius:50%;background:var(--lime);box-shadow:0 0 0 7px rgba(215,243,63,.1);animation:pulse 2s ease-in-out infinite}

  .actions{display:flex;flex-wrap:wrap;align-items:center;gap:34px;margin-top:29px}
  .contact{
    display:inline-flex;
    align-items:center;
    justify-content:space-between;
    gap:28px;
    min-width:184px;
    min-height:54px;
    padding:0 23px;
    border:1px solid var(--lime);
    background:var(--lime);
    color:#0d281d;
    font-size:11px;
    font-weight:900;
    letter-spacing:.12em;
    text-decoration:none;
    transition:transform .18s ease,background .18s ease;
  }
  .contact:hover{background:#e6fa78;transform:translateY(-2px)}
  .contact span{font-size:16px;line-height:1}
  .preview{color:#b7c5be;font-size:9px;font-weight:800;letter-spacing:.16em;text-underline-offset:6px}
  .preview:hover{color:#fff}

  footer{height:1px;border-top:1px solid rgba(255,255,255,.11)}

  @keyframes pulse{50%{box-shadow:0 0 0 11px rgba(215,243,63,0)}}

  @media(max-width:980px){
    .scene>img{
      width:min(145vw,2243px);
      right:-34vw;
      top:54%;
    }
    .scene-shade{background:linear-gradient(90deg,rgba(5,31,22,.98) 0%,rgba(5,31,22,.94) 48%,rgba(5,31,22,.68) 72%,rgba(5,31,22,.28) 100%),linear-gradient(180deg,rgba(3,18,13,.28),rgba(3,18,13,.22))}
    .copy{width:min(100%,620px)}
    .ring-one{right:-18vw;top:14vh}
    .ring-two{right:-5vw;top:22vh}
    .node-a,.node-b{display:none}
  }

  @media(max-width:620px){
    .maintenance-page{overflow:auto}
    .inner{padding:20px 18px 22px}
    .brand img{width:160px}
    .live{display:none}
    .layout{align-items:flex-start;padding:clamp(48px,9vh,78px) 0 54px}
    .scene>img{
      top:auto;
      right:-150vw;
      bottom:-2vh;
      width:min(315vw,2243px);
      height:auto;
      transform:none;
      object-fit:contain;
      object-position:right bottom;
      filter:saturate(.94) contrast(1.02) brightness(.66);
    }
    .scene-shade{
      background:
        linear-gradient(180deg,rgba(4,31,22,.72) 0%,rgba(4,31,22,.58) 31%,rgba(4,31,22,.83) 74%,rgba(4,24,18,.96) 100%),
        linear-gradient(90deg,rgba(5,34,24,.96) 0%,rgba(5,34,24,.82) 62%,rgba(5,34,24,.42) 100%);
    }
    .grid{opacity:.2;mask-image:linear-gradient(180deg,#000,transparent 86%)}
    .ring-one{width:96vw;height:96vw;right:-46vw;top:25vh}
    .ring-two{width:70vw;height:70vw;right:-24vw;top:31vh}
    .kicker{margin-bottom:22px;font-size:9px}
    h1{font-size:clamp(47px,14vw,67px);line-height:.98;margin-bottom:24px}
    .message{font-size:15px;line-height:1.62}
    .progress{margin-top:29px;padding:15px 15px}
    .progress strong{font-size:12px}
    .progress small{font-size:11px}
    .actions{display:grid;gap:22px;margin-top:25px}
    .contact{width:100%;min-height:52px}
    .preview{text-align:center}
  }

  @media(max-height:760px) and (min-width:621px){
    .brand img{width:180px}
    .layout{padding:30px 0 38px}
    h1{font-size:clamp(50px,5vw,74px);margin-bottom:20px}
    .kicker{margin-bottom:18px}
    .message{font-size:16px;line-height:1.55}
    .progress{margin-top:24px}
    .actions{margin-top:22px}
  }

  @media(prefers-reduced-motion:reduce){.pulse{animation:none}}
</style>
