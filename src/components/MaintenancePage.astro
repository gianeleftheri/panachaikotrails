<section class="maintenance-page" aria-labelledby="maintenance-title">
  <div class="scene" aria-hidden="true">
    <img src="/dashboard-hero.webp" alt="" />
    <div class="scene-shade"></div>
    <div class="grid"></div>
    <div class="ring ring-one"></div>
    <div class="ring ring-two"></div>
    <div class="node node-a"><span></span></div>
    <div class="node node-b"><span></span></div>
  </div>

  <div class="inner">
    <header>
      <a class="brand" href="/" aria-label="Panachaiko Trails – Αρχική">
        <img src="/logo-panachaiko.svg" alt="Panachaiko Trails" width="256" height="140" />
      </a>
      <div class="live"><span></span> SITE UPDATE</div>
    </header>

    <main class="layout">
      <div class="copy">
        <p class="kicker"><i></i> ΠΡΟΣΩΡΙΝΗ ΕΝΗΜΕΡΩΣΗ</p>
        <h1 id="maintenance-title">Η ιστοσελίδα<br />βρίσκεται <em>υπό<br />κατασκευή.</em></h1>
        <p class="message">Χαρτογραφούμε το Παναχαϊκό και δημιουργούμε μια νέα εμπειρία για πεζοπόρους, ποδηλάτες και φίλους του βουνού.</p>

        <div class="progress">
          <span class="pulse"></span>
          <div>
            <strong>Οι εργασίες βρίσκονται σε εξέλιξη</strong>
            <small>Σύντομα θα είμαστε κοντά σας.</small>
          </div>
        </div>

        <div class="actions">
          <a class="contact" href="mailto:info@panachaikotrails.gr">ΕΠΙΚΟΙΝΩΝΙΑ <span>→</span></a>
          <a class="preview" href="/preview">ΙΔΙΩΤΙΚΗ ΠΡΟΕΠΙΣΚΟΠΗΣΗ</a>
        </div>
      </div>
    </main>

    <footer aria-hidden="true"></footer>
  </div>
</section>

<style>
  :global(*){box-sizing:border-box}
  :global(html){min-width:320px;min-height:100%;background:#061b14}
  :global(body){margin:0;min-width:320px;min-height:100%;overflow-x:hidden;font-family:Arial,Helvetica,sans-serif;background:#061b14}

  .maintenance-page{
    --lime:#d7f33f;
    position:relative;
    isolation:isolate;
    min-height:100svh;
    overflow:hidden;
    color:#fff;
    background:#061b14;
  }

  .scene{position:absolute;inset:0;z-index:-2;overflow:hidden;background:#061b14}
  .scene>img{
    position:absolute;
    top:50%;
    right:0;
    left:auto;
    width:min(112vw,2243px);
    height:auto;
    max-width:none;
    object-fit:contain;
    object-position:right center;
    image-rendering:auto;
    filter:saturate(.98) contrast(1.03) brightness(.78);
    transform:translateY(-50%);
    transform-origin:right center;
  }
  .scene-shade{
    position:absolute;
    inset:0;
    background:
      linear-gradient(90deg,#062319 0%,rgba(6,35,25,.98) 25%,rgba(6,35,25,.92) 42%,rgba(6,35,25,.63) 56%,rgba(6,35,25,.18) 74%,rgba(6,24,19,.04) 100%),
      linear-gradient(180deg,rgba(3,18,13,.38) 0%,transparent 28%,transparent 68%,rgba(3,17,12,.5) 100%);
  }
  .grid{
    position:absolute;
    inset:0;
    opacity:.28;
    background-image:linear-gradient(rgba(255,255,255,.035) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.035) 1px,transparent 1px);
    background-size:52px 52px;
    mask-image:linear-gradient(90deg,#000 0%,#000 38%,transparent 72%);
  }

  .ring{position:absolute;border:1px solid rgba(210,239,74,.18);border-radius:50%;pointer-events:none}
  .ring-one{width:min(48vw,760px);height:min(48vw,760px);right:1vw;top:7vh}
  .ring-two{width:min(35vw,540px);height:min(35vw,540px);right:8vw;top:16vh;border-style:dashed;opacity:.45}
  .node{position:absolute;width:17px;height:17px;border:1px solid var(--lime);border-radius:50%;background:rgba(5,31,22,.72)}
  .node span{position:absolute;inset:5px;border-radius:50%;background:var(--lime)}
  .node::after{content:"";position:absolute;top:7px;width:76px;height:1px;background:linear-gradient(90deg,rgba(215,243,63,.65),transparent)}
  .node-a{right:7.5vw;top:24vh}
  .node-b{right:2vw;bottom:15vh}

  .inner{
    width:min(100%,1540px);
    min-height:100svh;
    margin:0 auto;
    padding:clamp(24px,3.4vh,42px) clamp(24px,6.2vw,100px) clamp(20px,2.8vh,34px);
    display:grid;
    grid-template-rows:auto 1fr auto;
  }

  header{display:flex;align-items:flex-start;justify-content:space-between;gap:28px}
  .brand{display:inline-flex;align-items:flex-start;text-decoration:none}
  .brand img{
    display:block;
    width:clamp(185px,13vw,250px);
    height:auto;
    filter:drop-shadow(0 12px 28px rgba(0,0,0,.28));
  }
  .live{display:flex;align-items:center;gap:11px;margin-top:10px;color:#c0ccc6;font-size:10px;font-weight:800;letter-spacing:.2em;white-space:nowrap}
  .live span{width:8px;height:8px;border-radius:50%;background:var(--lime);box-shadow:0 0 0 6px rgba(215,243,63,.1),0 0 20px rgba(215,243,63,.42)}

  .layout{display:flex;align-items:center;padding:clamp(38px,6vh,84px) 0 clamp(46px,7vh,90px)}
  .copy{position:relative;z-index:2;width:min(100%,650px)}
