<style>
  :global(#map3d){position:relative!important;display:block!important;min-height:0;background:#091c2d!important;overflow:hidden}
  :global(#map3d .maplibregl-canvas){outline:none}
  :global(#map3d .maplibregl-ctrl-group){background:rgba(16,43,67,.92);border:1px solid rgba(117,161,191,.35);box-shadow:0 5px 20px rgba(0,0,0,.35)}
  :global(#map3d .maplibregl-ctrl-group button){filter:invert(1) sepia(.15)}
  :global(#map3d .maplibregl-ctrl-attrib){background:rgba(16,43,67,.82);color:#b7cddd}
  :global(#map3d .maplibregl-ctrl-attrib a){color:#f2f8fc}
  :global(.terrain-v3-gps){width:18px;height:18px;border-radius:50%;background:#3b82f6;border:3px solid #fff;box-shadow:0 0 0 8px rgba(59,130,246,.22),0 3px 12px rgba(0,0,0,.65)}
  :global(.terrain-v3-endpoint){display:grid;place-items:center;width:28px;height:28px;border-radius:50%;border:3px solid #fff;color:#fff;font:700 11px/1 Arial,sans-serif;box-shadow:0 4px 14px rgba(0,0,0,.6)}
  :global(.terrain-v3-start){background:#22c55e}:global(.terrain-v3-end){background:#ef4444}
</style>

<script>
  let terrainModulePromise: Promise<typeof import('../scripts/maplibre-terrain-v3')> | null = null;

  const openLazy3d = async () => {
    terrainModulePromise ??= import('../scripts/maplibre-terrain-v3');
    const terrain = await terrainModulePromise;
    terrain.open3d();
  };

  document.getElementById('view3dBtn')?.addEventListener('click', () => { void openLazy3d(); });
  document.getElementById('nav3dBtn')?.addEventListener('click', () => { void openLazy3d(); });
</script>
