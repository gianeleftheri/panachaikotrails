<section class="nav-hud" id="navigationHud" aria-live="polite" aria-label="Ζωντανή πεζοπορική πλοήγηση">
  <div class="nav-hud-head">
    <button class="nav-back" id="navBackBtn" type="button" aria-label="Επιστροφή στην επιλογή διαδρομής">←</button>
    <div class="nav-title-wrap">
      <div class="nav-kicker"><span id="navPhase">ΠΡΟΣΕΓΓΙΣΗ</span> · LIVE GPS</div>
      <div class="nav-title" id="navTitle">—</div>
    </div>
    <div class="nav-view-switch" aria-label="Προβολή χάρτη">
      <button class="active" id="nav2dBtn" type="button">2D</button>
      <button id="nav3dBtn" type="button">3D</button>
    </div>
  </div>

  <div class="nav-guidance" id="navGuidance">Περιμένω νέο στίγμα GPS…</div>

  <div class="nav-leg-grid" aria-label="Στάδια πλοήγησης">
    <div class="nav-leg active" id="navApproachLeg">
      <span class="nav-leg-title">1 · GPS → Αφετηρία Α</span>
      <strong id="navApproachRemaining">—</strong>
      <small id="navApproachState">Προσέγγιση στο μονοπάτι</small>
    </div>
    <div class="nav-leg" id="navTrailLeg">
      <span class="nav-leg-title">2 · Αφετηρία Α → Τέλος Τ</span>
      <strong id="navTrailRemaining">—</strong>
      <small id="navTrailState">Ξεκινά όταν φτάσεις στην Α</small>
    </div>
  </div>

  <div class="nav-stats">
    <div><span class="nav-stat-value" id="navRemaining">—</span><span class="nav-stat-label">Συνολικά απομένουν</span></div>
    <div><span class="nav-stat-value" id="navEta">—</span><span class="nav-stat-label">Χρόνος</span></div>
    <div><span class="nav-stat-value" id="navOffRoute">—</span><span class="nav-stat-label">Από πορεία</span></div>
    <div><span class="nav-stat-value" id="navSpeed">—</span><span class="nav-stat-label">Ταχύτητα</span></div>
  </div>

  <div class="nav-substats"><span id="navAccuracy">GPS —</span><span id="navProgressText">0% διαδρομής</span><span id="navSoundState">🔊 Ειδοποιήσεις</span></div>
  <div class="nav-progress-track" aria-hidden="true"><div class="nav-progress" id="navProgress"></div></div>

  <div class="nav-actions">
    <button class="nav-follow active" id="navFollowBtn" type="button">◎ Ακολούθηση θέσης</button>
    <button class="nav-sound active" id="navSoundBtn" type="button">🔊 Ήχος ON</button>
    <button class="nav-finish" id="navFinishBtn" type="button">Τερματισμός</button>
  </div>
</section>

<style>
  .nav-hud{display:none;position:fixed;left:50%;bottom:22px;z-index:2200;transform:translateX(-50%);width:min(720px,calc(100vw - 28px));background:rgba(18,32,26,.96);border:1px solid var(--brass-solid);border-radius:12px;box-shadow:0 14px 46px rgba(0,0,0,.6);backdrop-filter:blur(16px);padding:12px 14px;color:var(--parchment)}
  .nav-hud.open{display:block}.nav-hud.off-route{border-color:#d9a441;box-shadow:0 0 0 2px rgba(217,164,65,.13),0 14px 46px rgba(0,0,0,.6)}.nav-hud.arrived{border-color:var(--moss)}
  .nav-hud-head{display:flex;align-items:center;gap:10px}.nav-back{width:36px;height:36px;border-radius:50%;border:1px solid var(--brass);background:rgba(255,255,255,.04);color:var(--parchment);cursor:pointer;font-size:20px}.nav-title-wrap{flex:1;min-width:0}.nav-kicker{font-size:9px;letter-spacing:.14em;color:var(--moss)}.nav-title{font:600 14px/1.25 var(--serif);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-top:2px}
  .nav-view-switch{display:flex;padding:2px;border:1px solid var(--brass);border-radius:16px}.nav-view-switch button{border:0;background:none;color:var(--parchment-dim);border-radius:13px;padding:5px 9px;font-size:10.5px;cursor:pointer}.nav-view-switch button.active{background:var(--rust);color:#fff}
  .nav-guidance{margin:11px 0 9px;padding:10px 12px;border-radius:7px;background:rgba(255,255,255,.04);font-size:13px;line-height:1.4}.nav-hud.off-route .nav-guidance{background:rgba(217,164,65,.12);color:#f0c976;font-weight:600}.nav-hud.arrived .nav-guidance{background:rgba(132,160,110,.15);color:#b8d49e}
  .nav-leg-grid{display:grid;grid-template-columns:1fr 1fr;gap:7px;margin-bottom:8px}.nav-leg{display:grid;grid-template-columns:1fr auto;gap:2px 9px;align-items:center;padding:8px 10px;border:1px solid rgba(156,145,124,.35);border-radius:7px;background:rgba(255,255,255,.018);opacity:.65}.nav-leg.active{opacity:1;border-color:var(--rust);background:rgba(207,90,52,.1)}.nav-leg.done{opacity:.82;border-color:var(--moss);background:rgba(132,160,110,.1)}.nav-leg-title{font-size:9px;letter-spacing:.05em;text-transform:uppercase;color:var(--parchment-faint)}.nav-leg strong{grid-row:1/3;grid-column:2;font:600 15px var(--serif);color:var(--parchment)}.nav-leg small{font-size:9.5px;color:var(--parchment-dim)}
  .nav-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:7px}.nav-stats>div{border:1px solid var(--brass);padding:8px 9px;border-radius:6px;background:rgba(255,255,255,.02)}.nav-stat-value{display:block;font:600 15px var(--serif)}.nav-stat-label{display:block;margin-top:2px;font-size:9px;text-transform:uppercase;letter-spacing:.06em;color:var(--parchment-faint)}
  .nav-substats{display:flex;justify-content:space-between;gap:8px;margin-top:8px;color:var(--parchment-faint);font-size:9.5px}.nav-progress-track{height:5px;background:rgba(255,255,255,.08);border-radius:4px;margin:7px 0 9px;overflow:hidden}.nav-progress{height:100%;width:0;background:var(--moss);transition:width .35s ease}
  .nav-actions{display:grid;grid-template-columns:1.2fr .9fr .9fr;gap:7px}.nav-actions button{border-radius:6px;padding:8px 9px;cursor:pointer;font-size:11px}.nav-follow,.nav-sound{border:1px solid var(--brass);background:rgba(255,255,255,.035);color:var(--parchment-dim)}.nav-follow.active,.nav-sound.active{border-color:var(--moss);color:var(--moss)}.nav-finish{border:1px solid rgba(207,90,52,.55);background:var(--rust-dim);color:#f0b09c}
  :global(.nav-route-waypoint){display:grid;place-items:center;width:30px;height:30px;border-radius:50%;border:3px solid #fff;color:#fff;font:700 12px/1 Arial,sans-serif;box-shadow:0 3px 13px rgba(0,0,0,.65)}:global(.nav-route-start){background:#22c55e}:global(.nav-route-end){background:#ef4444}
  body.navigation-active .topbar-actions{opacity:.28;pointer-events:none}body.navigation-active #trailPanel,body.navigation-active #routeBuilderPanel,body.navigation-active #trailDrawer,body.navigation-active #shelterPanel,body.navigation-active #contentPanelOverlay{display:none!important}body.navigation-active #distanceBadge{display:none!important}
  @media(max-width:760px){.nav-hud{bottom:max(8px,env(safe-area-inset-bottom));width:calc(100vw - 16px);padding:9px}.nav-title{font-size:12px}.nav-leg-grid{grid-template-columns:1fr}.nav-stats{grid-template-columns:repeat(2,1fr);gap:5px}.nav-stat-value{font-size:13px}.nav-guidance{font-size:12px;margin:8px 0}.nav-actions{grid-template-columns:1fr 1fr}.nav-finish{grid-column:1/-1}.nav-actions button{min-height:40px}.nav-substats{font-size:9px;flex-wrap:wrap}}
</style>

<script>
  import L from 'leaflet';

  type RoutePoint = [number, number];
  type NavigationPlan = {
    code: string;
    name: string;
    mode: string;
    points: RoutePoint[];
    approachPointCount: number;
    totalDistanceM: number;
    approachDistanceM: number;
    trailDistanceM: number;
    estimatedSeconds: number;
  };

  type Runtime = typeof window & {
    __panachaikoMap?: L.Map;
    __panachaikoFullRouteLayer?: L.LayerGroup;
    __panachaikoNavigationPlan?: NavigationPlan;
  };

  const runtime = window as Runtime;
  const hud = document.getElementById('navigationHud');
  const title = document.getElementById('navTitle');
  const phaseEl = document.getElementById('navPhase');
  const guidance = document.getElementById('navGuidance');
  const remainingEl = document.getElementById('navRemaining');
  const etaEl = document.getElementById('navEta');
  const offRouteEl = document.getElementById('navOffRoute');
  const speedEl = document.getElementById('navSpeed');
  const accuracyEl = document.getElementById('navAccuracy');
  const progressTextEl = document.getElementById('navProgressText');
  const soundStateEl = document.getElementById('navSoundState');
  const progressEl = document.getElementById('navProgress') as HTMLElement | null;
  const followBtn = document.getElementById('navFollowBtn') as HTMLButtonElement | null;
  const soundBtn = document.getElementById('navSoundBtn') as HTMLButtonElement | null;
  const backBtn = document.getElementById('navBackBtn');
  const finishBtn = document.getElementById('navFinishBtn');
  const btn2d = document.getElementById('nav2dBtn');
  const btn3d = document.getElementById('nav3dBtn');
  const approachLeg = document.getElementById('navApproachLeg');
  const trailLeg = document.getElementById('navTrailLeg');
  const approachRemainingEl = document.getElementById('navApproachRemaining');
  const trailRemainingEl = document.getElementById('navTrailRemaining');
  const approachStateEl = document.getElementById('navApproachState');
  const trailStateEl = document.getElementById('navTrailState');

  let plan: NavigationPlan | null = null;
  let watchId: number | null = null;
  let follow = true;
  let soundEnabled = true;
  let remainingFromIndex: number[] = [];
  let approachPoints: RoutePoint[] = [];
  let trailPoints: RoutePoint[] = [];
  let approachRemainingFromIndex: number[] = [];
  let trailRemainingFromIndex: number[] = [];
  let trailStarted = false;
  let offRouteStreak = 0;
  let lastAlertAt = 0;
  let lastTrailEntryAlert = false;
  let lastPosition: { point: RoutePoint; time: number } | null = null;
  let audioContext: AudioContext | null = null;
  let hiddenMapGroups: L.LayerGroup[] = [];
  const lockedControlState = new Map<HTMLButtonElement, boolean>();

  const haversine = (a: RoutePoint, b: RoutePoint) => {
    const R = 6371000;
    const rad = (v: number) => v * Math.PI / 180;
    const dLat = rad(b[0] - a[0]);
    const dLng = rad(b[1] - a[1]);
    const x = Math.sin(dLat / 2) ** 2 + Math.cos(rad(a[0])) * Math.cos(rad(b[0])) * Math.sin(dLng / 2) ** 2;
    return 2 * R * Math.asin(Math.sqrt(x));
  };

  const buildRemaining = (points: RoutePoint[]) => {
    const result = new Array(points.length).fill(0);
    for (let i = points.length - 2; i >= 0; i -= 1) result[i] = result[i + 1] + haversine(points[i], points[i + 1]);
    return result;
  };

  const nearestIndex = (points: RoutePoint[], current: RoutePoint) => {
    let bestIndex = 0;
    let bestDistance = Number.POSITIVE_INFINITY;
    points.forEach((point, index) => {
      const distance = haversine(current, point);
      if (distance < bestDistance) { bestDistance = distance; bestIndex = index; }
    });
    return { index: bestIndex, distance: bestDistance };
  };

  const formatDistance = (meters: number) => meters < 1000 ? `${Math.round(meters)} μ` : `${(meters / 1000).toFixed(meters < 10000 ? 2 : 1)} χλμ`;
  const formatTime = (seconds: number) => {
    const minutes = Math.max(1, Math.round(seconds / 60));
    if (minutes < 60) return `${minutes}′`;
    const hours = Math.floor(minutes / 60);
    const rest = minutes % 60;
    return rest ? `${hours}ω ${rest}′` : `${hours}ω`;
  };

  const bearingArrow = (from: RoutePoint, to: RoutePoint) => {
    const rad = (v: number) => v * Math.PI / 180;
    const deg = (v: number) => v * 180 / Math.PI;
    const y = Math.sin(rad(to[1] - from[1])) * Math.cos(rad(to[0]));
    const x = Math.cos(rad(from[0])) * Math.sin(rad(to[0])) - Math.sin(rad(from[0])) * Math.cos(rad(to[0])) * Math.cos(rad(to[1] - from[1]));
    const angle = (deg(Math.atan2(y, x)) + 360) % 360;
    const arrows = ['↑','↗','→','↘','↓','↙','←','↖'];
    return arrows[Math.round(angle / 45) % 8];
  };

  const ensureAudio = () => {
    if (!soundEnabled) return;
    if (!audioContext) {
      const Context = window.AudioContext || (window as typeof window & { webkitAudioContext?: typeof AudioContext }).webkitAudioContext;
      if (Context) audioContext = new Context();
    }
    if (audioContext?.state === 'suspended') void audioContext.resume();
  };

  const beep = (urgent = false) => {
    if (!soundEnabled) return;
    ensureAudio();
    if (!audioContext) return;
    const now = audioContext.currentTime;
    const tones = urgent ? [880, 660, 880] : [660, 820];
    tones.forEach((frequency, index) => {
      const oscillator = audioContext!.createOscillator();
      const gain = audioContext!.createGain();
      oscillator.frequency.value = frequency;
      oscillator.type = 'sine';
      gain.gain.setValueAtTime(0.0001, now + index * .18);
      gain.gain.exponentialRampToValueAtTime(.18, now + index * .18 + .02);
      gain.gain.exponentialRampToValueAtTime(.0001, now + index * .18 + .14);
      oscillator.connect(gain).connect(audioContext!.destination);
      oscillator.start(now + index * .18);
      oscillator.stop(now + index * .18 + .16);
    });
  };

  const speak = (text: string) => {
    if (!soundEnabled || !('speechSynthesis' in window)) return;
    window.speechSynthesis.cancel();
    const utterance = new SpeechSynthesisUtterance(text);
    utterance.lang = 'el-GR';
    utterance.rate = .95;
    window.speechSynthesis.speak(utterance);
  };

  const alertOffRoute = (distance: number) => {
    const now = Date.now();
    if (!soundEnabled || now - lastAlertAt < 18000) return;
    lastAlertAt = now;
    beep(true);
    if ('vibrate' in navigator) navigator.vibrate?.([250, 120, 250]);
    speak(`Προσοχή. Απομακρύνεσαι από τη διαδρομή. Είσαι περίπου ${Math.round(distance)} μέτρα εκτός πορείας.`);
  };

  const setNavigationUi = (active: boolean) => {
    hud?.classList.toggle('open', active);
    document.body.classList.toggle('navigation-active', active);
  };

  const lockOtherControls = (active: boolean) => {
    const ids = ['trailMenuToggle','routeBuilderToggle','locateBtn','recenterBtn','shelterBtn','view3dBtn'];
    ids.forEach(id => {
      const button = document.getElementById(id) as HTMLButtonElement | null;
      if (!button) return;
      if (active) {
        if (!lockedControlState.has(button)) lockedControlState.set(button, button.disabled);
        button.disabled = true;
        button.setAttribute('aria-disabled','true');
      } else {
        button.disabled = lockedControlState.get(button) ?? false;
        button.removeAttribute('aria-disabled');
        lockedControlState.delete(button);
      }
    });
  };

  const closeNonNavigationUi = () => {
    document.getElementById('trailPanel')?.classList.remove('open');
    document.getElementById('trailMenuToggle')?.classList.remove('open');
    document.getElementById('routeBuilderPanel')?.classList.remove('open');
    document.getElementById('routeBuilderToggle')?.classList.remove('open');
    document.getElementById('trailDrawer')?.classList.remove('open');
    document.getElementById('trailDrawerHandle')?.classList.remove('open');
    document.getElementById('shelterPanel')?.classList.remove('show');
    document.getElementById('contentPanelOverlay')?.classList.remove('open');
  };

  const waypointIcon = (label: 'Α' | 'Τ', start: boolean) => L.divIcon({
    className: '',
    html: `<div class="nav-route-waypoint ${start ? 'nav-route-start' : 'nav-route-end'}">${label}</div>`,
    iconSize: [30,30],
    iconAnchor: [15,15]
  });

  const addRouteWaypoints = (detail: NavigationPlan) => {
    const group = runtime.__panachaikoFullRouteLayer;
    if (!group || !detail.points.length) return;
    const splitIndex = Math.max(0, Math.min(detail.points.length - 1, detail.approachPointCount - 1));
    const start = detail.points[splitIndex];
    const end = detail.points.at(-1)!;
    L.marker(start,{icon:waypointIcon('Α',true),interactive:false}).bindTooltip('Αφετηρία μονοπατιού',{direction:'top'}).addTo(group);
    L.marker(end,{icon:waypointIcon('Τ',false),interactive:false}).bindTooltip('Τέλος μονοπατιού',{direction:'top'}).addTo(group);
  };

  const enterFocusedMap = (detail: NavigationPlan) => {
    closeNonNavigationUi();
    lockOtherControls(true);
    addRouteWaypoints(detail);
    const map = runtime.__panachaikoMap;
    if (!map) return;
    const routeGroup = runtime.__panachaikoFullRouteLayer;
    const routeChildren = new Set<L.Layer>();
    routeGroup?.eachLayer(layer => routeChildren.add(layer));
    hiddenMapGroups = [];
    map.eachLayer(layer => {
      if (layer === routeGroup || routeChildren.has(layer)) return;
      if (layer instanceof L.LayerGroup) hiddenMapGroups.push(layer);
    });
    hiddenMapGroups.forEach(group => { if (map.hasLayer(group)) map.removeLayer(group); });
    const standalone: L.Layer[] = [];
    map.eachLayer(layer => {
      if (layer === routeGroup || routeChildren.has(layer) || layer instanceof L.TileLayer || layer instanceof L.LayerGroup) return;
      if (layer instanceof L.Polyline) standalone.push(layer);
    });
    standalone.forEach(layer => map.removeLayer(layer));
  };

  const leaveFocusedMap = () => {
    const map = runtime.__panachaikoMap;
    document.getElementById('view3dOverlay')?.classList.remove('open');
    if (map) {
      const routeGroup = runtime.__panachaikoFullRouteLayer;
      if (routeGroup && map.hasLayer(routeGroup)) map.removeLayer(routeGroup);
      hiddenMapGroups.forEach(group => { if (!map.hasLayer(group)) group.addTo(map); });
    }
    hiddenMapGroups = [];
    runtime.__panachaikoFullRouteLayer = undefined;
    lockOtherControls(false);
  };

  const updateLegUi = (approachRemaining: number, trailRemaining: number, arrived: boolean) => {
    if (approachRemainingEl) approachRemainingEl.textContent = formatDistance(Math.max(0, approachRemaining));
    if (trailRemainingEl) trailRemainingEl.textContent = formatDistance(Math.max(0, trailRemaining));
    approachLeg?.classList.toggle('active', !trailStarted && !arrived);
    approachLeg?.classList.toggle('done', trailStarted || arrived);
    trailLeg?.classList.toggle('active', trailStarted && !arrived);
    trailLeg?.classList.toggle('done', arrived);
    if (approachStateEl) approachStateEl.textContent = trailStarted || arrived ? '✓ Ολοκληρώθηκε η προσέγγιση' : 'Μέχρι την επίσημη αφετηρία Α';
    if (trailStateEl) trailStateEl.textContent = arrived ? '✓ Έφτασες στο τέλος Τ' : trailStarted ? 'Ενεργό τμήμα Α → Τ' : 'Ξεκινά όταν φτάσεις στην Α';
  };

  const updatePosition = (position: GeolocationPosition) => {
    if (!plan || !plan.points.length) return;
    const current: RoutePoint = [position.coords.latitude, position.coords.longitude];
    const threshold = Math.max(35, Math.min(90, Math.max(position.coords.accuracy * 1.5, 35)));
    const entryThreshold = Math.max(30, Math.min(75, Math.max(position.coords.accuracy * 1.35, 30)));
    const approachNearest = nearestIndex(approachPoints, current);
    const trailNearest = nearestIndex(trailPoints, current);
    const trailStartDistance = trailPoints.length ? haversine(current, trailPoints[0]) : Number.POSITIVE_INFINITY;
    if (!trailStarted && trailStartDistance <= entryThreshold) trailStarted = true;

    const approachRemaining = trailStarted ? 0 : approachNearest.distance + (approachRemainingFromIndex[approachNearest.index] ?? 0);
    const trailRemaining = trailStarted ? trailNearest.distance + (trailRemainingFromIndex[trailNearest.index] ?? 0) : plan.trailDistanceM;
    const remaining = approachRemaining + trailRemaining;
    const activeNearest = trailStarted ? trailNearest : approachNearest;
    const activePoints = trailStarted ? trailPoints : approachPoints;
    const total = Math.max(plan.totalDistanceM, 1);
    const progress = Math.max(0, Math.min(1, 1 - remaining / total));
    const etaSeconds = Math.max(0, plan.estimatedSeconds * (remaining / total));
    const arrived = trailStarted && trailRemaining <= Math.max(25, Math.min(60, position.coords.accuracy));
    const rawOffRoute = !arrived && activeNearest.distance > threshold;
    offRouteStreak = rawOffRoute ? offRouteStreak + 1 : 0;
    const offRoute = offRouteStreak >= 2;

    hud?.classList.toggle('off-route', offRoute);
    hud?.classList.toggle('arrived', arrived);
    if (remainingEl) remainingEl.textContent = formatDistance(Math.max(0, remaining));
    if (etaEl) etaEl.textContent = arrived ? '0′' : formatTime(etaSeconds);
    if (offRouteEl) offRouteEl.textContent = arrived ? 'Τέλος' : activeNearest.distance < 20 ? 'Εντός' : formatDistance(activeNearest.distance);
    if (progressEl) progressEl.style.width = `${Math.round(progress * 100)}%`;
    if (progressTextEl) progressTextEl.textContent = `${Math.round(progress * 100)}% διαδρομής`;
    if (accuracyEl) accuracyEl.textContent = `GPS ±${Math.round(position.coords.accuracy)} μ`;
    if (phaseEl) phaseEl.textContent = arrived ? 'ΟΛΟΚΛΗΡΩΣΗ' : trailStarted ? 'ΣΤΟ ΜΟΝΟΠΑΤΙ' : 'ΠΡΟΣΕΓΓΙΣΗ';
    updateLegUi(approachRemaining, trailRemaining, arrived);

    let speedKmh: number | null = typeof position.coords.speed === 'number' && position.coords.speed >= 0 ? position.coords.speed * 3.6 : null;
    if (speedKmh === null && lastPosition) {
      const dt = (position.timestamp - lastPosition.time) / 1000;
      if (dt > 2 && dt < 30) speedKmh = haversine(lastPosition.point, current) / dt * 3.6;
    }
    lastPosition = { point: current, time: position.timestamp };
    if (speedEl) speedEl.textContent = speedKmh !== null && speedKmh < 30 ? `${speedKmh.toFixed(1)} km/h` : '—';

    const target = activePoints[activeNearest.index] ?? plan.points.at(-1)!;
    if (guidance) {
      if (arrived) guidance.textContent = `✓ Έφτασες στο τέλος Τ του ${plan.code}. Η πεζοπορία ολοκληρώθηκε.`;
      else if (offRoute) guidance.textContent = `${bearingArrow(current, target)} ΕΚΤΟΣ ΠΟΡΕΙΑΣ · ${formatDistance(activeNearest.distance)} μέχρι το κοντινότερο σημείο. Γύρισε προς το βέλος.`;
      else if (!trailStarted) guidance.textContent = `🥾 Στάδιο 1/2 · Πήγαινε στην επίσημη αφετηρία Α του ${plan.code} ακολουθώντας τη μπλε πορεία.`;
      else guidance.textContent = `🌲 Στάδιο 2/2 · Αφετηρία Α ολοκληρώθηκε. Συνέχισε πάνω στο ${plan.code} μέχρι το τέλος Τ.`;
    }

    if (offRoute) alertOffRoute(activeNearest.distance);
    if (trailStarted && !lastTrailEntryAlert) {
      lastTrailEntryAlert = true;
      beep(false);
      speak(`Έφτασες στην αφετηρία του μονοπατιού ${plan.code}. Ξεκινά το δεύτερο στάδιο μέχρι το τέλος του μονοπατιού.`);
    }
    if (arrived && soundEnabled && lastAlertAt !== -1) {
      lastAlertAt = -1;
      beep(false);
      speak(`Έφτασες στο τέλος του μονοπατιού ${plan.code}.`);
    }

    if (follow && runtime.__panachaikoMap) {
      const zoom = Math.max(runtime.__panachaikoMap.getZoom(), 16);
      runtime.__panachaikoMap.setView(current, zoom, { animate: true });
    }
  };

  const startWatch = () => {
    if (watchId !== null || !navigator.geolocation) return;
    watchId = navigator.geolocation.watchPosition(updatePosition, () => {
      if (guidance) guidance.textContent = '⚠️ Δεν υπάρχει νέο στίγμα GPS. Η κλειδωμένη διαδρομή παραμένει ενεργή.';
    }, { enableHighAccuracy: true, maximumAge: 2000, timeout: 20000 });
  };

  const stopWatch = () => {
    if (watchId !== null) navigator.geolocation.clearWatch(watchId);
    watchId = null;
  };

  const exitNavigation = (finish: boolean) => {
    stopWatch();
    if ('speechSynthesis' in window) window.speechSynthesis.cancel();
    setNavigationUi(false);
    leaveFocusedMap();
    follow = true;
    trailStarted = false;
    followBtn?.classList.add('active');
    runtime.__panachaikoNavigationPlan = undefined;
    plan = null;
    document.dispatchEvent(new CustomEvent('panachaiko:navigation-exit', { detail: { finish } }));
  };

  document.addEventListener('panachaiko:navigation-start', event => {
    const detail = (event as CustomEvent<NavigationPlan>).detail;
    if (!detail?.points?.length) return;
    ensureAudio();
    plan = detail;
    runtime.__panachaikoNavigationPlan = detail;
    remainingFromIndex = buildRemaining(plan.points);
    const split = Math.max(1, Math.min(plan.points.length, plan.approachPointCount));
    approachPoints = plan.points.slice(0, split);
    trailPoints = plan.points.slice(Math.max(0, split - 1));
    approachRemainingFromIndex = buildRemaining(approachPoints);
    trailRemainingFromIndex = buildRemaining(trailPoints);
    trailStarted = false;
    offRouteStreak = 0;
    lastAlertAt = 0;
    lastTrailEntryAlert = false;
    lastPosition = null;
    if (title) title.textContent = `${plan.code} — ${plan.name}`;
    if (remainingEl) remainingEl.textContent = formatDistance(plan.totalDistanceM);
    if (etaEl) etaEl.textContent = formatTime(plan.estimatedSeconds);
    if (offRouteEl) offRouteEl.textContent = '—';
    if (speedEl) speedEl.textContent = '—';
    if (accuracyEl) accuracyEl.textContent = 'GPS —';
    if (phaseEl) phaseEl.textContent = 'ΠΡΟΣΕΓΓΙΣΗ';
    if (progressEl) progressEl.style.width = '0%';
    if (progressTextEl) progressTextEl.textContent = '0% διαδρομής';
    updateLegUi(plan.approachDistanceM, plan.trailDistanceM, false);
    if (guidance) guidance.textContent = '🔒 Η διαδρομή κλειδώθηκε. Στάδιο 1/2: GPS → επίσημη αφετηρία Α. Μετά αρχίζει το μονοπάτι Α → Τ.';
    enterFocusedMap(detail);
    setNavigationUi(true);
    beep(false);
    startWatch();
  });

  followBtn?.addEventListener('click', () => {
    follow = !follow;
    followBtn.classList.toggle('active', follow);
    followBtn.textContent = follow ? '◎ Ακολούθηση θέσης' : '○ Ελεύθερος χάρτης';
  });

  soundBtn?.addEventListener('click', () => {
    soundEnabled = !soundEnabled;
    soundBtn.classList.toggle('active', soundEnabled);
    soundBtn.textContent = soundEnabled ? '🔊 Ήχος ON' : '🔇 Ήχος OFF';
    if (soundStateEl) soundStateEl.textContent = soundEnabled ? '🔊 Ειδοποιήσεις' : '🔇 Σίγαση';
    if (soundEnabled) { ensureAudio(); beep(false); }
    else if ('speechSynthesis' in window) window.speechSynthesis.cancel();
  });

  backBtn?.addEventListener('click', () => exitNavigation(false));
  finishBtn?.addEventListener('click', () => exitNavigation(true));

  btn2d?.addEventListener('click', () => {
    btn2d.classList.add('active');
    btn3d?.classList.remove('active');
    document.getElementById('view3dOverlay')?.classList.remove('open');
  });
  btn3d?.addEventListener('click', () => {
    btn3d.classList.add('active');
    btn2d?.classList.remove('active');
    document.getElementById('view3dOverlay')?.classList.add('open');
  });
</script>
