<section class="route-builder-panel" id="routeBuilderPanel" aria-label="Κατασκευή διαδρομής">
  <div class="rb-title">Κατασκευή διαδρομής</div>

  <div class="rb-step">
    <div class="rb-step-label"><span class="rb-step-num">1</span>Αφετηρία</div>
    <button class="rb-gps-btn" id="rbGpsBtn" type="button">📍 Χρήση της θέσης μου (GPS)</button>
    <div class="rb-status" id="rbGpsStatus"></div>
  </div>

  <div class="rb-step">
    <div class="rb-step-label"><span class="rb-step-num">2</span>Προορισμός — μονοπάτι</div>
    <select class="rb-select" id="rbTrailSelect">
      <option value="">— Διάλεξε μονοπάτι —</option>
    </select>
  </div>

  <div class="rb-step">
    <div class="rb-step-label"><span class="rb-step-num">3</span>Τρόπος υπολογισμού</div>
    <div class="rb-mode-grid" role="radiogroup" aria-label="Τρόπος υπολογισμού διαδρομής">
      <label class="rb-mode-option">
        <input type="radio" name="rbMode" value="straight" checked />
        <span><b>📏 Ευθεία</b><small>Από τη θέση σου στο κοντινότερο σημείο</small></span>
      </label>
      <label class="rb-mode-option">
        <input type="radio" name="rbMode" value="ors" />
        <span><b>🗺️ Πραγματική</b><small>Πεζοπορική δρομολόγηση προς το μονοπάτι</small></span>
      </label>
      <label class="rb-mode-option">
        <input type="radio" name="rbMode" value="ai" />
        <span><b>🤖 Έδαφος</b><small>Κατά προσέγγιση διαδρομή εδάφους</small></span>
      </label>
    </div>
  </div>

  <button class="rb-calc-btn" id="rbCalcBtn" type="button" disabled>Υπολογισμός διαδρομής</button>
  <div class="rb-status" id="rbResultStatus"></div>
</section>

<style>
  .route-builder-panel{z-index:1200!important;pointer-events:auto!important}
  .rb-mode-grid{display:grid;gap:7px}
  .rb-mode-option{position:relative;display:block;cursor:pointer}
  .rb-mode-option input{position:absolute;opacity:0;pointer-events:none}
  .rb-mode-option>span{display:flex;flex-direction:column;gap:2px;padding:9px 10px;border:1px solid var(--brass);border-radius:6px;background:rgba(255,255,255,.025);color:var(--parchment-dim);transition:.15s ease;user-select:none}
  .rb-mode-option b{font-size:12.5px;font-weight:600;color:var(--parchment)}
  .rb-mode-option small{font-size:10px;line-height:1.35;color:var(--parchment-faint)}
  .rb-mode-option:hover>span{background:rgba(255,255,255,.055);border-color:var(--brass-solid)}
  .rb-mode-option input:checked+span{background:var(--rust-dim);border-color:var(--rust);box-shadow:inset 3px 0 0 var(--rust)}
  .rb-mode-option input:focus-visible+span{outline:2px solid var(--parchment);outline-offset:2px}
</style>

<script>
  import L from 'leaflet';

  type RoutePoint = [number, number];
  type ApiTrail = { key?: string; trail?: { segments?: Array<Array<[number, number, number?]>> } };
  type RoutingResponse = { ok?: boolean; shape?: string; shape_precision?: number; distance_km?: number | null; time_seconds?: number | null; message?: string };

  const runtime = window as typeof window & {
    __panachaikoMap?: L.Map;
    __panachaikoRouteLayer?: L.Polyline;
    __panachaikoMapCaptureInstalled?: boolean;
  };

  if (!runtime.__panachaikoMapCaptureInstalled) {
    runtime.__panachaikoMapCaptureInstalled = true;
    const originalMap = L.map.bind(L);
    L.map = ((...args: Parameters<typeof L.map>) => {
      const instance = originalMap(...args);
      runtime.__panachaikoMap = instance;
      return instance;
    }) as typeof L.map;
  }

  const routeToggle = document.getElementById('routeBuilderToggle');
  const routePanel = document.getElementById('routeBuilderPanel');
  const drawer = document.getElementById('trailDrawer');
  const drawerHandle = document.getElementById('trailDrawerHandle');
  const gpsButton = document.getElementById('rbGpsBtn') as HTMLButtonElement | null;
  const calcButton = document.getElementById('rbCalcBtn') as HTMLButtonElement | null;
  const trailSelect = document.getElementById('rbTrailSelect') as HTMLSelectElement | null;
  const resultStatus = document.getElementById('rbResultStatus');

  let lastKnownPosition: GeolocationPosition | null = null;

  routeToggle?.addEventListener('click', () => {
    window.setTimeout(() => {
      if (routePanel?.classList.contains('open')) {
        drawer?.classList.remove('open');
        drawerHandle?.classList.remove('open');
      }
    }, 0);
  });

  document.querySelectorAll<HTMLInputElement>('input[name="rbMode"]').forEach(input => {
    input.addEventListener('change', () => {
      if (resultStatus) resultStatus.textContent = '';
    });
  });

  const requestPosition = (maximumAge: number, timeout: number) => new Promise<GeolocationPosition>((resolve, reject) => {
    if (!navigator.geolocation) {
      reject(new Error('Το GPS δεν είναι διαθέσιμο.'));
      return;
    }
    navigator.geolocation.getCurrentPosition(resolve, reject, {
      enableHighAccuracy: true,
      maximumAge,
      timeout
    });
  });

  // The main map already starts a GPS watch when this button is pressed. Keep a
  // second lightweight snapshot here as well, so route calculation can reuse the
  // location the user has already approved instead of demanding a second fresh fix.
  gpsButton?.addEventListener('click', () => {
    void requestPosition(10 * 60 * 1000, 15000).then(position => {
      lastKnownPosition = position;
    }).catch(() => {
      // trail-map.ts still owns the visible GPS state; calculation will retry below.
    });
  });

  const getPosition = async (): Promise<GeolocationPosition> => {
    if (lastKnownPosition && Date.now() - lastKnownPosition.timestamp <= 10 * 60 * 1000) {
      return lastKnownPosition;
    }
    const position = await requestPosition(10 * 60 * 1000, 30000);
    lastKnownPosition = position;
    return position;
  };

  const distanceMeters = (lng1: number, lat1: number, lng2: number, lat2: number) => {
    const R = 6371000;
    const rad = (v: number) => v * Math.PI / 180;
    const dLat = rad(lat2 - lat1);
    const dLng = rad(lng2 - lng1);
    const a = Math.sin(dLat / 2) ** 2 + Math.cos(rad(lat1)) * Math.cos(rad(lat2)) * Math.sin(dLng / 2) ** 2;
    return 2 * R * Math.asin(Math.sqrt(a));
  };

  const nearestTrailPoint = (segments: Array<Array<[number, number, number?]>>, lng: number, lat: number): RoutePoint | null => {
    let best: RoutePoint | null = null;
    let bestDistance = Number.POSITIVE_INFINITY;
    segments.forEach(segment => segment.forEach(point => {
      if (!Array.isArray(point) || point.length < 2) return;
      const pointLng = Number(point[0]);
      const pointLat = Number(point[1]);
      if (!Number.isFinite(pointLng) || !Number.isFinite(pointLat)) return;
      const d = distanceMeters(lng, lat, pointLng, pointLat);
      if (d < bestDistance) {
        bestDistance = d;
        best = [pointLat, pointLng];
      }
    }));
    return best;
  };

  const decodePolyline = (encoded: string, precision = 6): RoutePoint[] => {
    const coordinates: RoutePoint[] = [];
    let index = 0;
    let lat = 0;
    let lng = 0;
    const factor = Math.pow(10, precision);

    while (index < encoded.length) {
      let result = 0;
      let shift = 0;
      let byte = 0;
      do {
        byte = encoded.charCodeAt(index++) - 63;
        result |= (byte & 0x1f) << shift;
        shift += 5;
      } while (byte >= 0x20 && index < encoded.length);
      const deltaLat = (result & 1) ? ~(result >> 1) : (result >> 1);
      lat += deltaLat;

      result = 0;
      shift = 0;
      do {
        byte = encoded.charCodeAt(index++) - 63;
        result |= (byte & 0x1f) << shift;
        shift += 5;
      } while (byte >= 0x20 && index < encoded.length);
      const deltaLng = (result & 1) ? ~(result >> 1) : (result >> 1);
      lng += deltaLng;

      coordinates.push([lat / factor, lng / factor]);
    }
    return coordinates;
  };

  const loadTrailSegments = async (code: string) => {
    const response = await fetch('https://cms.panachaikotrails.gr/?rest_route=/panachaiko/v1/trails', {
      headers: { Accept: 'application/json' },
      cache: 'no-store',
      credentials: 'omit'
    });
    if (!response.ok) throw new Error('Δεν φορτώθηκαν τα δεδομένα του μονοπατιού.');
    const payload = await response.json() as ApiTrail[];
    const item = payload.find(entry => entry?.key === code);
    const segments = item?.trail?.segments;
    if (!Array.isArray(segments) || !segments.length) throw new Error('Το μονοπάτι δεν έχει διαθέσιμη γεωμετρία.');
    return segments;
  };

  const drawRoute = (points: RoutePoint[], color: string, dashed = false) => {
    const map = runtime.__panachaikoMap;
    if (!map) throw new Error('Ο χάρτης δεν είναι ακόμη έτοιμος. Κάνε ανανέωση και δοκίμασε ξανά.');
    if (runtime.__panachaikoRouteLayer) map.removeLayer(runtime.__panachaikoRouteLayer);
    runtime.__panachaikoRouteLayer = L.polyline(points, {
      color,
      weight: 5,
      opacity: .95,
      dashArray: dashed ? '8 8' : undefined,
      lineCap: 'round',
      lineJoin: 'round'
    }).addTo(map);
    const bounds = runtime.__panachaikoRouteLayer.getBounds();
    if (bounds.isValid()) map.fitBounds(bounds, { padding: [70, 70], maxZoom: 16 });
  };

  calcButton?.addEventListener('click', async event => {
    event.preventDefault();
    event.stopImmediatePropagation();

    const code = trailSelect?.value ?? '';
    if (!code) return;
    const mode = document.querySelector<HTMLInputElement>('input[name="rbMode"]:checked')?.value ?? 'straight';

    calcButton.disabled = true;
    calcButton.textContent = 'Υπολογισμός…';
    if (runtime.__panachaikoMap && runtime.__panachaikoRouteLayer) {
      runtime.__panachaikoMap.removeLayer(runtime.__panachaikoRouteLayer);
      runtime.__panachaikoRouteLayer = undefined;
    }
    if (resultStatus) {
      resultStatus.textContent = 'Χρήση του διαθέσιμου GPS και υπολογισμός διαδρομής…';
      resultStatus.className = 'rb-status warn';
    }

    try {
      const position = await getPosition();
      const startLat = position.coords.latitude;
      const startLng = position.coords.longitude;
      const segments = await loadTrailSegments(code);
      const target = nearestTrailPoint(segments, startLng, startLat);
      if (!target) throw new Error('Δεν βρέθηκε κοντινό σημείο στο μονοπάτι.');

      if (mode === 'straight') {
        drawRoute([[startLat, startLng], target], '#cf5a34', true);
        const meters = distanceMeters(startLng, startLat, target[1], target[0]);
        if (resultStatus) {
          resultStatus.textContent = `Ευθεία απόσταση: ${meters < 1000 ? `${Math.round(meters)} μ` : `${(meters / 1000).toFixed(2)} χλμ`}.`;
          resultStatus.className = 'rb-status ok';
        }
      } else if (mode === 'ors') {
        const response = await fetch('https://cms.panachaikotrails.gr/?rest_route=/panachaiko/v1/route', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({ start_lat: startLat, start_lng: startLng, end_lat: target[0], end_lng: target[1] }),
          credentials: 'omit'
        });
        const payload = await response.json().catch(() => ({})) as RoutingResponse;
        if (!response.ok || !payload.shape) throw new Error(payload.message || 'Δεν βρέθηκε πεζοπορική διαδρομή.');
        const points = decodePolyline(payload.shape, payload.shape_precision ?? 6);
        if (points.length < 2) throw new Error('Η υπηρεσία δεν επέστρεψε έγκυρη διαδρομή.');
        drawRoute(points, '#3b82f6', false);
        const distanceText = typeof payload.distance_km === 'number' ? `${payload.distance_km.toFixed(2)} χλμ` : 'διαθέσιμη';
        const minutes = typeof payload.time_seconds === 'number' ? Math.max(1, Math.round(payload.time_seconds / 60)) : null;
        if (resultStatus) {
          resultStatus.textContent = `Πεζοπορική διαδρομή: ${distanceText}${minutes ? ` · περίπου ${minutes} λεπτά` : ''}.`;
          resultStatus.className = 'rb-status ok';
        }
      } else {
        drawRoute([[startLat, startLng], target], '#a855f7', true);
        if (resultStatus) {
          resultStatus.textContent = 'Η λειτουργία εδάφους δεν έχει ακόμη συνδεθεί με μοντέλο υψομέτρου. Εμφανίζεται προσωρινά η άμεση προσέγγιση.';
          resultStatus.className = 'rb-status warn';
        }
      }
    } catch (error) {
      if (resultStatus) {
        const geolocationError = typeof GeolocationPositionError !== 'undefined' && error instanceof GeolocationPositionError;
        resultStatus.textContent = geolocationError
          ? 'Το προηγούμενο στίγμα GPS έπαψε να είναι διαθέσιμο. Πάτησε ξανά «Χρήση της θέσης μου» και δοκίμασε.'
          : error instanceof Error ? error.message : 'Ο υπολογισμός απέτυχε.';
        resultStatus.className = 'rb-status warn';
      }
    } finally {
      calcButton.disabled = false;
      calcButton.textContent = 'Υπολογισμός διαδρομής';
    }
  }, { capture: true });
</script>
