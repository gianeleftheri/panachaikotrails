---
import { trailIcon } from '../lib/trail-icons';
---
<section class="route-builder-panel" id="routeBuilderPanel" aria-label="Σχεδιασμός πεζοπορικής διαδρομής">
  <div class="rb-title">Διαδρομή</div>

  <div class="rb-step">
    <div class="rb-step-label"><span class="rb-step-num">1</span>Αφετηρία</div>
    <button class="rb-gps-btn" id="rbGpsBtn" type="button"><span set:html={trailIcon('pin')} />Χρήση της θέσης μου (GPS)</button>
    <div class="rb-status" id="rbGpsStatus"></div>
  </div>

  <div class="rb-step">
    <div class="rb-step-label"><span class="rb-step-num">2</span>Προορισμός</div>
    <div id="destinationAreaReview" class="rb-map-destination">
      <div class="area-review-actions"><button type="button" id="areaReviewFit">Όρια 12 χλμ.</button><button type="button" id="areaReviewPick" aria-pressed="false">Επιλογή στον χάρτη</button></div>
      <div class="rb-coordinates"><label>Γεωγραφικό πλάτος<input class="rb-select" id="destinationLat" readonly /></label><label>Γεωγραφικό μήκος<input class="rb-select" id="destinationLng" readonly /></label></div>
    </div>
    <div class="rb-help">Ή επιλέξτε καταχωρημένο μονοπάτι:</div>
    <select class="rb-select" id="rbTrailSelect">
      <option value="">— Διάλεξε μονοπάτι —</option>
    </select>
    <div class="rb-help">Η πλοήγηση θα σε πάει πρώτα στην καταχωρημένη αρχή του μονοπατιού και μετά θα συνεχίσει έως το τέλος του.</div>
  </div>

  <div class="rb-step">
    <div class="rb-step-label"><span class="rb-step-num">3</span>Τρόπος προσέγγισης</div>
    <input type="hidden" name="rbMode" value="ors" />
    <div class="rb-option-title"><span set:html={trailIcon('mountain')} /><b>Έδαφος</b></div>
    <div class="rb-help">Πεζοπορική πορεία στο διαθέσιμο δίκτυο δρόμων και μονοπατιών, από το GPS έως τον προορισμό σας.</div>
  </div>

  <button class="rb-calc-btn" id="rbCalcBtn" type="button" disabled>Υπολογισμός διαδρομής</button>
  <div class="rb-status" id="rbResultStatus"></div>
</section>

<style>
  .route-builder-panel{z-index:1200!important;pointer-events:auto!important}
  .rb-coordinates{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:10px 0}.rb-coordinates label{font-size:11px}.rb-coordinates input{margin-top:4px;width:100%;box-sizing:border-box}
  .rb-mode-grid{display:grid;gap:7px}
  .rb-mode-option{position:relative;display:block;cursor:pointer}
  .rb-mode-option input{position:absolute;opacity:0;pointer-events:none}
  .rb-mode-option>span{display:flex;flex-direction:column;gap:2px;padding:9px 10px;border:1px solid var(--brass);border-radius:6px;background:rgba(255,255,255,.025);color:var(--parchment-dim);transition:.15s ease;user-select:none}
  .rb-mode-option b{font-size:12.5px;font-weight:600;color:var(--parchment)}
  .rb-gps-btn,.rb-option-title{display:flex;align-items:center;gap:9px}
  .rb-gps-btn .pt-minimal-icon,.rb-option-title .pt-minimal-icon{width:19px;height:19px}
  .rb-option-title .pt-minimal-icon{color:var(--parchment);flex:none}
  .rb-mode-option small,.rb-help{font-size:10px;line-height:1.4;color:var(--parchment-faint)}
  .rb-help{margin-top:6px}
  .rb-mode-option:hover>span{background:rgba(255,255,255,.055);border-color:var(--brass-solid)}
  .rb-mode-option input:checked+span{background:var(--rust-dim);border-color:var(--rust);box-shadow:inset 3px 0 0 var(--rust)}
  .rb-mode-option input:focus-visible+span{outline:2px solid var(--parchment);outline-offset:2px}
</style>

<script>
  const routeToggle = document.getElementById('routeBuilderToggle');
  const routePanel = document.getElementById('routeBuilderPanel');
  const drawer = document.getElementById('trailDrawer');
  const drawerHandle = document.getElementById('trailDrawerHandle');
  const result = document.getElementById('rbResultStatus');

  routeToggle?.addEventListener('click', () => {
    window.setTimeout(() => {
      if (routePanel?.classList.contains('open')) {
        drawer?.classList.remove('open');
        drawerHandle?.classList.remove('open');
      }
    }, 0);
  });

  document.querySelectorAll<HTMLInputElement>('input[name="rbMode"]').forEach(input => {
    input.addEventListener('change', () => {
      if (result) result.textContent = '';
      const start = document.getElementById('rbStartNavBtn') as HTMLButtonElement | null;
      if (start) start.hidden = true;
    });
  });
</script>
