<script>
  import L from 'leaflet';
  import { getTrailNavigationConfig } from '../data/trail-navigation';
  import { decodeHtmlEntities } from '../scripts/text-normalize';

  type RoutePoint = [number, number];
  type RawTrailPoint = [number, number, number?];
  type TrailSegment = RoutePoint[];
  type ApiTrail = {
    key?: string;
    trail?: {
      name?: string;
      length_km?: number;
      gain_m?: number;
      loss_m?: number;
      segments?: Array<Array<RawTrailPoint>>;
    };
  };
  type RoutingResponse = {
    ok?: boolean;
    shape?: string;
    shape_precision?: number;
    distance_km?: number | null;
    time_seconds?: number | null;
    message?: string;
  };
  type NavigationPlan = {
    code: string;
    name: string;
    mode: string;
    points: RoutePoint[];
    approachPointCount: number;
    totalDistanceM: number;
    approachDistanceM: number;
    trailDistanceM: number;
    estimatedSeconds: number;
  };
  type GraphEdge = {
    index: number;
    a: number;
    b: number;
    points: TrailSegment;
    length: number;
  };
  type GraphLink = { edgeIndex: number; to: number };
  type MainTrailRoute = {
    segments: TrailSegment[];
    points: RoutePoint[];
    totalSegments: number;
    usedSegments: number;
    omittedSegments: number;
    reversed: boolean;
    ascentM: number;
    descentM: number;
    startLabel?: string;
    endLabel?: string;
    directionVerified: boolean;
  };

  const runtime = window as typeof window & {
    __panachaikoMap?: L.Map;
    __panachaikoRouteLayer?: L.Polyline;
    __panachaikoFullRouteLayer?: L.LayerGroup;
    __panachaikoNavigationPlan?: NavigationPlan;
  };

  // 35 m joins the only real small source gap (E31 ~31 m) while avoiding
  // collapsing legitimate short route sections (Π-4 ~59 m, E31 ~49 m).
  const SEGMENT_SNAP_METERS = 35;
  let cachedPosition: GeolocationPosition | null = null;
  let pendingPlan: NavigationPlan | null = null;

  const formatDistance = (meters: number) => meters < 1000
    ? `${Math.round(meters)} μ`
    : `${(meters / 1000).toFixed(meters < 10000 ? 2 : 1)} χλμ`;

  const formatTime = (seconds: number) => {
    const minutes = Math.max(1, Math.round(seconds / 60));
    if (minutes < 60) return `${minutes} λεπτά`;
    const hours = Math.floor(minutes / 60);
    const rest = minutes % 60;
    return rest ? `${hours}ω ${rest}λ` : `${hours} ώρες`;
  };

  const haversine = (a: RoutePoint, b: RoutePoint) => {
    const R = 6371000;
    const rad = (v: number) => v * Math.PI / 180;
    const dLat = rad(b[0] - a[0]);
    const dLng = rad(b[1] - a[1]);
    const x = Math.sin(dLat / 2) ** 2 + Math.cos(rad(a[0])) * Math.cos(rad(b[0])) * Math.sin(dLng / 2) ** 2;
    return 2 * R * Math.asin(Math.sqrt(x));
  };

  const pathDistance = (points: RoutePoint[]) => points.slice(1)
    .reduce((sum, point, index) => sum + haversine(points[index], point), 0);

  const decodePolyline = (encoded: string, precision = 6): RoutePoint[] => {
    const coordinates: RoutePoint[] = [];
    let index = 0;
    let lat = 0;
    let lng = 0;
    const factor = 10 ** precision;
    while (index < encoded.length) {
      let result = 0, shift = 0, byte = 0;
      do { byte = encoded.charCodeAt(index++) - 63; result |= (byte & 0x1f) << shift; shift += 5; } while (byte >= 0x20 && index < encoded.length);
      lat += (result & 1) ? ~(result >> 1) : (result >> 1);
      result = 0; shift = 0;
      do { byte = encoded.charCodeAt(index++) - 63; result |= (byte & 0x1f) << shift; shift += 5; } while (byte >= 0x20 && index < encoded.length);
      lng += (result & 1) ? ~(result >> 1) : (result >> 1);
      coordinates.push([lat / factor, lng / factor]);
    }
    return coordinates;
  };

  const getPosition = () => new Promise<GeolocationPosition>((resolve, reject) => {
    if (cachedPosition && Date.now() - cachedPosition.timestamp < 10 * 60 * 1000) {
      resolve(cachedPosition);
      return;
    }
    if (!navigator.geolocation) {
      reject(new Error('Το GPS δεν είναι διαθέσιμο.'));
      return;
    }
    navigator.geolocation.getCurrentPosition(position => {
      cachedPosition = position;
      resolve(position);
    }, reject, { enableHighAccuracy: true, maximumAge: 10 * 60 * 1000, timeout: 30000 });
  });

  document.getElementById('rbGpsBtn')?.addEventListener('click', () => {
    if (!navigator.geolocation) return;
    navigator.geolocation.getCurrentPosition(position => { cachedPosition = position; }, () => {}, {
      enableHighAccuracy: true,
      maximumAge: 10 * 60 * 1000,
      timeout: 20000
    });
  });

  const loadTrail = async (code: string) => {
    const response = await fetch('https://cms.panachaikotrails.gr/?rest_route=/panachaiko/v1/trails', {
      headers: { Accept: 'application/json' }, cache: 'no-store', credentials: 'omit'
    });
    if (!response.ok) throw new Error('Δεν φορτώθηκαν τα δεδομένα του μονοπατιού.');
    const payload = await response.json() as ApiTrail[];
    const item = payload.find(entry => entry?.key === code);
    if (!item?.trail?.segments?.length) throw new Error('Το επιλεγμένο μονοπάτι δεν έχει διαθέσιμη γεωμετρία.');
    return item.trail;
  };

  const normaliseTrailSegments = (segments: Array<Array<RawTrailPoint>>): TrailSegment[] => segments
    .map(segment => segment
      .map(raw => [Number(raw[1]), Number(raw[0])] as RoutePoint)
      .filter(point => Number.isFinite(point[0]) && Number.isFinite(point[1]))
      .filter((point, index, points) => index === 0 || point[0] !== points[index - 1][0] || point[1] !== points[index - 1][1]))
    .filter(segment => segment.length >= 2);

  const flattenConnectedSegments = (segments: TrailSegment[]) => {
    const points: RoutePoint[] = [];
    segments.forEach(segment => {
      segment.forEach((point, index) => {
        const previous = points.at(-1);
        if (index === 0 && previous && haversine(previous, point) < 1) return;
        points.push(point);
      });
    });
    return points;
  };

  const coordKey = (point: RoutePoint) => `${point[0].toFixed(6)}|${point[1].toFixed(6)}`;

  const elevationLookup = (rawSegments: Array<Array<RawTrailPoint>>) => {
    const lookup = new Map<string, number>();
    rawSegments.forEach(segment => segment.forEach(raw => {
      const elevation = Number(raw[2]);
      if (!Number.isFinite(elevation)) return;
      const point: RoutePoint = [Number(raw[1]), Number(raw[0])];
      if (Number.isFinite(point[0]) && Number.isFinite(point[1])) lookup.set(coordKey(point), elevation);
    }));
    return lookup;
  };

  const gainLossFor = (points: RoutePoint[], elevations: Map<string, number>) => {
    let gain = 0;
    let loss = 0;
    let previousElevation: number | null = null;
    points.forEach(point => {
      const elevation = elevations.get(coordKey(point));
      if (elevation === undefined) { previousElevation = null; return; }
      if (previousElevation !== null) {
        const delta = elevation - previousElevation;
        if (delta > 0) gain += delta;
        else loss += Math.abs(delta);
      }
      previousElevation = elevation;
    });
    return { gain, loss };
  };

  const orientOfficialRoute = (
    code: string,
    routeSegments: TrailSegment[],
    rawSegments: Array<Array<RawTrailPoint>>,
    totalSegments: number
  ): MainTrailRoute => {
    const config = getTrailNavigationConfig(code);
    let orientedSegments = routeSegments;
    let reversed = false;
    const rawPoints = flattenConnectedSegments(routeSegments);

    if (config && rawPoints.length > 1) {
      const distanceAtFirst = haversine(config.start, rawPoints[0]);
      const distanceAtLast = haversine(config.start, rawPoints.at(-1)!);
      if (distanceAtLast < distanceAtFirst) {
        orientedSegments = [...routeSegments].reverse().map(segment => [...segment].reverse());
        reversed = true;
      }
    }

    const points = flattenConnectedSegments(orientedSegments);
    const profile = gainLossFor(points, elevationLookup(rawSegments));
    const usedSegments = orientedSegments.length;
    return {
      segments: orientedSegments,
      points,
      totalSegments,
      usedSegments,
      omittedSegments: Math.max(0, totalSegments - usedSegments),
      reversed,
      ascentM: profile.gain,
      descentM: profile.loss,
      startLabel: config?.startLabel,
      endLabel: config?.endLabel,
      directionVerified: config?.verified !== false
    };
  };

  const buildMainTrailRoute = (code: string, rawSegments: Array<Array<RawTrailPoint>>): MainTrailRoute => {
    const segments = normaliseTrailSegments(rawSegments);
    if (!segments.length) return orientOfficialRoute(code, [], rawSegments, 0);
    if (segments.length === 1) return orientOfficialRoute(code, [segments[0]], rawSegments, 1);

    const nodes: RoutePoint[] = [];
    const nodeFor = (point: RoutePoint, excludedNode = -1) => {
      let bestIndex = -1;
      let bestDistance = Number.POSITIVE_INFINITY;
      nodes.forEach((node, index) => {
        if (index === excludedNode) return;
        const distance = haversine(point, node);
        if (distance < bestDistance) { bestDistance = distance; bestIndex = index; }
      });
      if (bestIndex >= 0 && bestDistance <= SEGMENT_SNAP_METERS) return bestIndex;
      nodes.push(point);
      return nodes.length - 1;
    };

    const edges: GraphEdge[] = segments.map((points, index) => {
      const a = nodeFor(points[0]);
      // Never collapse both ends of the same real section into one graph node.
      const b = nodeFor(points.at(-1)!, a);
      return { index, a, b, points, length: pathDistance(points) };
    });

    const adjacency: GraphLink[][] = Array.from({ length: nodes.length }, () => []);
    edges.forEach(edge => {
      adjacency[edge.a].push({ edgeIndex: edge.index, to: edge.b });
      adjacency[edge.b].push({ edgeIndex: edge.index, to: edge.a });
    });

    // Segment arrays are not guaranteed to be stored in hiking order (E31 and Π-14
    // are clear examples). Work on the largest connected component instead of anchoring
    // the route to segments[0].
    const components: number[][] = [];
    const seen = new Set<number>();
    nodes.forEach((_, startNode) => {
      if (seen.has(startNode)) return;
      const stack = [startNode];
      const component: number[] = [];
      seen.add(startNode);
      while (stack.length) {
        const current = stack.pop()!;
        component.push(current);
        adjacency[current].forEach(link => {
          if (!seen.has(link.to)) { seen.add(link.to); stack.push(link.to); }
        });
      }
      components.push(component);
    });

    const componentLength = (component: number[]) => {
      const allowed = new Set(component);
      return edges.reduce((sum, edge) => allowed.has(edge.a) && allowed.has(edge.b) ? sum + edge.length : sum, 0);
    };
    const mainComponent = components.sort((a, b) => componentLength(b) - componentLength(a))[0] ?? [];
    const allowed = new Set(mainComponent);
    const terminals = mainComponent.filter(node => adjacency[node].filter(link => allowed.has(link.to)).length === 1);
    const candidates = terminals.length >= 2 ? terminals : mainComponent;

    const dijkstra = (startNode: number) => {
      const dist = new Array(nodes.length).fill(Number.POSITIVE_INFINITY) as number[];
      const previousNode = new Array(nodes.length).fill(-1) as number[];
      const previousEdge = new Array(nodes.length).fill(-1) as number[];
      const visited = new Array(nodes.length).fill(false) as boolean[];
      dist[startNode] = 0;
      for (let iteration = 0; iteration < mainComponent.length; iteration += 1) {
        let current = -1;
        let currentDistance = Number.POSITIVE_INFINITY;
        mainComponent.forEach(node => {
          if (!visited[node] && dist[node] < currentDistance) { current = node; currentDistance = dist[node]; }
        });
        if (current < 0) break;
        visited[current] = true;
        adjacency[current].forEach(link => {
          if (!allowed.has(link.to)) return;
          const edge = edges[link.edgeIndex];
          const candidate = currentDistance + edge.length;
          if (candidate < dist[link.to]) {
            dist[link.to] = candidate;
            previousNode[link.to] = current;
            previousEdge[link.to] = link.edgeIndex;
          }
        });
      }
      return { dist, previousNode, previousEdge };
    };

    let bestDistance = -1;
    let bestStart = candidates[0] ?? mainComponent[0] ?? 0;
    let bestEnd = bestStart;
    let bestPreviousNode: number[] = [];
    let bestPreviousEdge: number[] = [];

    candidates.forEach(startNode => {
      const result = dijkstra(startNode);
      candidates.forEach(endNode => {
        const distance = result.dist[endNode];
        if (Number.isFinite(distance) && distance > bestDistance) {
          bestDistance = distance;
          bestStart = startNode;
          bestEnd = endNode;
          bestPreviousNode = result.previousNode;
          bestPreviousEdge = result.previousEdge;
        }
      });
    });

    if (bestDistance < 0 || bestStart === bestEnd) {
      return orientOfficialRoute(code, [segments[0]], rawSegments, segments.length);
    }

    const steps: Array<{ edgeIndex: number; from: number; to: number }> = [];
    let cursor = bestEnd;
    while (cursor !== bestStart && bestPreviousEdge[cursor] >= 0) {
      steps.push({ edgeIndex: bestPreviousEdge[cursor], from: bestPreviousNode[cursor], to: cursor });
      cursor = bestPreviousNode[cursor];
    }
    steps.reverse();

    const routeSegments: TrailSegment[] = [];
    let currentNode = bestStart;
    steps.forEach(step => {
      const edge = edges[step.edgeIndex];
      const oriented = edge.a === currentNode ? edge.points : [...edge.points].reverse();
      routeSegments.push(oriented);
      currentNode = step.to;
    });

    return orientOfficialRoute(code, routeSegments, rawSegments, segments.length);
  };

  const routeApproach = async (start: RoutePoint, end: RoutePoint, mode: string) => {
    if (mode !== 'ors') {
      const points = [start, end];
      const distanceM = haversine(start, end);
      return { points, distanceM, seconds: distanceM / 1.2 };
    }
    const response = await fetch('https://cms.panachaikotrails.gr/?rest_route=/panachaiko/v1/route', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
      body: JSON.stringify({ start_lat: start[0], start_lng: start[1], end_lat: end[0], end_lng: end[1] }),
      credentials: 'omit'
    });
    const payload = await response.json().catch(() => ({})) as RoutingResponse;
    if (!response.ok || !payload.shape) throw new Error(payload.message || 'Δεν βρέθηκε πεζοπορική πρόσβαση προς την αρχή του μονοπατιού.');
    const points = decodePolyline(payload.shape, payload.shape_precision ?? 6);
    if (points.length < 2) throw new Error('Η υπηρεσία δρομολόγησης δεν επέστρεψε έγκυρη πορεία.');
    const distanceM = typeof payload.distance_km === 'number' ? payload.distance_km * 1000 : pathDistance(points);
    const seconds = typeof payload.time_seconds === 'number' ? payload.time_seconds : distanceM / 1.2;
    return { points, distanceM, seconds };
  };

  const drawPlan = (approach: RoutePoint[], trailSegments: TrailSegment[]) => {
    const map = runtime.__panachaikoMap;
    if (!map) throw new Error('Ο χάρτης δεν είναι ακόμη έτοιμος. Κάνε ανανέωση και δοκίμασε ξανά.');
    if (runtime.__panachaikoRouteLayer && map.hasLayer(runtime.__panachaikoRouteLayer)) map.removeLayer(runtime.__panachaikoRouteLayer);
    if (runtime.__panachaikoFullRouteLayer) map.removeLayer(runtime.__panachaikoFullRouteLayer);

    const group = L.layerGroup();
    L.polyline(approach, { color: '#3b82f6', weight: 5, opacity: .96, lineCap: 'round', lineJoin: 'round' }).addTo(group);
    trailSegments.forEach(segment => {
      L.polyline(segment, { color: '#84a06e', weight: 6, opacity: .98, lineCap: 'round', lineJoin: 'round' }).addTo(group);
    });
    group.addTo(map);
    runtime.__panachaikoFullRouteLayer = group;

    const all = [...approach, ...trailSegments.flat()];
    if (all.length) map.fitBounds(L.latLngBounds(all), { padding: [70, 70], maxZoom: 16 });
  };

  const ensureStartButton = () => {
    let startButton = document.getElementById('rbStartNavBtn') as HTMLButtonElement | null;
    if (!startButton) {
      startButton = document.createElement('button');
      startButton.id = 'rbStartNavBtn';
      startButton.type = 'button';
      startButton.className = 'rb-calc-btn';
      startButton.style.marginTop = '8px';
      startButton.textContent = '🔒 Κλείδωμα & έναρξη πλοήγησης';
      document.getElementById('rbCalcBtn')?.insertAdjacentElement('afterend', startButton);
      startButton.addEventListener('click', () => {
        if (!pendingPlan) return;
        document.getElementById('routeBuilderPanel')?.classList.remove('open');
        document.getElementById('routeBuilderToggle')?.classList.remove('open');
        document.getElementById('trailDrawer')?.classList.remove('open');
        document.dispatchEvent(new CustomEvent<NavigationPlan>('panachaiko:navigation-start', { detail: pendingPlan }));
      });
    }
    startButton.hidden = false;
    return startButton;
  };

  document.addEventListener('click', async event => {
    const target = event.target as HTMLElement | null;
    const calcButton = target?.closest<HTMLButtonElement>('#rbCalcBtn');
    if (!calcButton) return;

    event.preventDefault();
    event.stopImmediatePropagation();

    const trailSelect = document.getElementById('rbTrailSelect') as HTMLSelectElement | null;
    const result = document.getElementById('rbResultStatus');
    const code = trailSelect?.value ?? '';
    if (!code) return;
    const mode = document.querySelector<HTMLInputElement>('input[name="rbMode"]:checked')?.value ?? 'ors';
    const startButton = document.getElementById('rbStartNavBtn') as HTMLButtonElement | null;
    if (startButton) startButton.hidden = true;
    pendingPlan = null;
    document.dispatchEvent(new CustomEvent('panachaiko:endpoints-clear'));

    calcButton.disabled = true;
    calcButton.textContent = 'Υπολογισμός ολόκληρης διαδρομής…';
    if (result) { result.textContent = 'Υπολογίζω GPS → αρχή μονοπατιού → τέλος μονοπατιού…'; result.className = 'rb-status warn'; }

    try {
      const position = await getPosition();
      const start: RoutePoint = [position.coords.latitude, position.coords.longitude];
      const trail = await loadTrail(code);
      const mainRoute = buildMainTrailRoute(code, trail.segments!);
      const trailPoints = mainRoute.points;
      if (trailPoints.length < 2 || !mainRoute.segments.length) throw new Error('Δεν βρέθηκε συνεχής κύρια πορεία μέσα στα τμήματα του μονοπατιού.');

      const approach = await routeApproach(start, trailPoints[0], mode);
      const trailDistanceM = pathDistance(trailPoints);
      const fallbackAscent = Number(trail.gain_m ?? 0);
      const ascent = mainRoute.ascentM > 0 ? mainRoute.ascentM : fallbackAscent;
      const trailSeconds = (trailDistanceM / 5000) * 3600 + (Math.max(0, ascent) / 600) * 3600;
      const totalDistanceM = approach.distanceM + trailDistanceM;
      const estimatedSeconds = approach.seconds + trailSeconds;
      const fullPoints = [...approach.points, ...trailPoints.slice(1)];

      pendingPlan = {
        code,
        name: decodeHtmlEntities(trail.name ?? code),
        mode,
        points: fullPoints,
        approachPointCount: approach.points.length,
        totalDistanceM,
        approachDistanceM: approach.distanceM,
        trailDistanceM,
        estimatedSeconds
      };
      runtime.__panachaikoNavigationPlan = pendingPlan;
      drawPlan(approach.points, mainRoute.segments);
      document.dispatchEvent(new CustomEvent<NavigationPlan>('panachaiko:route-preview', { detail: pendingPlan }));
      ensureStartButton();

      if (result) {
        const topologyNote = mainRoute.omittedSegments
          ? `<br><span style="opacity:.72">Κύρια συνεχής πορεία: ${mainRoute.usedSegments}/${mainRoute.totalSegments} τμήματα. ${mainRoute.omittedSegments} κλαδιά/ασύνδετα τμήματα δεν ενώνονται τεχνητά με ευθείες.</span>`
          : '';
        const declaredDistanceM = Number(trail.length_km ?? 0) * 1000;
        const lengthDeltaPct = declaredDistanceM > 0 ? Math.abs(trailDistanceM - declaredDistanceM) / declaredDistanceM * 100 : 0;
        const auditNote = lengthDeltaPct > 5
          ? `<br><span style="color:#d9a441">⚠ Έλεγχος γεωμετρίας: υπολογισμένο μήκος ${formatDistance(trailDistanceM)} έναντι δηλωμένου ${formatDistance(declaredDistanceM)}.</span>`
          : '';
        const directionNote = mainRoute.startLabel && mainRoute.endLabel
          ? `<br><span style="opacity:.86">Αφετηρία Α: <b>${mainRoute.startLabel}</b> → Τέλος Τ: <b>${mainRoute.endLabel}</b>${mainRoute.directionVerified ? '' : ' · φορά υπό επιβεβαίωση'}</span>`
          : '';
        result.innerHTML = `Προσέγγιση στην αρχή: <b>${formatDistance(approach.distanceM)}</b><br>Μονοπάτι μέχρι το τέλος: <b>${formatDistance(trailDistanceM)}</b><br>Σύνολο: <b>${formatDistance(totalDistanceM)}</b> · περίπου <b>${formatTime(estimatedSeconds)}</b>${directionNote}${topologyNote}${auditNote}<br><span style="opacity:.72">Μετά πάτησε «Κλείδωμα & έναρξη πλοήγησης».</span>`;
        result.className = 'rb-status ok';
      }
    } catch (error) {
      if (result) {
        result.textContent = error instanceof Error ? error.message : 'Ο υπολογισμός απέτυχε.';
        result.className = 'rb-status warn';
      }
    } finally {
      calcButton.disabled = false;
      calcButton.textContent = 'Υπολογισμός ολόκληρης διαδρομής';
    }
  }, { capture: true });

  document.addEventListener('panachaiko:navigation-exit', event => {
    const finish = Boolean((event as CustomEvent<{ finish?: boolean }>).detail?.finish);
    const panel = document.getElementById('routeBuilderPanel');
    const toggle = document.getElementById('routeBuilderToggle');
    if (!finish) {
      panel?.classList.add('open');
      toggle?.classList.add('open');
    }
  });
</script>