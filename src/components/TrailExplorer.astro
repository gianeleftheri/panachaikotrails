---
import TrailTopbar from './TrailTopbar.astro';
import RecreationPanel from './RecreationPanel.astro';
import RouteBuilder from './RouteBuilder.astro';
import TrailDrawer from './TrailDrawer.astro';
import MapOverlays from './MapOverlays.astro';
import NavigationPanel from './NavigationPanel.astro';
import Navigation3dHudLayer from './Navigation3dHudLayer.astro';
import RouteNavigationController from './RouteNavigationController.astro';
import MapLibreTerrainV3 from './MapLibreTerrainV3.astro';

const { allowTrailSubmissions = false } = Astro.props;
---

<div class="trail-app" data-trail-app>
  <div id="map" aria-label="Διαδραστικός χάρτης μονοπατιών"></div>
  <TrailTopbar allowTrailSubmissions={allowTrailSubmissions} />
  <RouteBuilder />
  <RecreationPanel />

  <aside class="panel left-panel" id="trailPanel">
    <div class="left-panel-head">
      <div class="count-row">
        <div><strong id="trail-count">0</strong>μονοπάτια</div>
        <div><strong id="total-length">0</strong>χλμ συνολικά</div>
      </div>
      <div class="left-panel-actions" aria-label="Έλεγχος παραθύρου μονοπατιών">
        <button class="trail-panel-pin" id="trailPanelPin" type="button" aria-label="Καρφίτσωμα παραθύρου μονοπατιών" aria-pressed="false" title="Κράτησε το παράθυρο ανοιχτό"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m8 4 8 0-1 5 3 3v2H6v-2l3-3-1-5ZM12 14v7" /></svg></button>
        <button class="trail-panel-close" id="trailPanelClose" type="button" aria-label="Κλείσιμο παραθύρου μονοπατιών" title="Κλείσιμο">×</button>
      </div>
    </div>
    <div class="trail-list" id="trail-list"></div>
  </aside>

  <TrailDrawer />
  <MapOverlays />
  <NavigationPanel />
  <Navigation3dHudLayer />
  <RouteNavigationController />
  <MapLibreTerrainV3 />
  <noscript>Ο διαδραστικός χάρτης χρειάζεται ενεργοποιημένη JavaScript.</noscript>
</div>

<script>
  import '../scripts/map-runtime-bridge';
  import '../scripts/view-mode-sync';
  import '../scripts/navigation-shell';
  import '../scripts/trail-map';
  import '../scripts/trail-endpoints';
  import '../scripts/recreation-spots';
</script>
