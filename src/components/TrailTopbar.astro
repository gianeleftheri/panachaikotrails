---
import { trailIcon } from '../lib/trail-icons';
const { allowTrailSubmissions = false } = Astro.props;
---
<header class="topbar">
  <div class="brand">
    <svg width="30" height="30" viewBox="0 0 30 30" fill="none" aria-hidden="true">
      <path d="M2.5 24.5 10.5 9.5 15.2 16.3 19.2 12 27.5 24.5H2.5Z" fill="#123f7a" stroke="#ffffff" stroke-width="1.8" stroke-linejoin="round"/>
      <path d="M7.2 18.2 10.5 12.2 13.7 16.8 15.2 19.1 18.9 14.8 22.4 20" fill="none" stroke="#51d6eb" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
    <div class="brand-text">
      <h1>Παναχαϊκό</h1>
      <p>Δίκτυο μονοπατιών · δεδομένα ΟΦΥΠΕΚΑ</p>
    </div>
  </div>

  <div class:list={['topbar-actions', { 'has-submit-cta': allowTrailSubmissions }]}>
    <button class="trail-menu-toggle" id="trailMenuToggle" type="button" aria-expanded="false">
      <Fragment set:html={trailIcon('hike')} />
      <span class="btn-label">Μονοπάτια</span>
    </button>
    <button class="trail-menu-toggle recreation-menu-toggle" id="recreationMenuToggle" type="button" aria-expanded="false">
      <Fragment set:html={trailIcon('rest')} />
      <span class="btn-label">Χώροι Αναψυχής</span>
    </button>
    <button class="trail-menu-toggle rb-toggle" id="routeBuilderToggle" type="button" aria-expanded="false">
      <Fragment set:html={trailIcon('compass')} />
      <span class="btn-label">Διαδρομή</span>
    </button>
    {allowTrailSubmissions && (
      <a class="submit-trail-cta" href="https://cms.panachaikotrails.gr/?pt_action=submit_trail" aria-label="Πρόσθεσε το δικό σου μονοπάτι">
        <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
        <span>Πρόσθεσε μονοπάτι</span>
      </a>
    )}
    <button class="locate-btn" id="locateBtn" type="button" title="Η θέση μου (GPS)" aria-label="Η θέση μου (GPS)" disabled>
      <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="3" /><path d="M12 2v3M12 19v3M2 12h3M19 12h3" /></svg><span class="tool-label">GPS</span>
    </button>
    <button class="locate-btn recenter-btn" id="recenterBtn" type="button" title="Ακολούθησε τη θέση μου" aria-label="Ακολούθησε τη θέση μου">
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l3 6-3-1.5L9 9l3-6Z" /><circle cx="12" cy="12" r="9" /></svg>
    </button>
    <button class="shelter-btn" id="shelterBtn" type="button" title="Βρες το κοντινότερο καταφύγιο" aria-label="Βρες το κοντινότερο καταφύγιο"><Fragment set:html={trailIcon('shelter')} /><span class="tool-label">Καταφύγιο</span></button>
    <button class="view3d-btn" id="view3dBtn" type="button" title="3D προβολή επιλεγμένου μονοπατιού" aria-label="3D προβολή επιλεγμένου μονοπατιού"><Fragment set:html={trailIcon('mountain')} /><span class="tool-label">3D</span></button>
  </div>
</header>
