---
import { trailIcon } from '../lib/trail-icons';
const { allowTrailSubmissions = false } = Astro.props;
---
<header class="topbar">
  <div class="brand">
    <div class="brand-text">
      <h1>Παναχαϊκό</h1>
      <p>Δίκτυο μονοπατιών · δεδομένα ΟΦΥΠΕΚΑ</p>
    </div>
  </div>

  <div class:list={['topbar-actions', { 'has-submit-cta': allowTrailSubmissions }]}>
    <button class="trail-menu-toggle" id="trailMenuToggle" type="button" aria-expanded="false">
      <span class="map-tool-icon icon-trails"><Fragment set:html={trailIcon('hike')} /></span>
      <span class="btn-label">Μονοπάτια</span>
    </button>
    <button class="trail-menu-toggle recreation-menu-toggle" id="recreationMenuToggle" type="button" aria-expanded="false">
      <span class="map-tool-icon icon-recreation"><Fragment set:html={trailIcon('rest')} /></span>
      <span class="btn-label">Χώροι Αναψυχής</span>
    </button>
    <button class="trail-menu-toggle rb-toggle" id="routeBuilderToggle" type="button" aria-expanded="false">
      <span class="map-tool-icon icon-route"><Fragment set:html={trailIcon('compass')} /></span>
      <span class="btn-label">Διαδρομή</span>
    </button>
    {allowTrailSubmissions && (
      <a class="submit-trail-cta" href="https://cms.panachaikotrails.gr/?pt_action=submit_trail" aria-label="Πρόσθεσε το δικό σου μονοπάτι">
        <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
        <span>Πρόσθεσε μονοπάτι</span>
      </a>
    )}
    <button class="locate-btn" id="locateBtn" type="button" title="Η θέση μου (GPS)" aria-label="Η θέση μου (GPS)" disabled>
      <span class="map-tool-icon icon-gps"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 21s6-5.2 6-11a6 6 0 1 0-12 0c0 5.8 6 11 6 11Z" fill="#ff3c98" stroke="#0b2633" stroke-width="1.8" stroke-linejoin="round"/><circle cx="12" cy="10" r="2.5" fill="#ffdf00" stroke="#0b2633" stroke-width="1.6"/></svg></span>
      <span class="tool-label">Η θέση μου (GPS)</span>
    </button>
    <button class="locate-btn recenter-btn" id="recenterBtn" type="button" title="Ακολούθησε τη θέση μου" aria-label="Ακολούθησε τη θέση μου" disabled>
      <span class="map-tool-icon icon-follow"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="5" fill="#b9e52b" stroke="#0b2633" stroke-width="1.8"/><circle cx="12" cy="12" r="1.8" fill="#ff3c98"/><path d="M12 2v4M12 18v4M2 12h4M18 12h4" stroke="#0b2633" stroke-width="2" stroke-linecap="round"/></svg></span>
      <span class="tool-label">Ακολούθησε τη θέση μου</span>
    </button>
    <button class="shelter-btn" id="shelterBtn" type="button" title="Βρες το κοντινότερο καταφύγιο" aria-label="Βρες το κοντινότερο καταφύγιο"><span class="map-tool-icon icon-shelter"><Fragment set:html={trailIcon('shelter')} /></span><span class="tool-label">Καταφύγιο</span></button>
  </div>
</header>
