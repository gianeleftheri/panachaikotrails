---
import SosPanel from './SosPanel.astro';
import { trailIcon } from '../lib/trail-icons';
const { allowTrailSubmissions = false } = Astro.props;
---
<header class="topbar">
  <a class="brand brand-home" href="/" aria-label="Παναχαϊκό – Επιστροφή στην αρχική σελίδα" title="Επιστροφή στην αρχική σελίδα">
    <div class="brand-text">
      <h1 class="map-brand-heading"><img class="map-brand-logo" src="/panachaiko-trails-logo.svg" alt="Panachaiko Trails" /></h1>
    </div>
  </a>

  <div class:list={['topbar-actions', { 'has-submit-cta': allowTrailSubmissions }]}>
    <button class="trail-menu-toggle" id="trailMenuToggle" type="button" aria-expanded="false">
      <span class="map-tool-icon icon-trails"><Fragment set:html={trailIcon('hike')} /></span>
      <span class="btn-label">Μονοπάτια</span>
    </button>
    <button class="trail-menu-toggle recreation-menu-toggle" id="recreationMenuToggle" type="button" aria-expanded="false">
      <span class="map-tool-icon icon-recreation"><Fragment set:html={trailIcon('rest')} /></span>
      <span class="btn-label">Χώροι Αναψυχής</span>
    </button>
    <button class="trail-menu-toggle rb-toggle" id="routeBuilderToggle" type="button" aria-expanded="false">
      <span class="map-tool-icon icon-route"><Fragment set:html={trailIcon('compass')} /></span>
      <span class="btn-label">Διαδρομή</span>
    </button>
    {allowTrailSubmissions && (
      <a class="submit-trail-cta" href="https://cms.panachaikotrails.gr/?pt_action=submit_trail" aria-label="Πρόσθεσε το δικό σου μονοπάτι">
        <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
        <span>Πρόσθεσε μονοπάτι</span>
      </a>
    )}
    <button class="locate-btn" id="locateBtn" type="button" title="Η θέση μου (GPS)" aria-label="Η θέση μου (GPS)" disabled>
      <span class="map-tool-icon icon-gps"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 21s6-5.2 6-11a6 6 0 1 0-12 0c0 5.8 6 11 6 11Z" fill="#ff3c98" stroke="#0b2633" stroke-width="1.8" stroke-linejoin="round"/><circle cx="12" cy="10" r="2.5" fill="#ffdf00" stroke="#0b2633" stroke-width="1.6"/></svg></span>
      <span class="tool-label">Η θέση μου (GPS)</span>
    </button>
    <button class="locate-btn recenter-btn" id="recenterBtn" type="button" title="Ακολούθησε τη θέση μου" aria-label="Ακολούθησε τη θέση μου" disabled>
      <span class="map-tool-icon icon-follow"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="5" fill="#b9e52b" stroke="#0b2633" stroke-width="1.8"/><circle cx="12" cy="12" r="1.8" fill="#ff3c98"/><path d="M12 2v4M12 18v4M2 12h4M18 12h4" stroke="#0b2633" stroke-width="2" stroke-linecap="round"/></svg></span>
      <span class="tool-label">Ακολούθησε τη θέση μου</span>
    </button>
    <button class="shelter-btn" id="shelterBtn" type="button" title="Βρες το κοντινότερο καταφύγιο" aria-label="Βρες το κοντινότερο καταφύγιο"><span class="map-tool-icon icon-shelter"><Fragment set:html={trailIcon('shelter')} /></span><span class="tool-label">Καταφύγιο</span></button>
    <SosPanel />
  </div>
</header>

<style>
  :global(.topbar .brand){display:flex;align-items:center;gap:14px}
  :global(.topbar){z-index:4200!important}
  :global(body:has(#view3dOverlay.open) .topbar-actions > :not(#sosButton):not(#sosDialog)){display:none!important}
  :global(body.navigation-active .topbar-actions),:global(body:has(#view3dOverlay.open) .topbar-actions){opacity:1!important;pointer-events:none!important;background:transparent!important;border:0!important;box-shadow:none!important;display:flex!important;justify-content:flex-end}
  :global(#sosButton){pointer-events:auto!important}
  @media(max-width:760px){:global(.map-home-theme .topbar-actions){grid-template-columns:repeat(8,minmax(0,1fr))!important}:global(.map-home-theme .topbar-actions.has-submit-cta){grid-template-columns:repeat(9,minmax(0,1fr))!important}}
  @media(max-width:760px){:global(.topbar .brand){gap:10px}}
  :global(.topbar .brand-home){color:inherit;text-decoration:none;cursor:pointer;min-width:0;pointer-events:auto}
  :global(.topbar .brand-home .map-brand-heading){margin:0!important;line-height:1!important}
  :global(.topbar .map-brand-logo){display:block;width:clamp(190px,20vw,300px);height:58px;object-fit:contain;object-position:left center}
  :global(.topbar .brand-home:hover .map-brand-logo){opacity:.8}
  @media(max-width:760px){:global(.topbar .map-brand-logo){width:210px;height:48px}}
  :global(.topbar .brand-home:focus-visible){outline:2px solid currentColor;outline-offset:4px;border-radius:3px}
  :global(.map-home-theme .topbar .brand-home .brand-text){display:block!important}
  :global(.map-home-theme .topbar-actions :is(.trail-menu-toggle,.locate-btn,.shelter-btn,.basemap-toggle,.submit-trail-cta,#sosButton)){height:56px!important;min-height:56px!important}
  :global(.map-home-theme .topbar-actions .map-tool-icon){width:30px!important;height:30px!important;flex-basis:30px!important}
  :global(.map-home-theme .topbar-actions .map-tool-icon svg){width:28px!important;height:28px!important}
  @media(min-width:1101px){
    :global(.map-home-theme .topbar-actions :is(.btn-label,.tool-label,.basemap-toggle>span:last-child)){font-size:13px!important}
    :global(.map-home-theme .topbar-actions :is(.trail-menu-toggle,.locate-btn,.shelter-btn,.basemap-toggle,.submit-trail-cta)){padding-inline:9px!important;gap:5px!important}
  }
  @media(min-width:761px) and (max-width:1100px){
    :global(.map-home-theme .topbar-actions :is(.trail-menu-toggle,.locate-btn,.shelter-btn,.basemap-toggle)){width:52px!important;min-width:52px!important}
    :global(.map-home-theme .topbar .map-brand-logo){width:190px;height:52px}
  }
  @media(max-width:760px){
    :global(.map-home-theme .topbar-actions :is(.trail-menu-toggle,.locate-btn,.shelter-btn,.basemap-toggle,.submit-trail-cta,#sosButton)){height:62px!important;min-height:62px!important}
    :global(.map-home-theme .topbar-actions .map-tool-icon){width:25px!important;height:25px!important;flex-basis:25px!important}
    :global(.map-home-theme .topbar-actions .map-tool-icon svg){width:24px!important;height:24px!important}
    :global(.map-home-theme .topbar-actions :is(.btn-label,.tool-label,.basemap-toggle>span:last-child)){font-size:9px!important;line-height:1.15!important}
  }
</style>
