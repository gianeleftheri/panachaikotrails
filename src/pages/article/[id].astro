---
import { getPanachaikoSiteStatus } from '../../lib/site-status';
import { PRIVATE_PREVIEW_COOKIE, isPrivatePreviewCookieValid, privatePreviewSecret } from '../../lib/private-preview';
export const prerender = false;
Astro.response.headers.set('Cache-Control','private, no-store');
const status = await getPanachaikoSiteStatus();
const hasAccess = await isPrivatePreviewCookieValid(Astro.cookies.get(PRIVATE_PREVIEW_COOKIE)?.value, privatePreviewSecret());
if(status.under_construction && !hasAccess)return Astro.redirect('/',302);
const id = Astro.params.id ?? '';
const groups = [{id:1,name:'Νέα',color:'#fcfbf9'},{id:3,name:'Διαδρομές',color:'#ced8b9'},{id:4,name:'Σημεία ενδιαφέροντος',color:'#b8d9d8'},{id:5,name:'Συμβουλές',color:'#dbbea8'},{id:6,name:'Εξοπλισμός',color:'#bacbdc'}];
const plain=(v:unknown)=>String(v??'').replace(/<[^>]*>/g,' ').replace(/&nbsp;|&#160;/gi,' ').replace(/&amp;/gi,'&').replace(/&quot;/gi,'"').replace(/&#0?39;/gi,"'").replace(/&#8217;/g,'’').replace(/&#8211;/g,'–').replace(/\s+/g,' ').trim();
const imageUrl=(v:unknown)=>{try{const u=new URL(String(v));return u.protocol==='https:'?u.href:null}catch{return null}};
async function wp(route:string,params:Record<string,string>={}){
 const u=new URL('https://cms.panachaikotrails.gr/');u.searchParams.set('rest_route',route);
 for(const [k,v] of Object.entries(params))u.searchParams.set(k,v);
 const r=await fetch(u,{signal:AbortSignal.timeout(8000),headers:{Accept:'application/json'}});
 if(!r.ok)throw Error(String(r.status));return r.json();
}
let post:any=null;let unavailable=false;
if(/^\d{1,12}$/.test(id)){try{const p=await wp('/wp/v2/posts/'+id,{_embed:'wp:featuredmedia'});if(p?.status==='publish'&&!p?.content?.protected)post=p}catch(e){unavailable=String(e)!=='Error: 404'}}
if(!post)Astro.response.status=unavailable?503:404;
const title=plain(post?.title?.rendered)|| (unavailable?'Το άρθρο δεν είναι προσωρινά διαθέσιμο':'Το άρθρο δεν βρέθηκε');
const media=post?._embedded?.['wp:featuredmedia']?.[0];
const cover=imageUrl(media?.media_details?.sizes?.large?.source_url||media?.source_url);
const primary=groups.find(g=>g.id!==1&&post?.categories?.includes(g.id))||groups[0];
const sections=post?await Promise.all(groups.map(async g=>{try{const rows=await wp('/wp/v2/posts',{categories:String(g.id),status:'publish',per_page:'4',exclude:id,_embed:'wp:featuredmedia',orderby:'date',order:'desc'});return {...g,items:Array.isArray(rows)?rows.filter(p=>Number.isSafeInteger(p?.id)).slice(0,4):[]}}catch{return {...g,items:[]}}})): [];
sections.sort((a,b)=>Number(b.id===primary.id)-Number(a.id===primary.id));
const date=post?.date?new Date(post.date+'+02:00'):null;
const formattedDate=date&&Number.isFinite(date.getTime())?new Intl.DateTimeFormat('el-GR',{dateStyle:'long',timeZone:'Europe/Athens'}).format(date):'';
// Render WordPress content in a sandboxed, script-free iframe; do not inject CMS HTML into the parent document.
const documentBody='<!doctype html><html lang="el"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta http-equiv="Content-Security-Policy" content="default-src \'none\'; img-src https:; style-src \'unsafe-inline\'; base-uri \'none\'; form-action \'none\'"><style>html,body{margin:0;padding:0;min-height:0;height:auto;overflow:hidden}body{display:flow-root;color:#20221d;font:17px/1.8 system-ui,sans-serif;overflow-wrap:anywhere}img{max-width:100%;height:auto}figure{margin:20px 0}a{color:#145d62}iframe,object,embed,form{display:none}table{max-width:100%;display:block;overflow:auto}pre{white-space:pre-wrap}</style></head><body>'+String(post?.content?.rendered||'')+'</body></html>';
---
<!doctype html>
<html lang="el"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content={status.under_construction||!post?'noindex,nofollow':'index,follow'}/><meta name="description" content={plain(post?.excerpt?.rendered).slice(0,160)}/><link rel="canonical" href={new URL('/article/'+id,'https://panachaikotrails.gr')}/><link rel="icon" href="/favicon.svg"/><title>{title} | Panachaiko Trails</title><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/><link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet"/></head>
<body><a class="skip" href="#article">Μετάβαση στο άρθρο</a><div class="shell"><header class="mast" aria-label="Panachaiko Trails"><nav aria-label="Πλοήγηση"><a href="/">ΑΡΧΙΚΗ</a><a href="/map">ΧΑΡΤΗΣ ↗</a></nav><a class="mast-brand" href="/" aria-label="Panachaiko Trails – Αρχική"><img src="/panachaiko-trails-logo.svg" alt="Panachaiko Trails"/></a></header>
<main class="layout"><article id="article" class="article"><a class="back" href="/">← Επιστροφή στην αρχική</a><p class="category" style={`--category:${primary.color}`}>{primary.name}</p><h1>{title}</h1>{formattedDate&&<p class="date">{formattedDate}</p>}{cover&&<img class="cover" src={cover} alt={plain(media?.alt_text)}/>}
{post?<iframe id="article-body" title="Περιεχόμενο άρθρου" sandbox="allow-same-origin" scrolling="no" srcdoc={documentBody}></iframe>:<p>Δοκιμάστε ξανά ή επιστρέψτε στην αρχική σελίδα.</p>}</article>
<aside class="sidebar" aria-label="Καιρός και περισσότερα άρθρα">
<div class="weather-cards" aria-label="Αναλυτικές μετρήσεις καιρού">
{[{key:'patra',name:'ΠΑΤΡΑ',color:'#b8d9d8'},{key:'panachaiko',name:'ΠΑΝΑΧΑΪΚΟ',color:'#ead694'}].map(station => <section class="weather-card" style={`--weather-color:${station.color}`} aria-labelledby={`weather-title-${station.key}`}>
<div class="weather-card-head"><h2 id={`weather-title-${station.key}`}>ΚΑΙΡΟΣ<br/>{station.name}</h2><svg id={`weather-icon-${station.key}`} viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" role="img" aria-label="Άγνωστες καιρικές συνθήκες"><path d="M18 18a6 6 0 1 1 9 5c-3 2-3 4-3 6M24 35h.01"/></svg></div>
<div class="weather-card-body" id={`weather-detail-${station.key}`} aria-live="polite"><p class="weather-state">Φόρτωση μετρήσεων…</p></div>
</section>)}
</div>
{sections.map(group=>group.items.length>0&&<section class="related" style={`--category:${group.color}`}><h2>{group.name}</h2>{group.items.map(p=>{const m=p?._embedded?.['wp:featuredmedia']?.[0];const src=imageUrl(m?.media_details?.sizes?.thumbnail?.source_url||m?.source_url);return <a class="related-row" href={`/article/${p.id}`}>{src&&<img src={src} alt="" loading="lazy"/>}<span>{plain(p.title?.rendered)}</span></a>})}</section>)}
</aside></main><footer><a href="/">PANACHAIKO TRAILS</a><a href="/map">ΑΝΟΙΓΜΑ ΧΑΡΤΗ ↗</a></footer></div>
<script is:inline>
const frame=document.getElementById('article-body');
if(frame){
 let observer;
 let scheduled=false;
 const resize=()=>{if(scheduled)return;scheduled=true;requestAnimationFrame(()=>{scheduled=false;try{const body=frame.contentDocument?.body;if(!body)return;const height=Math.ceil(Math.max(body.getBoundingClientRect().height,body.scrollHeight))+2;if(height>0&&Math.abs(frame.getBoundingClientRect().height-height)>1)frame.style.height=height+'px'}catch{}})};
 const watch=()=>{try{const doc=frame.contentDocument;if(!doc?.body)return;observer?.disconnect();observer=new ResizeObserver(resize);observer.observe(doc.body);doc.addEventListener('load',resize,true);doc.fonts?.ready.then(resize).catch(()=>{});resize()}catch{}};
 frame.addEventListener('load',watch);window.addEventListener('resize',resize);watch();
}
const format=v=>typeof v==='number'&&Number.isFinite(v)?v.toLocaleString('el-GR',{maximumFractionDigits:1}):'—';
function renderStationDetails(key,station){
 const root=document.getElementById('weather-detail-'+key);if(!root)return;root.replaceChildren();
 const available=station&&station.status!=='unavailable';
 const measurement=(value,unit)=>available&&typeof value==='number'&&Number.isFinite(value)?format(value)+' '+unit:'—';
 const temp=document.createElement('p');temp.className='weather-temperature';temp.textContent=measurement(station?.temp,'°C');root.append(temp);
 const state=document.createElement('p');state.className='weather-state';
 state.dataset.stale=String(station?.status==='stale');
 state.textContent=!available?'Οι μετρήσεις δεν είναι διαθέσιμες αυτή τη στιγμή.':station.status==='stale'?'Παλαιότερη μέτρηση':'Τελευταία διαθέσιμη μέτρηση';
 if(available&&station.observed)state.textContent+=' · '+station.observed;root.append(state);
 const metrics=document.createElement('dl');metrics.className='weather-metrics';
 const rows=[
 ['Αίσθηση',measurement(station?.feels,'°C')],
 ['Υγρασία',measurement(station?.humidity,'%')],
 ['Άνεμος',measurement(station?.wind,'km/h')+(available&&station.windDir?' · '+station.windDir:'')],
 ['Πίεση',measurement(station?.pressure,'hPa')],
 ['Βροχή σήμερα',measurement(station?.rainToday,'mm')],
 ['Ένταση βροχής',measurement(station?.rainRate,'mm/h')],
 ['Σημείο δρόσου',measurement(station?.dewPoint,'°C')]
 ];
 for(const [label,value] of rows){const row=document.createElement('div'),dt=document.createElement('dt'),dd=document.createElement('dd');dt.textContent=label;dd.textContent=value;row.append(dt,dd);metrics.append(row)}root.append(metrics);

}
const cloud='M12 31h24a8 8 0 0 0 0-16 12 12 0 0 0-23-2 9 9 0 0 0-1 18Z';
const sun='<circle cx="24" cy="24" r="9"/><path d="M24 3v6M24 39v6M3 24h6M39 24h6M9 9l4 4M35 35l4 4M9 39l4-4M35 13l4-4"/>';
const moon='<path d="M29 5a19 19 0 1 0 14 27A17 17 0 0 1 29 5Z"/>';
function renderCondition(key, current){
 const svg=document.getElementById('weather-icon-'+key);if(!svg)return;
 const code=current?.weather_code, day=current?.is_day===1;
 let label='Άγνωστες καιρικές συνθήκες', graphic='<path d="M18 18a6 6 0 1 1 9 5c-3 2-3 4-3 6M24 35h.01"/>';
 const cloudSvg='<path d="'+cloud+'"/>';
 if(code===0){label=day?'Ηλιοφάνεια':'Αίθρια νύχτα';graphic=day?sun:moon}
 else if(code===1||code===2){label=day?'Ήλιος με σύννεφα':'Νύχτα με λίγα σύννεφα';graphic='<g transform="translate(15 0) scale(.62)">'+(day?sun:moon)+'</g><g transform="translate(0 10)">'+cloudSvg+'</g>'}
 else if(code===3){label='Συννεφιά';graphic=cloudSvg}
 else if([45,48].includes(code)){label='Ομίχλη';graphic='<g transform="translate(0 -5)">'+cloudSvg+'</g><path d="M9 34h30M13 40h22"/>'}
 else if([51,53,55,61,63,65,80,81,82].includes(code)){label=code>=80?'Μπόρες':code<=55?'Ψιχάλα':'Βροχή';graphic=cloudSvg+'<path stroke="#246b9b" d="M15 35l-3 8M25 35l-3 8M35 35l-3 8"/>'}
 else if([56,57,66,67].includes(code)){label='Παγωμένη βροχή';graphic=cloudSvg+'<path stroke="#246b9b" d="M15 35l-3 8M35 35l-3 8"/><circle cx="24" cy="40" r="2"/>'}
 else if([71,73,75,77,85,86].includes(code)){label='Χιονόπτωση';graphic=cloudSvg+'<path stroke="#246b9b" d="M13 39h6M16 36v6M23 43h6M26 40v6M33 39h6M36 36v6"/>'}
 else if([95,96,99].includes(code)){label=code===95?'Καταιγίδα':'Καταιγίδα με χαλάζι';graphic=cloudSvg+'<path fill="#f2b629" d="M25 30l-8 9h7l-3 7 13-12h-8l3-4Z"/>'}
 svg.innerHTML=graphic;svg.setAttribute('aria-label',label+' · Εκτίμηση Open-Meteo');svg.setAttribute('title',label+' · Εκτίμηση Open-Meteo');

}
async function loadConditions(){
 const locations=[['patra',38.2466,21.7346,60],['panachaiko',38.228,21.788,1588]];
 await Promise.all(locations.map(async ([key,lat,lon,elevation])=>{
  try{const params=new URLSearchParams({latitude:String(lat),longitude:String(lon),elevation:String(elevation),current:'weather_code,is_day',timezone:'Europe/Athens'});
   const r=await fetch('https://api.open-meteo.com/v1/forecast?'+params,{signal:AbortSignal.timeout(8000)});if(!r.ok)throw Error();const data=await r.json();renderCondition(key,data.current);
  }catch{renderCondition(key,null)}
 }));
}
let weatherBusy=false;
async function weather(){
 if(weatherBusy)return;weatherBusy=true;
 try{
  try{const r=await fetch('/api/weather-live',{signal:AbortSignal.timeout(25000)});if(!r.ok)throw Error();const data=await r.json();if(!data.stations)throw Error();for(const key of ['patra','panachaiko'])renderStationDetails(key,data.stations[key]);}
  catch{for(const key of ['patra','panachaiko'])renderStationDetails(key,null)}
  await loadConditions();
 }finally{weatherBusy=false}
}
weather();
setInterval(()=>{if(document.visibilityState==='visible')weather()},180000);
document.addEventListener('visibilitychange',()=>{if(document.visibilityState==='visible')weather()});

</script>
<style is:global>
*{box-sizing:border-box}body{margin:0;background:#f3eedf;color:#20221d;font-family:Inter,Arial,sans-serif}a{color:inherit;text-decoration:none}a:focus-visible{outline:3px solid #20221d;outline-offset:4px}.skip{position:absolute;left:-10000px}.skip:focus{left:12px;top:12px;background:white;padding:12px;z-index:10}.shell{max-width:1600px;margin:auto;padding:28px 4vw}.mast{background:#ef641b;border:3px solid #20221d;box-shadow:5px 5px 0 #20221d;display:flex;align-items:center;justify-content:space-between;gap:20px;padding:18px 26px;margin-bottom:32px}.mast img{display:block;width:min(320px,42vw);height:auto}.mast nav{display:flex;gap:20px;font-weight:800;font-size:13px}.layout{display:grid;grid-template-columns:minmax(0,2fr) minmax(280px,1fr);gap:28px;align-items:start}.article,.related,.weather-card{background:#fcfbf9;border:3px solid #20221d;box-shadow:5px 5px 0 #20221d;min-width:0}.article{padding:clamp(20px,4vw,48px)}.back{display:inline-block;font-weight:700;font-size:13px;margin-bottom:20px}.category{display:table;background:var(--category);padding:7px 12px;font-weight:800;font-size:13px}.article h1{font-size:clamp(28px,3.5vw,52px);line-height:1.1;letter-spacing:-.045em;margin:16px 0}.date{font-size:13px;color:#615649}.cover{width:100%;height:auto;display:block;margin:24px 0}.article iframe{width:100%;border:0;display:block;min-height:0;height:160px;overflow:hidden}.sidebar{display:grid;gap:24px;min-width:0}.weather-cards{display:grid;gap:20px}.weather-card-head,.related h2{background:var(--weather-color,var(--category));border-bottom:2px solid #20221d;padding:16px;margin:0}.weather-card-head{display:flex;justify-content:space-between;align-items:center}.weather-card-head h2,.related h2{font-size:21px;line-height:1.2;font-weight:850;margin:0}.weather-card-head svg{width:32px;height:32px}.weather-card-body{padding:16px}.weather-temperature{font-size:40px;font-weight:850;letter-spacing:-.05em;margin:0}.weather-state{font-size:12px;color:#615649;overflow-wrap:anywhere}.weather-metrics{margin:12px 0 0}.weather-metrics>div{display:flex;justify-content:space-between;gap:12px;padding:9px 0;border-top:1px solid #20221d30;font-size:13px}.weather-metrics dd{margin:0;font-weight:800;text-align:right}.related-row{display:flex;align-items:center;gap:12px;padding:14px;border-bottom:1px solid #20221d25;font-size:14px;font-weight:650;line-height:1.45}.related-row:last-child{border-bottom:0}.related-row img{width:76px;height:58px;object-fit:cover;flex-shrink:0}.related-row:hover,.back:hover{text-decoration:underline}footer{display:flex;justify-content:space-between;gap:12px;border-top:1px solid #20221d;margin-top:35px;padding:20px 0;font-size:12px;font-weight:750}@media(max-width:820px){.layout{grid-template-columns:1fr}.shell{padding:16px}.mast{padding:12px;gap:10px}.mast nav{gap:10px;font-size:11px}.article{padding:20px}.sidebar{margin-top:6px}}
</style></body></html>
