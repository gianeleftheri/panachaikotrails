---
import MaintenancePage from '../components/MaintenancePage.astro';
import HomepageBento from '../components/HomepageBento.astro';
import { getPanachaikoSiteStatus } from '../lib/site-status';

export const prerender = false;

const siteStatus = await getPanachaikoSiteStatus();
Astro.response.headers.set('Cache-Control', 'no-store, max-age=0');
const underConstruction = siteStatus.under_construction;

let panels = {};
if (!underConstruction) {
  try {
    const ctrl = new AbortController();
    const timer = setTimeout(() => ctrl.abort(), 1800);
    const response = await fetch('https://cms.panachaikotrails.gr/?rest_route=/panachaiko/v1/homepage', {
      signal: ctrl.signal,
      headers: { Accept:'application/json', 'User-Agent':'PanachaikoTrails-Bento/1.0' }
    });
    clearTimeout(timer);
    if (response.ok) panels = (await response.json())?.panels || {};
  } catch {}
}

const hero = {
  webp:'https://cms.panachaikotrails.gr/wp-content/uploads/2026/09/Panachaiko-Trails-Home-Hero-Optimized-1024x683.webp',
  avif480:'https://cms.panachaikotrails.gr/wp-content/uploads/2026/09/Panachaiko-Trails-Hero-AVIF-480-Low.avif',
  avif768:'https://cms.panachaikotrails.gr/wp-content/uploads/2026/09/Panachaiko-Trails-Hero-AVIF-768-Low.avif',
  avif1024:'https://cms.panachaikotrails.gr/wp-content/uploads/2026/09/Panachaiko-Trails-Hero-AVIF-1024-Low.avif',
};
---
<!doctype html>
<html lang="el">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="robots" content="noindex,nofollow" />
  <meta name="theme-color" content="#073b43" />
  <meta name="description" content="Εναλλακτική Bento αρχική σελίδα Panachaiko Trails." />
  {!underConstruction && <link rel="preconnect" href="https://cms.panachaikotrails.gr" crossorigin />}
  {!underConstruction && <link rel="preload" as="image" href={hero.avif768} imagesrcset={hero.avif480+' 480w, '+hero.avif768+' 768w, '+hero.avif1024+' 1024w'} imagesizes="(max-width:760px) 100vw, 64vw" type="image/avif" fetchpriority="high" />}
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>Bento Preview | Panachaiko Trails</title>
</head>
<body>
  {underConstruction ? <MaintenancePage /> : <HomepageBento panels={panels} heroWebp={hero.webp} heroAvif480={hero.avif480} heroAvif768={hero.avif768} heroAvif1024={hero.avif1024} />}
</body>
</html>
