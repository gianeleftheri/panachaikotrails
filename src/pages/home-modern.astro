---
import MaintenancePage from '../components/MaintenancePage.astro';
import HomepageModern from '../components/HomepageModern.astro';
import { getPanachaikoSiteStatus } from '../lib/site-status';

export const prerender = false;

const siteStatus = await getPanachaikoSiteStatus();
Astro.response.headers.set('Cache-Control','no-store, max-age=0');
const underConstruction = siteStatus.under_construction;

let panels:any = {};
let featuredTrails:any[] = [];
let trailCount = 0;
let recreationCount = 0;
let shelterCount = 0;

if (!underConstruction) {
  const timeoutFetch = async (url:string, ms=2400) => {
    const controller = new AbortController();
    const timer = setTimeout(() => controller.abort(), ms);
    try {
      return await fetch(url,{signal:controller.signal,headers:{Accept:'application/json','User-Agent':'PanachaikoTrails-Modern/1.0'}});
    } finally { clearTimeout(timer); }
  };

  const [homepageResult,trailsResult,recreationResult] = await Promise.allSettled([
    timeoutFetch('https://cms.panachaikotrails.gr/?rest_route=/panachaiko/v1/homepage'),
    timeoutFetch('https://cms.panachaikotrails.gr/?rest_route=/panachaiko/v1/trails',3200),
    timeoutFetch('https://cms.panachaikotrails.gr/wp-json/wp/v2/recreation_spot?per_page=1&_fields=id')
  ]);

  if (homepageResult.status === 'fulfilled' && homepageResult.value.ok) {
    panels = (await homepageResult.value.json())?.panels || {};
  }

  if (trailsResult.status === 'fulfilled' && trailsResult.value.ok) {
    const entries = await trailsResult.value.json();
    if (Array.isArray(entries)) {
      trailCount = entries.length;
      const published = entries.filter((entry:any)=>entry?.trail?.existing === true && entry?.trail?.status !== 'investigation');
      const scored = published.map((entry:any,index:number)=>({
        entry,index,
        score:(Number(entry?.trail?.elev_max)||0)*2+(Number(entry?.trail?.length_km)||0)*120+(Number(entry?.trail?.gain_m)||0)
      })).sort((a:any,b:any)=>b.score-a.score);
      featuredTrails = scored.slice(0,3).map((x:any)=>x.entry);
      const shelterIds = new Set<number>();
      entries.forEach((entry:any)=>(entry?.trail?.notes||[]).forEach((poi:any)=>{
        if (poi?.category === 'shelter' && Number.isFinite(Number(poi?.id))) shelterIds.add(Number(poi.id));
      }));
      shelterCount = shelterIds.size;
    }
  }

  if (recreationResult.status === 'fulfilled' && recreationResult.value.ok) {
    recreationCount = Number(recreationResult.value.headers.get('x-wp-total') || 0);
  }

  if (!trailCount) trailCount = 13;
  if (!recreationCount) recreationCount = 6;
  if (!shelterCount) shelterCount = 2;
}
---
<!doctype html>
<html lang="el">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="robots" content="noindex,nofollow" />
  <meta name="theme-color" content="#eaf2f7" />
  <meta name="description" content="Νέα εναλλακτική αρχική Panachaiko Trails με πραγματικά δεδομένα από το CMS." />
  {!underConstruction && <link rel="preload" as="image" href="/dashboard-hero.webp" fetchpriority="high" />}
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>Modern Preview | Panachaiko Trails</title>
</head>
<body>
  {underConstruction ? <MaintenancePage /> : <HomepageModern panels={panels} featuredTrails={featuredTrails} trailCount={trailCount} recreationCount={recreationCount} shelterCount={shelterCount} />}
</body>
</html>
