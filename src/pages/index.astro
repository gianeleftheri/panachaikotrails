<div class="section-label"><span>01 — ΕΞΕΡΕΥΝΗΣΗ</span><span>ΔΙΑΛΕΞΕ ΚΑΤΕΥΘΥΝΣΗ ↙</span></div>
<nav class="hub" aria-label="Κεντρική πλοήγηση">
{menu.map((item,i) => <a href={item.id === 'map' ? '/map' : `#${item.id}`} data-dialog={item.id === 'map' ? undefined : item.id} class="tile" style={`--tile:${item.color}`} aria-label={item.label}><div class="tile-top"><span>0{i+1} / {item.label}</span><svg class="pixel-icon" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={item.icon}/></svg></div><h2>{item.title}</h2><div class="tile-bottom"><span>{item.detail}</span><span class="arrow" aria-hidden="true">↗</span></div></a>)}
</nav></main>
<footer class="footer"><strong>ΛΙΓΟΤΕΡΗ ΟΘΟΝΗ. ΠΕΡΙΣΣΟΤΕΡΟ ΒΟΥΝΟ.</strong><span>PANACHAIKO TRAILS © {new Date().getFullYear()}</span></footer>
</div>
<dialog id="trails" class="dialog" aria-labelledby="trails-title"><div class="dialog-head"><h2 id="trails-title">DIADROMES</h2><button class="close" aria-label="Κλείσιμο">×</button></div><div class="content"><p class="source">{source} · {trails.length} διαδρομές</p>{trails.map(({key,trail})=><a class="route" href={`/map?trail=${encodeURIComponent(key)}`}><span class="route-code">{key}</span><span>{trail.name}<small>{Number.isFinite(trail.length_km) ? `${trail.length_km.toLocaleString('el-GR')} km · ` : ''}{trail.existing ? 'Υφιστάμενη διαδρομή' : 'Σχεδιαζόμενη / υπό διερεύνηση'}</small></span><span aria-hidden="true">↗</span></a>)}</div></dialog>
<dialog id="refuges" class="dialog" aria-labelledby="refuges-title"><div class="dialog-head"><h2 id="refuges-title">KATAFIGIA</h2><button class="close" aria-label="Κλείσιμο">×</button></div><div class="content"><p>Καταφύγια στο Παναχαϊκό όρος.</p><p>Βρες τα καταφύγια και τις διαδρομές πρόσβασης στον υπάρχοντα διαδραστικό χάρτη.</p><a class="text-link" href="/map">Άνοιξε τον χάρτη ↗</a></div></dialog>
<dialog id="weather" class="dialog" aria-labelledby="weather-title"><div class="dialog-head"><h2 id="weather-title">KAIROS</h2><button class="close" aria-label="Κλείσιμο">×</button></div><div class="content" id="weather-content" aria-live="polite"><p>Φόρτωση μετρήσεων…</p></div></dialog>
<script is:inline>
(()=>{
let weatherLoaded=false;
const format=v=>typeof v==='number'&&Number.isFinite(v)?v.toLocaleString('el-GR',{maximumFractionDigits:1}):'—';
async function weather(){
 const root=document.getElementById('weather-content');
 try{
  const r=await fetch('/api/weather-live',{signal:AbortSignal.timeout(25000)});if(!r.ok)throw Error();const data=await r.json();
  if(!data.stations)throw Error();root.replaceChildren();
  for(const key of ['patra','panachaiko']){
   const s=data.stations[key];if(!s)continue;
   const box=document.createElement('section');box.className='station';
   const title=document.createElement('h3');title.textContent=s.name;
   const temp=document.createElement('strong');temp.textContent=s.status==='unavailable'?'—':format(s.temp)+' °C';
   const details=document.createElement('p');details.textContent=s.status==='unavailable'?'Οι μετρήσεις δεν είναι διαθέσιμες.':`Άνεμος ${format(s.wind)} km/h · Υγρασία ${format(s.humidity)}%`;
   const status=document.createElement('p');status.className='source';status.textContent=(s.status==='live'?'Τελευταία διαθέσιμη μέτρηση':s.status==='stale'?'Παλαιότερη μέτρηση':'Μη διαθέσιμο')+(s.observed?' · '+s.observed:'');
   const source=document.createElement('p');source.className='source';source.textContent='Πηγή: '+s.source;
   box.append(title,temp,details,status,source);root.append(box);
  }
  if(!root.children.length)throw Error();weatherLoaded=true;
 }catch{root.textContent='Οι μετρήσεις δεν είναι διαθέσιμες αυτή τη στιγμή. Κλείσε και άνοιξε ξανά για νέα προσπάθεια.'}
}
function open(id){const d=document.getElementById(id);if(!(d instanceof HTMLDialogElement))return;if(!d.open)d.showModal();if(id==='weather'&&!weatherLoaded)weather()}
document.querySelectorAll('[data-dialog]').forEach(a=>a.addEventListener('click',e=>{e.preventDefault();open(a.dataset.dialog)}));
document.querySelectorAll('dialog').forEach(d=>{d.querySelector('.close').addEventListener('click',()=>d.close());d.addEventListener('click',e=>{if(e.target===d){const r=d.getBoundingClientRect();if(e.clientX<r.left||e.clientX>r.right||e.clientY<r.top||e.clientY>r.bottom)d.close()}})});
if(location.hash)open(location.hash.slice(1));
})();
</script>
</body></html>
