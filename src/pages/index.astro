---
import TrailExplorer from '../components/TrailExplorer.astro';
import '../styles/global.css';

const title = 'Panachaiko Trails | Δίκτυο μονοπατιών Παναχαϊκού';
const description = 'Διαδραστικός χάρτης του δικτύου μονοπατιών στο Παναχαϊκό όρος.';
---

<!doctype html>
<html lang="el">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#12201a" />
    <link rel="preconnect" href="https://server.arcgisonline.com" crossorigin />
    <link rel="preconnect" href="https://cms.panachaikotrails.gr" crossorigin />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body><TrailExplorer /></body>
</html>
