---
import HomepagePoster from '../components/HomepagePoster.astro';
import MaintenancePage from '../components/MaintenancePage.astro';
import { getPanachaikoSiteStatus } from '../lib/site-status';
import { PRIVATE_PREVIEW_COOKIE, isPrivatePreviewCookieValid, privatePreviewSecret } from '../lib/private-preview';
export const prerender = false;
Astro.response.headers.set('Cache-Control', 'private, no-store, max-age=0');
const status = await getPanachaikoSiteStatus();
const hasAccess = await isPrivatePreviewCookieValid(Astro.cookies.get(PRIVATE_PREVIEW_COOKIE)?.value, privatePreviewSecret());
const showMaintenance = status.under_construction && !hasAccess;
---
{showMaintenance ? (
  <html lang="el"><head><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/><link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet"/><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><meta name="theme-color" content="#ef641b"/><link rel="icon" href="/favicon.svg"/><title>Υπό κατασκευή | Panachaiko Trails</title></head><body><MaintenancePage /></body></html>
) : <HomepagePoster />}
