---
import MaintenancePage from '../components/MaintenancePage.astro';
import HomepageAccordion from '../components/HomepageAccordion.astro';
import { getPanachaikoSiteStatus } from '../lib/site-status';

export const prerender = false;

const siteStatus = await getPanachaikoSiteStatus();
Astro.response.headers.set('Cache-Control', 'no-store, max-age=0');

const underConstruction = siteStatus.under_construction;
const title = underConstruction ? 'Υπό κατασκευή | Panachaiko Trails' : 'Panachaiko Trails';
const description = underConstruction
  ? 'Το νέο Panachaiko Trails ετοιμάζεται. Σύντομα θα ανακαλύψετε τα μονοπάτια και τις διαδρομές του Παναχαϊκού όρους.'
  : 'Panachaiko Trails — μονοπάτια, σημεία ενδιαφέροντος, καταφύγια, φωτογραφίες και βίντεο από το Παναχαϊκό όρος.';
---

<!doctype html>
<html lang="el">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content={underConstruction ? 'noindex,nofollow' : 'index,follow'} />
    <meta name="theme-color" content={underConstruction ? '#081711' : '#063a43'} />
    {!underConstruction && <link rel="preconnect" href="https://images.unsplash.com" crossorigin />}
    {!underConstruction && <link rel="preload" as="image" href="https://images.unsplash.com/photo-1551632811-561732d1e306?auto=format&fit=crop&w=1440&q=78" fetchpriority="high" />}
    <link rel="preconnect" href="https://cms.panachaikotrails.gr" crossorigin />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    {underConstruction ? <MaintenancePage /> : <HomepageAccordion />}
  </body>
</html>
