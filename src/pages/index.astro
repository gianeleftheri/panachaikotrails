---
import MaintenancePage from '../components/MaintenancePage.astro';
import HomepageAccordion from '../components/HomepageAccordion.astro';
import { getPanachaikoSiteStatus } from '../lib/site-status';
import { getImage } from 'astro:assets';

export const prerender = false;

const siteStatus = await getPanachaikoSiteStatus();
Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=5, stale-while-revalidate=5');

const underConstruction = siteStatus.under_construction;
const defaultHomeBackground = 'https://cms.panachaikotrails.gr/wp-content/uploads/2026/09/Panachaiko-Trails-Home-Hero.webp';
const homeHeroAvif = null;
const homeHeroWebp = !underConstruction
  ? { src: defaultHomeBackground }
  : null;
const title = underConstruction ? 'Υπό κατασκευή | Panachaiko Trails' : 'Panachaiko Trails';
const description = underConstruction
  ? 'Το νέο Panachaiko Trails ετοιμάζεται. Σύντομα θα ανακαλύψετε τα μονοπάτια και τις διαδρομές του Παναχαϊκού όρους.'
  : 'Panachaiko Trails — μονοπάτια, σημεία ενδιαφέροντος, καταφύγια, φωτογραφίες και βίντεο από το Παναχαϊκό όρος.';
---

<!doctype html>
<html lang="el">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content={underConstruction ? 'noindex,nofollow' : 'index,follow'} />
    <meta name="theme-color" content={underConstruction ? '#081711' : '#063a43'} />
    {homeHeroWebp && <link rel="preload" as="image" href={homeHeroWebp.src} type="image/webp" fetchpriority="high" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    {underConstruction ? <MaintenancePage /> : (
      <HomepageAccordion
        homeHeroAvif={homeHeroAvif?.src}
        homeHeroWebp={homeHeroWebp?.src}
        defaultHomeBackground={defaultHomeBackground}
      />
    )}
  </body>
</html>
