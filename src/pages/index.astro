---
import MaintenancePage from '../components/MaintenancePage.astro';
import HomepageFacetedExact from '../components/HomepageFacetedExact.astro';
import { getPanachaikoSiteStatus } from '../lib/site-status';

export const prerender = false;

const siteStatus = await getPanachaikoSiteStatus();
Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=10, stale-while-revalidate=20');

const underConstruction = siteStatus.under_construction;
const title = underConstruction ? 'Υπό κατασκευή | Panachaiko Trails' : 'Panachaiko Trails';
const description = underConstruction
  ? 'Το νέο Panachaiko Trails ετοιμάζεται. Σύντομα θα ανακαλύψετε τα μονοπάτια και τις διαδρομές του Παναχαϊκού όρους.'
  : 'Panachaiko Trails — μονοπάτια, σημεία ενδιαφέροντος, καταφύγια, φωτογραφίες και βίντεο από το Παναχαϊκό όρος.';
---

<!doctype html>
<html lang="el">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content={underConstruction ? 'noindex,nofollow' : 'index,follow'} />
    <meta name="theme-color" content={underConstruction ? '#081711' : '#e8e6de'} />
    {!underConstruction && <link rel="preconnect" href="https://fonts.googleapis.com" />}
    {!underConstruction && <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />}
    {!underConstruction && <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;600;700;900&display=swap" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    {underConstruction ? <MaintenancePage /> : <HomepageFacetedExact />}
  </body>
</html>
