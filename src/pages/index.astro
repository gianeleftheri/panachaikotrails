.landscape svg{width:100%;height:100%;min-height:780px;shape-rendering:geometricPrecision;image-rendering:auto}
.brand h1{font-family:VT323,monospace;font-size:clamp(72px,11.7vw,170px);line-height:.76;font-weight:400;letter-spacing:-.025em}
.brand h1 span span{color:#9cd9ee!important}
.brand-aside{display:none}
.brand{margin-bottom:38px}
.section-label{background:transparent;border-color:#a1bdd366}
