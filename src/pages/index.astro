---
import '../styles/global.css';

const pageTitle = 'Panachaiko Trails';
const description = 'Ανακάλυψε μονοπάτια και διαδρομές στο Παναχαϊκό όρος.';
---

<!doctype html>
<html lang="el">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <main>
      <p class="eyebrow">ΠΑΝΑΧΑΪΚΟ ΟΡΟΣ</p>
      <h1>Panachaiko<br /><span>Trails</span></h1>
      <p class="intro">{description}</p>
      <p class="status">Η πρώτη έκδοση του project είναι έτοιμη για ανάπτυξη.</p>
    </main>
  </body>
</html>
