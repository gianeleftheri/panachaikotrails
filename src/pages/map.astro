---
import TrailExplorer from '../components/TrailExplorer.astro';
import { PRIVATE_PREVIEW_COOKIE, isPrivatePreviewCookieValid, privatePreviewSecret } from '../lib/private-preview';
import { getPanachaikoSiteStatus } from '../lib/site-status';
import '../styles/global.css';
import '../styles/front-end-refresh.css';

export const prerender = false;

const siteStatus = await getPanachaikoSiteStatus();
const secret = privatePreviewSecret();
const hasAccess = await isPrivatePreviewCookieValid(Astro.cookies.get(PRIVATE_PREVIEW_COOKIE)?.value, secret);

if (siteStatus.under_construction && !hasAccess) {
  return Astro.redirect('/preview?redirect=/map', 302);
}

Astro.response.headers.set('Cache-Control', 'no-store, max-age=0');
const isPrivatePreview = siteStatus.under_construction && hasAccess;
const title = isPrivatePreview ? 'Ιδιωτική προεπισκόπηση | Panachaiko Trails' : 'Panachaiko Trails | Χάρτης διαδρομών';
---

<!doctype html>
<html lang="el">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content={isPrivatePreview ? 'noindex,nofollow' : 'index,follow'} />
    <meta name="theme-color" content="#12201a" />
    <link rel="preconnect" href="https://server.arcgisonline.com" crossorigin />
    <link rel="preconnect" href="https://cms.panachaikotrails.gr" crossorigin />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <TrailExplorer allowTrailSubmissions={siteStatus.public_trail_submissions} />
    {isPrivatePreview && (
      <aside class="preview-bar">
        <span><i></i> ΙΔΙΩΤΙΚΗ ΠΡΟΕΠΙΣΚΟΠΗΣΗ</span>
        <form method="post" action="/api/private-preview-exit">
          <button type="submit">ΕΞΟΔΟΣ</button>
        </form>
      </aside>
    )}
    <style>
      .preview-bar{position:fixed;right:18px;bottom:18px;z-index:99999;display:flex;align-items:center;gap:14px;padding:9px 10px 9px 14px;border:1px solid rgba(255,255,255,.18);background:rgba(8,25,19,.94);color:#fff;box-shadow:0 14px 40px rgba(0,0,0,.28);backdrop-filter:blur(12px);font:800 10px/1 Arial,sans-serif;letter-spacing:.11em}.preview-bar span{display:flex;align-items:center;gap:8px}.preview-bar i{width:7px;height:7px;border-radius:50%;background:#d4ef4c;box-shadow:0 0 0 4px rgba(212,239,76,.14)}.preview-bar form{margin:0}.preview-bar button{min-height:32px;padding:0 12px;border:1px solid #d4ef4c;background:transparent;color:#fff;font:inherit;cursor:pointer}.preview-bar button:hover{background:#d4ef4c;color:#10241c}@media(max-width:560px){.preview-bar{right:10px;bottom:10px;left:10px;justify-content:space-between}}
    </style>
  </body>
</html>
